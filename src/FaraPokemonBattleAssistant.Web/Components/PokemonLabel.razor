@* ポケモンの画像・名前・タイプアイコンを 1 行で表示する。 *@
@if (Shown is not null)
{
    <span class="poke-label">
        <PokemonIcon Pokemon="Shown" Small="@Small" />
        <strong>@Shown.Name</strong>
        @if (Build is not null)
        {
            <PokemonTypes Build="Build" Small="true" />
        }
        else
        {
            <PokemonTypes Pokemon="Shown" Small="true" />
        }
    </span>
}

@code {
    [Parameter] public Pokemon? Pokemon { get; set; }
    [Parameter] public PokemonBuild? Build { get; set; }
    [Parameter] public bool Small { get; set; }

    // 毎回 Build から求める（パラメーターに代入すると、次に Build が変わっても前のポケモンが残る）
    private Pokemon? Shown => Build?.Pokemon ?? Pokemon;
}
