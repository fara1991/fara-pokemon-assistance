@using FaraPokemonBattleAssistant.Core.Roster
@* 「登録から選ぶ」のスイッチ。オンにすると、ポケモンの入力欄の候補が登録済みのポケモンだけになる（RosterPokemonSelect）。
   登録が 1 件もなければスイッチは出さず、登録ページへの案内だけを出す。 *@
@if (Groups.Count > 0)
{
    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" role="switch" id="@id" checked="@Enabled" @onchange="Toggle" />
        <label class="form-check-label" for="@id">登録から選ぶ <Help Title="登録から選ぶ">オンにすると、ポケモンの候補が登録済みのポケモン（チームのメンバーと、チームに入っていない登録）だけになり、選ぶと登録した性格・努力値（ポイント）・特性と、チームで持たせた持ち物が入ります。入れたあとに値を変えても、登録データは変わりません。オフのときは、すべてのポケモンから選べます。</Help></label>
    </div>
}
else if (ShowEmptyHint)
{
    <Notice Empty="true" Class="mb-2">登録したポケモンの構成を呼び出せます（<a href="sync">データ連携</a>・<a href="pokemon">ポケモン登録</a>で登録）。</Notice>
}

@code {
    [Parameter] public IReadOnlyList<RosterChoiceGroup> Groups { get; set; } = Array.Empty<RosterChoiceGroup>();
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    /// <summary>登録が無いときに案内を出すか（読み込みに失敗したときは出さない）。</summary>
    [Parameter] public bool ShowEmptyHint { get; set; } = true;

    private readonly string id = "rs-" + Guid.NewGuid().ToString("N")[..8];

    private Task Toggle(ChangeEventArgs e) => EnabledChanged.InvokeAsync(e.Value is true);
}
