@* 持ち物のアイコンと名前を 1 行で表示する。
   アイコンの場所は、画像が無い持ち物でも同じ幅で空けて、名前の位置がそろうようにする。
   メガストーン（○○ナイト）は、種類ごとの画像の有無がばらばらなので、すべて共通のメガシンカ用アイコン（キーストーン）にする。 *@
@if (Item is not null)
{
    <span class="item-label">
        <span class="item-icon-slot">
            @* 持ち物が変わったら画像の要素も作り直す（前の持ち物の 404 の状態を引き継がない） *@
            @if (Item.IsMegaStone)
            {
                <img @key="MegaKey" src="@(SpriteBase)key-stone.png" alt="" loading="lazy" class="item-icon" onerror="this.style.visibility='hidden'" />
            }
            else if (!string.IsNullOrEmpty(Item.Identifier))
            {
                <img @key="Item.Identifier" src="@IconUrl" alt="" loading="lazy" class="item-icon" onerror="this.style.visibility='hidden'" />
            }
        </span>
        <span>@Item.Name</span>
    </span>
}

@code {
    private const string SpriteBase = "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/";
    private const string MegaKey = "mega-stone";

    [Parameter] public Item? Item { get; set; }

    private string IconUrl => $"{SpriteBase}{Item?.Identifier}.png";
}
