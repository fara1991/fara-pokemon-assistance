@page "/chat-commands"
@inherits AppPageBase
@using FaraPokemonBattleAssistant.Core.Roster
@inject DataCatalog Catalog
@inject PokeCommand Poke
@inject FaraPokemonBattleAssistant.Core.Roster.RosterRepository Repo
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>チャットコマンド | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>チャットコマンドを試す <Help Title="チャットコマンド">Twitch のチャットに打つのと同じ文字列を入力すると、配信用BOTが返す 1 行がそのまま表示されます。接頭辞（!@(App.CommandPrefix)）は左のメニューで選んだゲームに合わせて変わります。</Help></h3>
    <p class="mb-1">Twitch の配信チャットで配信用BOT（<a href="https://github.com/fara1991/fara-bot-moderator" target="_blank" rel="noopener noreferrer">FaraBotModerator</a>）に打つ <code>!@(App.CommandPrefix)</code> のコマンドを、ブラウザで組み立てて試せるページです。配信中に打つ前に結果を確かめたり、使えるコマンドを調べたりするときに使います。</p>
    <p class="text-muted mb-0">下の選択欄を変えるとコマンドに反映され、コマンドを書き換えると選択欄にも反映されます。</p>
    <p class="text-muted small mb-0 mt-1">H: HP / A: こうげき / B: ぼうぎょ / C: とくこう / D: とくぼう / S: すばやさ（<a href="battle-terms">用語・略語</a>）</p>
</div>

@if (App.DataSet is { CalcSupported: false } refOnly)
{
    <CalcUnsupported DataSet="refOnly" Feature="チャットコマンド（計算・登録）" />
}
else if (data is not null)
{
    <div class="card mb-3">
        <div class="card-header"><h5>コマンドを作る</h5></div>
        <div class="card-body py-2">
            <div class="cmd-build">
                <div class="cmd-f-kind">
                    <label class="form-label" for="cmd-kind">種類 <Help Title="種類">実行したいコマンドの種類です。選ぶと、そのコマンドに必要な入力欄だけが出て、下のコマンド欄に文字列を組み立てます。dmg はダメージと確定数、scan は受けたダメージから相手の振り方を推定して相手チームに登録します。</Help></label>
                    <select id="cmd-kind" class="form-select" value="@s.Kind" @onchange="@(e => { s.Kind = e.Value?.ToString() ?? "add -m"; BuildText(); })">
                        @foreach (var group in KindGroups())
                        {
                            <optgroup label="@group.Key">
                                @foreach (var k in group)
                                {
                                    <option value="@k.Key">@k.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                @if (Has(Field.Subject))
                {
                    <div class="cmd-f-poke">
                        <label class="form-label">@SubjectLabel</label>
                        <SearchableSelect TItem="Pokemon" Items="data.Pokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Subject?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Subject = data.FindPokemon(ParseId(v)); BuildText(); })" Placeholder="例: ガブリアス">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Rivals))
                {
                    @for (var i = 0; i < 6; i++)
                    {
                        var idx = i;
                        <div class="cmd-f-poke">
                            <label class="form-label">@($"{idx + 1}体目")@(idx == 0 ? "" : "（任意）")</label>
                            <SearchableSelect TItem="Pokemon" Items="data.Pokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                                SelectedValue="@(s.Rivals[idx]?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Rivals[idx] = data.FindPokemon(ParseId(v)); BuildText(); })" Placeholder="例: カイリュー">
                                <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                            </SearchableSelect>
                        </div>
                    }
                }
                @if (Has(Field.Moves))
                {
                    @for (var i = 0; i < RegisteredPokemon.MaxMoves; i++)
                    {
                        var idx = i;
                        <div class="cmd-f-ability">
                            <label class="form-label">@($"見えた技 {idx + 1}（任意）")</label>
                            <SearchableSelect TItem="Move" Items="RivalMoveChoices(idx)" DisplayText="@(m => m.Name)" ValueSelector="@(m => m.Name)"
                                SelectedValue="@s.RivalMoves[idx]" SelectedValueChanged="@(v => { s.RivalMoves[idx] = v; BuildText(); })"
                                Disabled="@(s.Subject is null)" Dropdown="true" EmptyOption="指定しない" Placeholder="技名を入力...">
                                <ItemTemplate Context="m"><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span></ItemTemplate>
                            </SearchableSelect>
                        </div>
                    }
                }
                @if (Has(Field.Evs))
                {
                    <div class="cmd-f-evs">
                        <label class="form-label">@(EvRules.Label(App.DataSet?.EvSystem ?? EvSystem.Classic))（H A B C D S）@(s.Kind == "add -m" ? "" : "（分かる能力だけ）")</label>
                        <div class="cmd-evs">
                            @for (var i = 0; i < 6; i++)
                            {
                                var idx = i;
                                var stat = (Stat)idx;
                                <input @key="@($"{idx}-{evVersion}")" type="number" class="form-control text-center px-1" min="0" max="@EvRules.MaxPerStat(App.DataSet?.EvSystem ?? EvSystem.Classic)" step="@EvRules.Step(App.DataSet?.EvSystem ?? EvSystem.Classic)"
                                       placeholder="@StatNames.Letter(stat)" aria-label="@StatNames.Japanese(stat)" title="@StatNames.Japanese(stat)"
                                       value="@s.Evs[idx]" @onchange="@(e => { s.Evs[idx] = EvText(e.Value); evVersion++; BuildText(); })" />
                            }
                        </div>
                    </div>
                }
                @if (Has(Field.Nature))
                {
                    <div class="cmd-f-nature">
                        <label class="form-label">@(s.Kind == "add -m" ? "性格" : "性格（任意）")</label>
                        <NaturePicker Natures="data.Natures" Value="@data.FindNature(s.NatureName)" ValueChanged="@(n => { s.NatureName = n?.Name ?? ""; BuildText(); })" Physical="@(CmdPhysical)" />
                        <div class="small mt-1">
                            <span class="text-muted">@(s.NatureName.Length == 0 ? (s.Kind == "add -m" ? "性格を選んでください" : "指定しない") : $"選択中: {data.FindNature(s.NatureName)?.Describe()}")</span>
                            @if (s.Kind != "add -m")
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" disabled="@(s.NatureName.Length == 0)" @onclick="() => { s.NatureName = string.Empty; BuildText(); }">指定しない</button>
                            }
                        </div>
                    </div>
                }
                @if (Has(Field.Ability))
                {
                    <div class="cmd-f-ability">
                        <label class="form-label">特性（任意）</label>
                        <SearchableSelect TItem="Ability" Items="@(s.Subject is null ? Array.Empty<Ability>() : data.AbilitiesOf(s.Subject))" DisplayText="@(a => a.Name)" ValueSelector="@(a => a.Name)"
                            SelectedValue="@s.AbilityName" SelectedValueChanged="@(v => { s.AbilityName = v; BuildText(); })"
                            Disabled="@(s.Subject is null)" Dropdown="true" EmptyOption="指定しない" Placeholder="特性名を入力..." />
                    </div>
                }
                @if (Has(Field.EntryId))
                {
                    <div class="cmd-f-num">
                        @if (s.Kind is "detail -h" or "rm -h")
                        {
                            <label class="form-label" for="cmd-entry">履歴 ID <Help Title="履歴 ID">試合の履歴の番号です。ls -h コマンドか「相手チーム」ページの履歴で分かります。</Help></label>
                        }
                        else
                        {
                            <label class="form-label" for="cmd-entry">@(s.Kind == "set -m" ? "登録 ID（任意）" : "登録 ID") <Help Title="登録 ID">登録したポケモンの番号です。「育成ポケモン」ページか ls -m コマンドで分かります。@(s.Kind == "set -m" ? "set -m は名前でも指定できます。同じポケモンを複数登録しているときだけ、登録 ID を入れてください。" : "")</Help></label>
                        }
                        <input id="cmd-entry" class="form-control" inputmode="numeric" placeholder="例: 1" value="@s.EntryId" @onchange="@(e => { s.EntryId = e.Value?.ToString()?.Trim() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.TeamNo))
                {
                    <div class="cmd-f-num">
                        <label class="form-label" for="cmd-team">チーム番号</label>
                        <input id="cmd-team" class="form-control" inputmode="numeric" placeholder="例: 1" value="@s.TeamNo" @onchange="@(e => { s.TeamNo = e.Value?.ToString()?.Trim() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.TeamItem))
                {
                    <div class="cmd-f-item">
                        <label class="form-label">持ち物（任意）</label>
                        <SearchableSelect TItem="Item" Items="data.Items" DisplayText="@(i => i.Name)" ValueSelector="@(i => i.Id.ToString())" Dropdown="true" EmptyOption="指定しない"
                            SelectedValue="@(data.Items.FirstOrDefault(i => i.Name == s.ItemName)?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.ItemName = data.FindItem(ParseId(v))?.Name ?? ""; BuildText(); })" Placeholder="例: こだわりスカーフ" />
                    </div>
                }

                @if (Has(Field.Attacker))
                {
                    <div class="cmd-f-poke">
                        <label class="form-label">@(s.Kind == "faster" ? "育成ポケモン" : "攻撃側ポケモン")（登録済みだけ）</label>
                        <SearchableSelect TItem="Pokemon" Items="registeredPokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Attacker?.Id.ToString() ?? "")" SelectedValueChanged="@OnAttackerChanged" Placeholder="@(registeredPokemon.Count == 0 ? "登録したポケモンがいません" : "登録したポケモンから選ぶ")">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Move))
                {
                    <div class="cmd-f-move">
                        <label class="form-label">技 <Help Title="技">攻撃側のポケモンが覚える技だけを使用率の高い順に表示します。「じしん+1」のように技名の後ろにランクを付けることもできます。</Help></label>
                        <SearchableSelect TItem="Move" Items="attackerMoves" DisplayText="@(m => m.Name)" ValueSelector="@(m => m.Id.ToString())"
                            SelectedValue="@(s.Move?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Move = data.FindMove(ParseId(v)); BuildText(); })" Placeholder="例: じしん">
                            <ItemTemplate Context="m"><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span><span class="text-muted ms-auto">@(m.Power > 0 ? m.Power.ToString() : "-")</span></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Defender))
                {
                    <div class="cmd-f-poke">
                        <label class="form-label">@(s.Kind == "faster" ? "相手のポケモン" : "防御側ポケモン")</label>
                        <SearchableSelect TItem="Pokemon" Items="data.Pokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Defender?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Defender = data.FindPokemon(ParseId(v)); BuildText(); })" Placeholder="例: リザードン">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Weather))
                {
                    <div class="cmd-f-weather">
                        <label class="form-label" for="cmd-weather">天候（任意）</label>
                        <select id="cmd-weather" class="form-select" value="@s.Weather" @onchange="@(e => { s.Weather = ParseEnum(e.Value, Weather.None); BuildText(); })">
                            @foreach (var w in Enum.GetValues<Weather>()) { <option value="@w">@FieldNames.Japanese(w)</option> }
                        </select>
                    </div>
                }
                @if (Has(Field.Terrain))
                {
                    <div class="cmd-f-terrain">
                        <label class="form-label" for="cmd-terrain">フィールド（任意）</label>
                        <select id="cmd-terrain" class="form-select" value="@s.Terrain" @onchange="@(e => { s.Terrain = ParseEnum(e.Value, Terrain.None); BuildText(); })">
                            @foreach (var t in Enum.GetValues<Terrain>()) { <option value="@t">@FieldNames.Japanese(t)</option> }
                        </select>
                    </div>
                }
                @if (Has(Field.Damage))
                {
                    <div class="cmd-f-damage">
                        <label class="form-label" for="cmd-damage">受けたダメージ <Help Title="受けたダメージ">実数（93）か割合（45%）で入力します。割合のときは HP の振りも推定します。</Help></label>
                        <input id="cmd-damage" class="form-control" placeholder="例: 93 / 45%" value="@s.Damage" @onchange="@(e => { s.Damage = e.Value?.ToString() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.Memo))
                {
                    <div class="cmd-f-opt">
                        <label class="form-label" for="cmd-memo">メモ（任意） <Help Title="メモ">試合の履歴に残すメモです（例: 相手の名前）。</Help></label>
                        <input id="cmd-memo" class="form-control" placeholder="例: 〇〇さん戦" value="@s.Memo" @onchange="@(e => { s.Memo = e.Value?.ToString() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.Options))
                {
                    <div class="cmd-f-opt">
                        <label class="form-label" for="cmd-options">オプション（任意） <Help Title="オプション">+1（自分のランク）、まひ（相手）、自:まひ（自分）などをそのまま書きます。</Help></label>
                        <input id="cmd-options" class="form-control" placeholder="例: +1 まひ" value="@string.Join(" ", s.Extras)" @onchange="@(e => { s.Extras = (e.Value?.ToString() ?? "").Split(new[] { ' ', '　' }, StringSplitOptions.RemoveEmptyEntries).ToList(); BuildText(); })" />
                    </div>
                }
                @if (NoFields)
                {
                    <p class="cmd-f-none text-muted small mb-0">このコマンドは入力するものがありません。そのまま「実行」できます。</p>
                }
            </div>
        </div>
    </div>
}

@* 計算に対応していないゲームでは案内だけを出し、入力欄・コマンド一覧は出さない *@
@if (App.DataSet is not { CalcSupported: false })
{
<label class="form-label" for="cmd-input">コマンド <Help Title="コマンド欄">Enter か「実行」で配信用BOTと同じ結果が返ります。接頭辞を省略すると選択中のゲーム（!@(App.CommandPrefix)）として実行します。オプション（努力値・性格・持ち物・急所など）は末尾に続けて書けます。</Help></label>
<div class="input-group mb-2">
    <input id="cmd-input" class="form-control" placeholder="!@(App.CommandPrefix) add -m ガブリアス 4 32 0 0 0 30 ようき" value="@s.Input" @oninput="OnInput" @onkeydown="OnKeyDown" />
    <button class="btn btn-primary" @onclick="Run" disabled="@running">実行</button>
</div>

@if (!string.IsNullOrEmpty(s.Output))
{
    <div class="form-label mb-1 chat-reply-title">配信用BOTの返信 <span class="fw-normal text-muted small">チャットに配信用BOTが返す文です</span></div>
    <div class="alert @(s.Success ? "alert-success" : "alert-warning") chat-output">@s.Output</div>
}

<div class="card mt-3 pane-fill cmd-list-card">
    <div class="card-header"><h5>コマンド一覧（@(App.DataSet?.Name ?? "")） <Help Title="接頭辞">!pokech = ポケモンチャンピオンズ、!pokesv = スカーレット・バイオレット、!pokess = ソード・シールド。!poke はチャンピオンズ扱いです。登録・削除・使用チームの変更は配信者本人とモデレーターだけが使えます。</Help></h5></div>
    <div class="card-body pane-fill">
        <p class="small mb-0 cmd-legend">
            <code class="cmd-syntax"><span class="cmd-ph">名前</span></code> のように色の付いた部分は、実際の値（ポケモン名・番号など）に置き換えて打ちます。
            <code class="cmd-syntax">[ ]</code> で囲んだ部分は省略できます（括弧は打ちません）。それ以外（<code>!@(App.CommandPrefix) detail -m</code> など）はそのまま打ちます。<br />対象は短い形の <code>-m</code>（育成ポケモン）/ <code>-t</code>（自分チーム）/ <code>-r</code>（相手チーム）/ <code>-h</code>（履歴）で指定します。長い形の <code>--my</code> / <code>--team</code> / <code>--rival</code> / <code>--history</code> も同じ意味で使えます（例では、短い形の直後に同じ意味の長い形を並べています）。全角の空白・英数字は半角として読みます。
        </p>
        <div class="pane-scroll cmd-scroll">
        <div class="table-responsive">
        <table class="table table-sm cmd-table">
            <thead><tr><th>コマンド</th><th>種類</th><th>内容</th><th>例</th></tr></thead>
            <tbody>
                @foreach (var row in CommandRows())
                {
                    <tr>
                        <td class="cmd-col-syntax"><code class="cmd-syntax">@RenderSyntax(row.Syntax)</code></td>
                        <td class="cmd-col-kind"><span class="cmd-kind">@row.Kind</span></td>
                        <td class="cmd-col-desc">@row.Description</td>
                        <td class="cmd-col-example cmd-example">
                            @foreach (var ex in row.Examples)
                            {
                                <div><button type="button" class="cmd-example-btn" title="@(IsMutating(ex) ? "コマンド欄に入れます（データが変わります。「実行」を押すと実行します）" : "コマンド欄に入れます（「実行」を押すと実行します）")" @onclick="() => UseExample(ex)"><code>@ex</code></button></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <h6 class="mt-3">dmg / scan のオプション <span class="small text-muted fw-normal">（すべて任意・順不同。コマンドの末尾に続けて書きます）</span></h6>
        <div class="table-responsive">
        <table class="table table-sm cmd-options">
            <thead><tr><th>種類</th><th>書き方（例）</th><th>説明</th></tr></thead>
            <tbody>
                <tr>
                    <td>@(EvRules.Label(App.DataSet?.EvSystem ?? EvSystem.Classic))</td>
                    <td><code>A252</code> <code>H252</code></td>
                    <td>攻撃側は A / C / S、防御側は H / B / D に付きます。</td>
                </tr>
                <tr>
                    <td>性格・持ち物・特性</td>
                    <td>名前をそのまま</td>
                    <td>例: <code>いじっぱり</code> <code>たべのこし</code> <code>オボンのみ</code>。持ち物名は防御側（対戦中の相手）に付きます（攻撃側の持ち物は、育成ポケモン・自分チームの登録で決まります）。性格は上がる・下がる能力でも指定できます（<code>B↑A↓</code> <code>B↑</code> <code>A↓</code>）</td>
                </tr>
                <tr>
                    <td>どちら側か</td>
                    <td><code>攻:</code> <code>防:</code>（<code>攻撃:</code> <code>防御:</code> <code>こうげき:</code> <code>ぼうぎょ:</code> <code>A:</code> <code>B:</code> <code>C:</code> <code>D:</code> も可。全角の「：」も可。英字は攻撃側・防御側の指定だけで、ランクなどが効く能力は技の分類で決まります）</td>
                    <td>項目の前に付けて、攻撃側・防御側のどちらに付けるかを明示します。</td>
                </tr>
                <tr>
                    <td>ランク</td>
                    <td><code>+2</code></td>
                    <td>攻撃側のランク補正。</td>
                </tr>
                <tr>
                    <td>急所・壁</td>
                    <td><code>急所</code> <code>壁</code></td>
                    <td>壁はリフレクター / ひかりのかべ。</td>
                </tr>
                <tr>
                    <td>バトル形式</td>
                    <td><code>ダブル</code></td>
                    <td>ダブルバトルとして計算します（複数対象の技・壁の倍率）。</td>
                </tr>
                @if (App.DataSet?.HasTerastal == true)
                {
                    <tr>
                        <td>テラスタル</td>
                        <td><code>テラス</code> <code>テラスほのお</code> <code>防:テラスみず</code></td>
                        <td><code>テラス</code> だけなら技のタイプでテラスタルします。</td>
                    </tr>
                }
                @if (App.DataSet?.HasDynamax == true)
                {
                    <tr>
                        <td>ダイマックス</td>
                        <td><code>ダイマ</code> <code>防:ダイマ</code></td>
                        <td>既定は攻撃側。<code>防:</code> を付けると防御側。</td>
                    </tr>
                }
                <tr>
                    <td>天候</td>
                    <td><code>晴れ</code> <code>雨</code> <code>砂嵐</code> <code>雪</code></td>
                    <td></td>
                </tr>
                <tr>
                    <td>フィールド</td>
                    <td><code>エレキフィールド</code> <code>グラスフィールド</code> <code>サイコフィールド</code> <code>ミストフィールド</code></td>
                    <td></td>
                </tr>
                <tr>
                    <td>状態異常</td>
                    <td><code>やけど</code> <code>まひ</code> <code>どく</code> <code>もうどく</code> <code>ねむり</code> <code>こおり</code></td>
                    <td>やけど・まひの既定は攻撃側、どく・もうどく・ねむり・こおりの既定は防御側（どく系は定数ダメージを確定数に含めます）。</td>
                </tr>
            </tbody>
        </table>
        </div>

        <h6 class="mt-3">指定しなかった項目</h6>
        <ul class="small mb-0">
            <li>攻撃側は、攻撃技に合わせて A か C に全振りします。</li>
            <li>防御側は H に全振りします。</li>
            <li>性格は使用率 1 位にします。攻撃側は登録済みのポケモンなので、持ち物も含めて、育成ポケモン・自分チームの登録で決まります（持ち物名を攻撃側に付けることはできません）。防御側（対戦中の相手）の持ち物は、書いたもの（たべのこし など。前置きなしでも防御側に付きます）・相手チームに保存した持ち物・メガストーンだけで、不明なら持ち物なしとして計算し、返信にも出しません。</li>
            <li>特性は使用率 1 位（無ければ第 1 特性）にします。ただし天候・フィールドを作る特性やダメージが上がる特性を持っていれば、そちらを優先します。</li>
            <li>使用チームにいるポケモンは、チームの構成が優先されます。</li>
            <li>防御側に書いた持ち物がオボンのみ・たべのこし・半減きのみなどなら、確定数に反映します。</li>
            <li>埋めた内容は結果にそのまま表示します。相手の特性で結果が変わる場合は「特性別:」が付きます。</li>
        </ul>
        </div>
    </div>
</div>
}

