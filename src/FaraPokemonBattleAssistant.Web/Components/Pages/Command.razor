@page "/command"
@inherits AppPageBase
@inject DataCatalog Catalog
@inject PokeCommand Poke
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>チャットコマンド | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>チャットコマンドを試す <Help Title="チャットコマンド">Twitch のチャットに打つのと同じ文字列を入力すると、ボットが返す 1 行がそのまま表示されます。接頭辞（!@(App.CommandPrefix)）は左のメニューで選んだゲームに合わせて変わります。</Help></h3>
    <p class="mb-1">Twitch の配信チャットでボット（<a href="https://github.com/fara1991/fara-bot-moderator" target="_blank" rel="noopener noreferrer">FaraBotModerator</a>）に打つ <code>!@(App.CommandPrefix)</code> のコマンドを、ブラウザで組み立てて試せるページです。配信中に打つ前に結果を確かめたり、使えるコマンドを調べたりするときに使います。</p>
    <p class="text-muted mb-0">下の選択欄を変えるとコマンドに反映され、コマンドを書き換えると選択欄にも反映されます。</p>
    <p class="text-muted small mb-0 mt-1">H: HP / A: こうげき / B: ぼうぎょ / C: とくこう / D: とくぼう / S: すばやさ（<a href="glossary">用語・略語</a>）</p>
</div>

@if (App.DataSet is { CalcSupported: false } refOnly)
{
    <CalcUnsupported DataSet="refOnly" Feature="チャットコマンド（計算・登録）" />
}
else if (data is not null)
{
    <div class="card mb-3">
        <div class="card-header"><h5>コマンドを作る</h5></div>
        <div class="card-body py-2">
            <div class="cmd-build">
                <div class="cmd-f-kind">
                    <label class="form-label" for="cmd-kind">種類 <Help Title="種類">実行したいコマンドの種類です。選ぶと、そのコマンドに必要な入力欄だけが出て、下のコマンド欄に文字列を組み立てます。dmg はダメージと確定数、calc は受けたダメージから相手の努力値を推定します。</Help></label>
                    <select id="cmd-kind" class="form-select" value="@s.Kind" @onchange="@(e => { s.Kind = e.Value?.ToString() ?? "dmg"; BuildText(); })">
                        @foreach (var group in KindGroups())
                        {
                            <optgroup label="@group.Key">
                                @foreach (var k in group)
                                {
                                    <option value="@k.Key">@k.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                @if (Has(Field.Subject))
                {
                    <div class="cmd-f-poke">
                        <label class="form-label">@(s.Kind == "add -p" ? "ポケモン" : "ポケモン名（任意）")</label>
                        <SearchableSelect TItem="Pokemon" Items="data.Pokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Subject?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Subject = data.FindPokemon(ParseId(v)); BuildText(); })" Placeholder="例: ガブリアス">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Evs))
                {
                    <div class="cmd-f-evs">
                        <label class="form-label">@(EvRules.Label(App.DataSet?.EvSystem ?? EvSystem.Classic))（H A B C D S）</label>
                        <div class="cmd-evs">
                            @for (var i = 0; i < 6; i++)
                            {
                                var idx = i;
                                var stat = (Stat)idx;
                                <input class="form-control text-center px-1" inputmode="numeric" maxlength="3" placeholder="@StatNames.Letter(stat)" aria-label="@StatNames.Japanese(stat)" title="@StatNames.Japanese(stat)"
                                       value="@s.Evs[idx]" @onchange="@(e => { s.Evs[idx] = e.Value?.ToString()?.Trim() ?? ""; BuildText(); })" />
                            }
                        </div>
                    </div>
                }
                @if (Has(Field.Nature))
                {
                    <div class="cmd-f-nature">
                        <label class="form-label" for="cmd-nature">性格</label>
                        <select id="cmd-nature" class="form-select" value="@s.NatureName" @onchange="@(e => { s.NatureName = e.Value?.ToString() ?? ""; BuildText(); })">
                            <option value="">選ぶ</option>
                            @foreach (var n in data.Natures) { <option value="@n.Name">@n.Describe()</option> }
                        </select>
                    </div>
                }
                @if (Has(Field.Ability))
                {
                    <div class="cmd-f-ability">
                        <label class="form-label" for="cmd-ability">特性（任意）</label>
                        <select id="cmd-ability" class="form-select" value="@s.AbilityName" @onchange="@(e => { s.AbilityName = e.Value?.ToString() ?? ""; BuildText(); })">
                            <option value="">指定しない</option>
                            @if (s.Subject is not null)
                            {
                                @foreach (var ab in data.AbilitiesOf(s.Subject)) { <option value="@ab.Name">@ab.Name</option> }
                            }
                        </select>
                    </div>
                }
                @if (Has(Field.EntryId))
                {
                    <div class="cmd-f-num">
                        <label class="form-label" for="cmd-entry">登録 ID <Help Title="登録 ID">登録したポケモンの番号です。「ポケモン登録」ページか ls -p コマンドで分かります。</Help></label>
                        <input id="cmd-entry" class="form-control" inputmode="numeric" placeholder="例: 1" value="@s.EntryId" @onchange="@(e => { s.EntryId = e.Value?.ToString()?.Trim() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.TeamNo))
                {
                    <div class="cmd-f-num">
                        <label class="form-label" for="cmd-team">チーム番号</label>
                        <input id="cmd-team" class="form-control" inputmode="numeric" placeholder="例: 1" value="@s.TeamNo" @onchange="@(e => { s.TeamNo = e.Value?.ToString()?.Trim() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.TeamItem))
                {
                    <div class="cmd-f-item">
                        <label class="form-label">持ち物（任意）</label>
                        <SearchableSelect TItem="Item" Items="data.Items" DisplayText="@(i => i.Name)" ValueSelector="@(i => i.Id.ToString())" Dropdown="true" EmptyOption="指定しない"
                            SelectedValue="@(data.Items.FirstOrDefault(i => i.Name == s.ItemName)?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.ItemName = data.FindItem(ParseId(v))?.Name ?? ""; BuildText(); })" Placeholder="例: こだわりスカーフ" />
                    </div>
                }

                @if (Has(Field.Attacker))
                {
                    <div class="cmd-f-poke">
                        <label class="form-label">@(s.Kind == "faster" ? "自分のポケモン" : "攻撃側ポケモン")</label>
                        <SearchableSelect TItem="Pokemon" Items="data.Pokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Attacker?.Id.ToString() ?? "")" SelectedValueChanged="@OnAttackerChanged" Placeholder="例: ガブリアス">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Move))
                {
                    <div class="cmd-f-move">
                        <label class="form-label">技 <Help Title="技">攻撃側のポケモンが覚える技だけを使用率の高い順に表示します。「じしん+1」のように技名の後ろにランクを付けることもできます。</Help></label>
                        <SearchableSelect TItem="Move" Items="attackerMoves" DisplayText="@(m => m.Name)" ValueSelector="@(m => m.Id.ToString())"
                            SelectedValue="@(s.Move?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Move = data.FindMove(ParseId(v)); BuildText(); })" Placeholder="例: じしん">
                            <ItemTemplate Context="m"><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span><span class="text-muted ms-auto">@(m.Power > 0 ? m.Power.ToString() : "-")</span></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Defender))
                {
                    <div class="cmd-f-poke">
                        <label class="form-label">@(s.Kind == "faster" ? "相手のポケモン" : "防御側ポケモン")</label>
                        <SearchableSelect TItem="Pokemon" Items="data.Pokemon" DisplayText="@(p => p.Name)" ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Defender?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { s.Defender = data.FindPokemon(ParseId(v)); BuildText(); })" Placeholder="例: リザードン">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                    </div>
                }
                @if (Has(Field.Weather))
                {
                    <div class="cmd-f-weather">
                        <label class="form-label" for="cmd-weather">天候（任意）</label>
                        <select id="cmd-weather" class="form-select" value="@s.Weather" @onchange="@(e => { s.Weather = ParseEnum(e.Value, Weather.None); BuildText(); })">
                            @foreach (var w in Enum.GetValues<Weather>()) { <option value="@w">@FieldNames.Japanese(w)</option> }
                        </select>
                    </div>
                }
                @if (Has(Field.Terrain))
                {
                    <div class="cmd-f-terrain">
                        <label class="form-label" for="cmd-terrain">フィールド（任意）</label>
                        <select id="cmd-terrain" class="form-select" value="@s.Terrain" @onchange="@(e => { s.Terrain = ParseEnum(e.Value, Terrain.None); BuildText(); })">
                            @foreach (var t in Enum.GetValues<Terrain>()) { <option value="@t">@FieldNames.Japanese(t)</option> }
                        </select>
                    </div>
                }
                @if (Has(Field.Damage))
                {
                    <div class="cmd-f-damage">
                        <label class="form-label" for="cmd-damage">受けたダメージ <Help Title="受けたダメージ">実数（93）か割合（45%）で入力します。割合のときは HP の振りも推定します。</Help></label>
                        <input id="cmd-damage" class="form-control" placeholder="例: 93 / 45%" value="@s.Damage" @onchange="@(e => { s.Damage = e.Value?.ToString() ?? ""; BuildText(); })" />
                    </div>
                }
                @if (Has(Field.Options))
                {
                    <div class="cmd-f-opt">
                        <label class="form-label" for="cmd-options">オプション（任意） <Help Title="オプション">+1（自分のランク）、まひ（相手）、自:まひ（自分）などをそのまま書きます。</Help></label>
                        <input id="cmd-options" class="form-control" placeholder="例: +1 まひ" value="@string.Join(" ", s.Extras)" @onchange="@(e => { s.Extras = (e.Value?.ToString() ?? "").Split(new[] { ' ', '　' }, StringSplitOptions.RemoveEmptyEntries).ToList(); BuildText(); })" />
                    </div>
                }
                @if (NoFields)
                {
                    <p class="cmd-f-none text-muted small mb-0">このコマンドは入力するものがありません。そのまま「実行」できます。</p>
                }
            </div>
        </div>
    </div>
}

@* 計算に対応していないゲームでは案内だけを出し、入力欄・コマンド一覧は出さない *@
@if (App.DataSet is not { CalcSupported: false })
{
<label class="form-label" for="cmd-input">コマンド <Help Title="コマンド欄">Enter か「実行」でボットと同じ結果が返ります。接頭辞を省略すると選択中のゲーム（!@(App.CommandPrefix)）として実行します。オプション（努力値・性格・持ち物・急所など）は末尾に続けて書けます。</Help></label>
<div class="input-group mb-2">
    <input id="cmd-input" class="form-control" placeholder="!@(App.CommandPrefix) dmg ガブリアス じしん リザードン" value="@s.Input" @oninput="OnInput" @onkeydown="OnKeyDown" />
    <button class="btn btn-primary" @onclick="Run" disabled="@running">実行</button>
</div>

@if (!string.IsNullOrEmpty(s.Output))
{
    <div class="form-label mb-1 chat-reply-title">ボットの返信 <span class="fw-normal text-muted small">チャットにボットが返す文です</span></div>
    <div class="alert @(s.Success ? "alert-success" : "alert-warning") chat-output">@s.Output</div>
}

<div class="card mt-3 pane-fill cmd-list-card">
    <div class="card-header"><h5>コマンド一覧（@(App.DataSet?.Name ?? "")） <Help Title="接頭辞">!pokech = ポケモンチャンピオンズ、!pokesv = スカーレット・バイオレット、!pokess = ソード・シールド。!poke はチャンピオンズ扱いです。登録・削除・使用チームの変更は配信者本人とモデレーターだけが使えます。</Help></h5></div>
    <div class="card-body pane-fill">
        <p class="small mb-0 cmd-legend">
            <code class="cmd-syntax"><span class="cmd-ph">名前</span></code> のように色の付いた部分は、実際の値（ポケモン名・番号など）に置き換えて打ちます。
            <code class="cmd-syntax">[ ]</code> で囲んだ部分は省略できます（括弧は打ちません）。それ以外（<code>!@(App.CommandPrefix) detail -p</code> など）はそのまま打ちます。<br />対象は <code>-p</code>（ポケモン）/ <code>-t</code>（チーム）で指定します（長い形は <code>--pokemon</code> / <code>--team</code>）。全角の空白・英数字は半角として読みます。
        </p>
        <div class="pane-scroll cmd-scroll">
        <div class="table-responsive">
        <table class="table table-sm cmd-table">
            <thead><tr><th>コマンド</th><th>種類</th><th>内容</th><th>例</th></tr></thead>
            <tbody>
                @foreach (var row in CommandRows())
                {
                    <tr>
                        <td class="cmd-col-syntax"><code class="cmd-syntax">@RenderSyntax(row.Syntax)</code></td>
                        <td class="cmd-col-kind"><span class="cmd-kind">@row.Kind</span></td>
                        <td class="cmd-col-desc">@row.Description</td>
                        <td class="cmd-col-example cmd-example">
                            @foreach (var ex in row.Examples)
                            {
                                <div><button type="button" class="cmd-example-btn" title="@(IsMutating(ex) ? "コマンド欄に入れます（データが変わります。「実行」を押すと実行します）" : "コマンド欄に入れます（「実行」を押すと実行します）")" @onclick="() => UseExample(ex)"><code>@ex</code></button></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <h6 class="mt-3">dmg / calc のオプション <span class="small text-muted fw-normal">（すべて任意・順不同。コマンドの末尾に続けて書きます）</span></h6>
        <div class="table-responsive">
        <table class="table table-sm cmd-options">
            <thead><tr><th>種類</th><th>書き方（例）</th><th>説明</th></tr></thead>
            <tbody>
                <tr>
                    <td>@(EvRules.Label(App.DataSet?.EvSystem ?? EvSystem.Classic))</td>
                    <td><code>A252</code> <code>H252</code></td>
                    <td>攻撃側は A / C / S、防御側は H / B / D に付きます。</td>
                </tr>
                <tr>
                    <td>性格・持ち物・特性</td>
                    <td>名前をそのまま</td>
                    <td>例: <code>いじっぱり</code> <code>こだわりハチマキ</code> <code>かたいツメ</code></td>
                </tr>
                <tr>
                    <td>どちら側か</td>
                    <td><code>攻:</code> <code>防:</code></td>
                    <td>項目の前に付けて、攻撃側・防御側のどちらに付けるかを明示します。</td>
                </tr>
                <tr>
                    <td>ランク</td>
                    <td><code>+2</code></td>
                    <td>攻撃側のランク補正。</td>
                </tr>
                <tr>
                    <td>急所・壁</td>
                    <td><code>急所</code> <code>壁</code></td>
                    <td>壁はリフレクター / ひかりのかべ。</td>
                </tr>
                <tr>
                    <td>残り HP</td>
                    <td><code>HP50%</code> <code>攻:HP30%</code></td>
                    <td>既定は防御側の残り HP。<code>攻:</code> を付けると攻撃側（もうか等）。</td>
                </tr>
                <tr>
                    <td>バトル形式</td>
                    <td><code>ダブル</code></td>
                    <td>ダブルバトルとして計算します（複数対象の技・壁の倍率）。</td>
                </tr>
                @if (App.DataSet?.HasTerastal == true)
                {
                    <tr>
                        <td>テラスタル</td>
                        <td><code>テラス</code> <code>テラスほのお</code> <code>防:テラスみず</code></td>
                        <td><code>テラス</code> だけなら技のタイプでテラスタルします。</td>
                    </tr>
                }
                @if (App.DataSet?.HasDynamax == true)
                {
                    <tr>
                        <td>ダイマックス</td>
                        <td><code>ダイマ</code> <code>防:ダイマ</code></td>
                        <td>既定は攻撃側。<code>防:</code> を付けると防御側。</td>
                    </tr>
                }
                <tr>
                    <td>天候</td>
                    <td><code>晴れ</code> <code>雨</code> <code>砂嵐</code> <code>雪</code></td>
                    <td></td>
                </tr>
                <tr>
                    <td>フィールド</td>
                    <td><code>エレキフィールド</code> <code>グラスフィールド</code> <code>サイコフィールド</code> <code>ミストフィールド</code></td>
                    <td></td>
                </tr>
                <tr>
                    <td>状態異常</td>
                    <td><code>やけど</code> <code>まひ</code> <code>どく</code> <code>もうどく</code> <code>ねむり</code> <code>こおり</code></td>
                    <td>やけど・まひの既定は攻撃側、どく・もうどく・ねむり・こおりの既定は防御側（どく系は定数ダメージを確定数に含めます）。</td>
                </tr>
            </tbody>
        </table>
        </div>

        <h6 class="mt-3">指定しなかった項目</h6>
        <ul class="small mb-0">
            <li>攻撃側は、攻撃技に合わせて A か C に全振りします。</li>
            <li>防御側は H に全振りします。</li>
            <li>性格・持ち物は使用率 1 位にします。</li>
            <li>特性は使用率 1 位（無ければ第 1 特性）にします。ただし天候・フィールドを作る特性やダメージが上がる特性を持っていれば、そちらを優先します。</li>
            <li>使用チームにいるポケモンは、チームの構成が優先されます。</li>
            <li>防御側の持ち物がオボンのみ・たべのこし・半減きのみなどなら、確定数に自動で反映します。</li>
            <li>埋めた内容は結果にそのまま表示します。相手の特性で結果が変わる場合は「特性別:」が付きます。</li>
        </ul>
        </div>
    </div>
</div>
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public string Kind { get; set; } = "dmg";
        public Pokemon? Attacker { get; set; }
        public Move? Move { get; set; }
        public int MoveRank { get; set; }
        public Pokemon? Defender { get; set; }
        public Weather Weather { get; set; }
        public Terrain Terrain { get; set; }
        public string Damage { get; set; } = "";
        // 登録・チーム系のコマンド用
        public Pokemon? Subject { get; set; }
        public string[] Evs { get; set; } = new string[6] { "", "", "", "", "", "" };
        public string NatureName { get; set; } = "";
        public string AbilityName { get; set; } = "";
        public string EntryId { get; set; } = "";
        public string TeamNo { get; set; } = "";
        public string ItemName { get; set; } = "";
        public List<string> Extras { get; set; } = new();
        public string Input { get; set; } = "";
        public string Output { get; set; } = "";
        public bool Success { get; set; }
    }

    private sealed record CommandRow(string Syntax, string Kind, string Description, IReadOnlyList<string> Examples);

    private State s = new();
    private PokemonDataSet? data;
    private UsageData? usage;
    private IReadOnlyList<Move> attackerMoves = Array.Empty<Move>();
    private bool running;

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>("command");
        await LoadAsync();
    }

    protected override async Task OnAppChangedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var switched = s.DataSetKey != App.DataSetKey;
        if (switched)
        {
            // 接頭辞はデータの読み込みを待たずにすぐ切り替える（入力の残りはそのまま）
            var previousPrefix = s.DataSetKey == "" ? null : App.DataSets.FirstOrDefault(d => d.Key == s.DataSetKey)?.CommandPrefix;
            if (previousPrefix is not null && s.Input.StartsWith("!" + previousPrefix + " ", StringComparison.OrdinalIgnoreCase))
                s.Input = "!" + App.CommandPrefix + s.Input[(previousPrefix.Length + 1)..];
            s.DataSetKey = App.DataSetKey;
            s.Attacker = null;
            s.Move = null;
            s.Defender = null;
            attackerMoves = Array.Empty<Move>();
            StateHasChanged();
        }
        data = await Catalog.GetDataSetAsync(App.DataSetKey);
        usage = await data.GetUsageAsync(App.Format);
        if (switched) ParseText();
        RefreshMoves();
    }

    private static int ParseId(object? value) => int.TryParse(value?.ToString(), out var v) ? v : 0;
    private static T ParseEnum<T>(object? value, T fallback) where T : struct => Enum.TryParse<T>(value?.ToString(), out var v) ? v : fallback;

    private void OnAttackerChanged(string value)
    {
        s.Attacker = data?.FindPokemon(ParseId(value));
        RefreshMoves();
        if (s.Move is not null && s.Attacker is not null && data is not null && !data.CanLearn(s.Attacker.Id, s.Move.Id))
            s.Move = null;
        BuildText();
    }

    private void RefreshMoves()
    {
        if (data is null || s.Attacker is null) { attackerMoves = data?.Moves ?? Array.Empty<Move>(); return; }
        var moves = data.LearnableMoves(s.Attacker.Id).Where(m => m.Category != MoveCategory.Status).ToList();
        attackerMoves = usage is null ? moves : usage.SortByUsage(moves, m => m.Id, usage.MoveOrder(s.Attacker.Id));
    }

    // ---- 種類ごとの入力欄 ----

    private enum Field { Subject, Evs, Nature, Ability, EntryId, TeamNo, TeamItem, Attacker, Move, Defender, Weather, Terrain, Damage, Options }

    private sealed record KindDef(string Key, string Label, string Group, Field[] Fields);

    /// <summary>コマンドの種類（コマンド一覧の書式・種類の分類に合わせる）。Fields はその種類で必要な入力欄で、並べる順。</summary>
    private IReadOnlyList<KindDef> Kinds()
    {
        var ev = EvRules.Label(App.DataSet?.EvSystem ?? EvSystem.Classic);
        return new KindDef[]
        {
            new("add -p", "add -p（登録）", "ポケモン", new[] { Field.Subject, Field.Evs, Field.Nature, Field.Ability }),
            new("ls -p", "ls -p（一覧）", "ポケモン", new[] { Field.Subject }),
            new("detail -p", "detail -p（詳細）", "ポケモン", new[] { Field.EntryId }),
            new("rm -p", "rm -p（削除）", "ポケモン", new[] { Field.EntryId }),
            new("add -t", "add -t（追加）", "チーム", new[] { Field.TeamNo, Field.EntryId, Field.TeamItem }),
            new("rm -t", "rm -t（外す・削除）", "チーム", new[] { Field.TeamNo, Field.Subject }),
            new("use -t", "use -t（使用）", "チーム", new[] { Field.TeamNo }),
            new("unuse -t", "unuse -t（解除）", "チーム", Array.Empty<Field>()),
            new("ls -t", "ls -t（一覧）", "チーム", Array.Empty<Field>()),
            new("detail -t", "detail -t（詳細）", "チーム", new[] { Field.TeamNo }),
            new("dmg", "dmg（ダメージ）", "対戦", new[] { Field.Attacker, Field.Move, Field.Defender, Field.Weather, Field.Terrain }),
            new("calc", $"calc（{ev}推定）", "対戦", new[] { Field.Attacker, Field.Move, Field.Defender, Field.Weather, Field.Terrain, Field.Damage }),
            new("faster", "faster（素早さ比較）", "対戦", new[] { Field.Attacker, Field.Defender, Field.Weather, Field.Options }),
            new("help", "help（コマンド一覧）", "ヘルプ", Array.Empty<Field>()),
        };
    }

    private IEnumerable<IGrouping<string, KindDef>> KindGroups() => Kinds().GroupBy(k => k.Group);

    private KindDef CurrentKind => Kinds().FirstOrDefault(k => k.Key == s.Kind) ?? Kinds().First(k => k.Key == "dmg");

    private bool Has(Field f) => CurrentKind.Fields.Contains(f);

    private bool NoFields => CurrentKind.Fields.Length == 0;

    /// <summary>選択欄の内容からコマンド文字列を作る。</summary>
    private void BuildText()
    {
        var parts = new List<string> { "!" + App.CommandPrefix };
        parts.AddRange(s.Kind.Split(' '));
        string Or(string value, string placeholder) => string.IsNullOrWhiteSpace(value) ? placeholder : value.Trim();
        switch (s.Kind)
        {
            case "add -p":
                parts.Add(s.Subject?.Name ?? "名前");
                for (var i = 0; i < 6; i++) parts.Add(Or(s.Evs[i], StatNames.Letter((Stat)i)));
                parts.Add(Or(s.NatureName, "性格"));
                if (!string.IsNullOrEmpty(s.AbilityName)) parts.Add(s.AbilityName);
                break;
            case "ls -p":
                if (s.Subject is not null) parts.Add(s.Subject.Name);
                break;
            case "detail -p":
            case "rm -p":
                parts.Add(Or(s.EntryId, "登録ID"));
                break;
            case "add -t":
                parts.Add(Or(s.TeamNo, "チーム番号"));
                parts.Add(Or(s.EntryId, "登録ID"));
                if (!string.IsNullOrEmpty(s.ItemName)) parts.Add(s.ItemName);
                break;
            case "rm -t":
                parts.Add(Or(s.TeamNo, "チーム番号"));
                if (s.Subject is not null) parts.Add(s.Subject.Name);
                break;
            case "use -t":
            case "detail -t":
                parts.Add(Or(s.TeamNo, "チーム番号"));
                break;
            case "faster":
                parts.Add(s.Attacker?.Name ?? "自分");
                parts.Add(s.Defender?.Name ?? "相手");
                parts.AddRange(s.Extras);
                if (s.Weather != Weather.None) parts.Add(FieldNames.Japanese(s.Weather));
                break;
            case "dmg":
            case "calc":
                parts.Add(s.Attacker?.Name ?? "攻撃側");
                parts.Add((s.Move?.Name ?? "技") + (s.MoveRank != 0 ? (s.MoveRank > 0 ? "+" : "") + s.MoveRank : ""));
                parts.Add(s.Defender?.Name ?? "防御側");
                if (s.Kind == "calc") parts.Add(string.IsNullOrWhiteSpace(s.Damage) ? "受けたダメージ" : s.Damage.Trim());
                parts.AddRange(s.Extras);
                if (s.Weather != Weather.None) parts.Add(FieldNames.Japanese(s.Weather));
                if (s.Terrain != Terrain.None) parts.Add(FieldNames.Japanese(s.Terrain));
                break;
        }
        s.Input = string.Join(" ", parts);
    }

    private void OnInput(ChangeEventArgs e)
    {
        s.Input = e.Value?.ToString() ?? "";
        ParseText();
    }

    /// <summary>コマンドの種類を読み取る。分からなければ null（入力途中など）。</summary>
    private static string? DetectKind(List<string> tokens, out int consumed)
    {
        consumed = 0;
        if (tokens.Count == 0) return null;
        var first = tokens[0].ToLowerInvariant();
        var second = tokens.Count > 1 ? tokens[1].ToLowerInvariant() : "";
        if ((second is "-t" or "--team") && first is "add" or "rm" or "use" or "unuse" or "ls" or "detail") { consumed = 2; return first + " -t"; }
        if ((second is "-p" or "--pokemon") && first is "add" or "rm" or "ls" or "detail") { consumed = 2; return first + " -p"; }
        if (first is "help" or "dmg" or "calc" or "faster") { consumed = 1; return first; }
        return null;
    }

    private static string NumberOrEmpty(IReadOnlyList<string> tokens, int index) =>
        index < tokens.Count && int.TryParse(tokens[index], out _) ? tokens[index] : "";

    /// <summary>コマンド文字列を読み取り、選択欄に反映する。</summary>
    private void ParseText()
    {
        if (data is null) return;
        var tokens = CommandText.Normalize(s.Input).Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (tokens.Count > 0 && tokens[0].StartsWith('!')) tokens.RemoveAt(0);
        var kind = DetectKind(tokens, out var consumed);
        if (kind is null) return;
        s.Kind = kind;
        tokens.RemoveRange(0, consumed);

        var pokemonResolver = DamageCommand.CreatePokemonResolver(data);
        Pokemon? PokemonAt(int i) => i < tokens.Count ? pokemonResolver.Resolve(tokens[i]).Value : null;

        switch (kind)
        {
            case "add -p":
                s.Subject = PokemonAt(0);
                for (var i = 0; i < 6; i++) s.Evs[i] = NumberOrEmpty(tokens, 1 + i);
                s.NatureName = tokens.Count > 7 && data.FindNature(tokens[7]) is { } n ? n.Name : "";
                s.AbilityName = tokens.Count > 8 ? tokens[8] : "";
                return;
            case "ls -p":
                s.Subject = PokemonAt(0);
                return;
            case "detail -p":
            case "rm -p":
                s.EntryId = NumberOrEmpty(tokens, 0);
                return;
            case "add -t":
                s.TeamNo = NumberOrEmpty(tokens, 0);
                s.EntryId = NumberOrEmpty(tokens, 1);
                s.ItemName = tokens.Count > 2 && new NameResolver<Item>(data.Items, i => i.Name).Resolve(tokens[2]).Value is { } item ? item.Name : "";
                return;
            case "rm -t":
                s.TeamNo = NumberOrEmpty(tokens, 0);
                s.Subject = PokemonAt(1);
                return;
            case "use -t":
            case "detail -t":
                s.TeamNo = NumberOrEmpty(tokens, 0);
                return;
            case "unuse -t":
            case "ls -t":
            case "help":
                return;
        }

        // dmg / calc / faster
        s.Attacker = PokemonAt(0);
        RefreshMoves();
        s.Weather = Weather.None;
        s.Terrain = Terrain.None;
        var extras = new List<string>();
        List<string> rest;
        if (kind == "faster")
        {
            s.Defender = PokemonAt(1);
            rest = tokens.Skip(2).ToList();
        }
        else
        {
            var moveResolver = new NameResolver<Move>(data.Moves, m => m.Name);
            if (tokens.Count > 1)
            {
                var (moveName, rank) = DamageCommand.SplitRankSuffix(tokens[1]);
                s.Move = moveResolver.Resolve(moveName).Value;
                s.MoveRank = rank;
            }
            else
            {
                s.Move = null;
                s.MoveRank = 0;
            }
            s.Defender = PokemonAt(2);
            s.Damage = "";
            rest = tokens.Skip(3).ToList();
            if (kind == "calc" && rest.Count > 0)
            {
                s.Damage = rest[0];
                rest.RemoveAt(0);
            }
        }
        foreach (var token in rest)
        {
            if (DamageCommand.ParseWeather(token) is { } w) { s.Weather = w; continue; }
            if (kind != "faster" && DamageCommand.ParseTerrain(token) is { } t) { s.Terrain = t; continue; }
            extras.Add(token);
        }
        s.Extras = extras;
    }

    /// <summary>登録・削除・チームの変更など、データを書き換えるコマンドか（接頭辞は省略可）。</summary>
    private static bool IsMutating(string text)
    {
        var tokens = text.Split(new[] { ' ', '　', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        var i = tokens.Length > 0 && tokens[0].StartsWith('!') ? 1 : 0;
        return i < tokens.Length && tokens[i].ToLowerInvariant() is "add" or "rm" or "use" or "unuse";
    }

    /// <summary>例をコマンド欄に入れるだけ。実行は「実行」を押したときだけ。</summary>
    private async Task UseExample(string example)
    {
        s.Input = example;
        ParseText();
        try { await JS.InvokeVoidAsync("faraFocus", "cmd-input"); }
        catch (JSException) { }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Run();
    }

    private async Task Run()
    {
        if (running) return;
        running = true;
        try
        {
            var text = s.Input.Trim();
            var match = await Poke.MatchAsync(text);
            if (match is null)
                text = $"!{App.CommandPrefix} {text.TrimStart('!')}";
            var result = await Poke.ExecuteAsync(text, new PokeCommandOptions { Format = App.Format });
            if (IsMutating(text))
            {
                // 登録データを変えるコマンドの結果は、画面右上のトーストで知らせる
                s.Output = "";
                if (result.Success) Toast.Success(result.Message); else Toast.Error(result.Message);
            }
            else
            {
                s.Success = result.Success;
                s.Output = result.Message;
            }
        }
        finally
        {
            running = false;
        }
    }

    private IEnumerable<CommandRow> CommandRows()
    {
        var p = "!" + App.CommandPrefix;
        var ds = App.DataSet;
        var points = ds?.EvSystem == EvSystem.Points;
        var evLabel = EvRules.Label(ds?.EvSystem ?? EvSystem.Classic);
        var evExample = points ? "4 32 0 0 0 30" : "4 252 0 0 0 252";
        var gimmick = ds?.HasTerastal == true ? " テラスほのお" : ds?.HasDynamax == true ? " ダイマ" : "";
        // <...> は置き換える値（画面では色付きで表示）、[...] は省略できる部分
        yield return new($"{p} add -p <名前> <H> <A> <B> <C> <D> <S> <性格> [<特性>]", "ポケモン",
            points ? $"育成済みポケモンを登録（{evLabel}は各 0〜32、合計 66）" : $"育成済みポケモンを登録（{evLabel}は各 0〜252、合計 510）",
            new[] { $"{p} add -p ガブリアス {evExample} ようき さめはだ" });
        yield return new($"{p} ls -p [<名前>]", "ポケモン", "登録一覧（名前を付けるとそのポケモンだけ）", new[] { $"{p} ls -p", $"{p} ls -p ガブリアス" });
        yield return new($"{p} detail -p <登録ID>", "ポケモン", "登録の詳細（性格・振り・特性・実数値・所属チーム）", new[] { $"{p} detail -p 1" });
        yield return new($"{p} rm -p <登録ID>", "ポケモン", "登録を削除（チームからも外れる）", new[] { $"{p} rm -p 1" });
        yield return new($"{p} add -t <チーム番号> <登録ID> [<持ち物>]", "チーム", "チームに追加（6 体まで）。同じ登録 ID をもう一度指定すると持ち物を更新", new[] { $"{p} add -t 1 1 こだわりスカーフ" });
        yield return new($"{p} rm -t <チーム番号> [<名前>]", "チーム", "チームから外す（名前を省くとチームごと削除。0 体になったチームも自動で削除）", new[] { $"{p} rm -t 1 ガブリアス", $"{p} rm -t 1" });
        yield return new($"{p} use -t <チーム番号>", "チーム", "使用チームにする。以降の dmg / calc / faster はこのチームの構成で計算", new[] { $"{p} use -t 1" });
        yield return new($"{p} unuse -t", "チーム", "使用チームを解除（以降は使用率に基づく既定値で計算）", new[] { $"{p} unuse -t" });
        yield return new($"{p} ls -t", "チーム", "チーム一覧", new[] { $"{p} ls -t" });
        yield return new($"{p} detail -t <チーム番号>", "チーム", "チームの詳細", new[] { $"{p} detail -t 1" });
        yield return new($"{p} dmg <攻撃側> <技>[<±ランク>] <防御側> [<オプション>]", "対戦", "通常と急所のダメージと確定数。使用チームにいるポケモンはその構成（持ち物は括弧内に表示）。オプションは下の表",
            new[] { $"{p} dmg ガブリアス じしん リザードン", $"{p} dmg ガブリアス じしん+1 リザードン 晴れ 急所", $"{p} dmg ガブリアス げきりん ドドゲザン 壁 HP50%", $"{p} dmg イエッサン ワイドフォース メガリザードンX サイコフィールド", $"{p} dmg ガブリアス じしん リザードン A252 いじっぱり こだわりハチマキ{gimmick}" });
        yield return new($"{p} calc <攻撃側> <技>[<±ランク>] <防御側> <受けたダメージ> [<オプション>]", "対戦", "受けた（与えた）ダメージから相手の防御側の努力値と性格補正を推定。93 なら実数、45% なら割合（H も推定）",
            new[] { $"{p} calc ガブリアス じしん リザードン 93", $"{p} calc ガブリアス じしん リザードン 45% サイコフィールド" });
        yield return new($"{p} faster <自分> <相手> [<オプション>]", "対戦", $"素早さ比較。自分は使用チームの実数値、相手は 無振り / 準速 / 最速 / {(data?.Items.Any(i => i.Id == 264) == true ? "スカーフ最速 / " : "")}最遅。オプションは +1（自分のランク）・天候・まひ（相手）・自:まひ",
            new[] { $"{p} faster ガブリアス リザードン", $"{p} faster ガブリアス リザードン +1 まひ" });
        yield return new($"{p} help", "ヘルプ", "使えるコマンドの一覧（!poke help でも可）", new[] { $"{p} help" });
    }

    /// <summary>書式の &lt;...&gt; を置き換える値（色付き）として表示する。&lt; &gt; 自体は出さない。</summary>
    private static RenderFragment RenderSyntax(string syntax) => __builder =>
    {
        foreach (var part in System.Text.RegularExpressions.Regex.Split(syntax, "(<[^>]+>)"))
        {
            if (part.Length == 0) continue;
            if (part.StartsWith('<') && part.EndsWith('>'))
            {
                <span class="cmd-ph">@part[1..^1]</span>
            }
            else
            {
                @part
            }
        }
    };
