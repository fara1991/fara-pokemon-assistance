    private IEnumerable<IGrouping<string, KindDef>> KindGroups() => Kinds().OrderBy(k => OrderOf(k.Key)).GroupBy(k => k.Group);

    private KindDef CurrentKind => Kinds().FirstOrDefault(k => k.Key == s.Kind) ?? Kinds().First();

    private bool Has(Field f) => CurrentKind.Fields.Contains(f);

    private bool NoFields => CurrentKind.Fields.Length == 0;

    /// <summary>選択欄の内容からコマンド文字列を作る。</summary>
    private void BuildText()
    {
        var parts = new List<string> { "!" + App.CommandPrefix };
        parts.AddRange(s.Kind.Split(' '));
        string Or(string value, string placeholder) => string.IsNullOrWhiteSpace(value) ? placeholder : value.Trim();
        switch (s.Kind)
        {
            case "add -m":
                parts.Add(s.Subject?.Name ?? "名前");
                for (var i = 0; i < 6; i++) parts.Add(Or(s.Evs[i], StatNames.Letter((Stat)i)));
                parts.Add(Or(s.NatureName, "性格"));
                if (!string.IsNullOrEmpty(s.AbilityName)) parts.Add(s.AbilityName);
                break;
            case "ls -m":
            case "ls -h":
                if (s.Subject is not null) parts.Add(s.Subject.Name);
                break;
            case "detail -m":
            case "rm -m":
                parts.Add(Or(s.EntryId, "登録ID"));
                break;
            case "detail -h":
            case "rm -h":
                parts.Add(Or(s.EntryId, "履歴ID"));
                break;
            case "set -m":
                // 登録 ID があればそれ、なければ名前で指定する
                parts.Add(!string.IsNullOrWhiteSpace(s.EntryId) ? s.EntryId.Trim() : s.Subject?.Name ?? "登録IDか名前");
                AddSpecParts(parts);
                break;
            case "add -r":
                var picked = s.Rivals.Where(p => p is not null).Select(p => p!.Name).ToList();
                if (picked.Count == 0) parts.Add("名前");
                else parts.AddRange(picked);
                break;
            case "set -r":
                parts.Add(s.Subject?.Name ?? "名前");
                AddSpecParts(parts);
                parts.AddRange(s.RivalMoves.Where(m => !string.IsNullOrWhiteSpace(m)).Distinct());
                if (!string.IsNullOrEmpty(s.ItemName)) parts.Add(s.ItemName);
                break;
            case "detail -r":
            case "rm -r":
                parts.Add(s.Subject?.Name ?? "名前");
                break;
            case "end":
                if (!string.IsNullOrWhiteSpace(s.Memo)) parts.Add(s.Memo.Trim());
                break;
            case "add -t":
                parts.Add(Or(s.TeamNo, "チーム番号"));
                parts.Add(Or(s.EntryId, "登録ID"));
                if (!string.IsNullOrEmpty(s.ItemName)) parts.Add(s.ItemName);
                break;
            case "rm -t":
                parts.Add(Or(s.TeamNo, "チーム番号"));
                if (s.Subject is not null) parts.Add(s.Subject.Name);
                break;
            case "use -t":
            case "detail -t":
                parts.Add(Or(s.TeamNo, "チーム番号"));
                break;
            case "faster":
                parts.Add(s.Attacker?.Name ?? "自分");
                parts.Add(s.Defender?.Name ?? "相手");
                parts.AddRange(s.Extras);
                if (s.Weather != Weather.None) parts.Add(FieldNames.Japanese(s.Weather));
                break;
            case "dmg":
            case "scan":
                parts.Add(s.Attacker?.Name ?? "攻撃側");
                parts.Add((s.Move?.Name ?? "技") + (s.MoveRank != 0 ? (s.MoveRank > 0 ? "+" : "") + s.MoveRank : ""));
                parts.Add(s.Defender?.Name ?? "防御側");
                if (s.Kind == "scan") parts.Add(string.IsNullOrWhiteSpace(s.Damage) ? "受けたダメージ" : s.Damage.Trim());
                parts.AddRange(s.Extras);
                if (s.Weather != Weather.None) parts.Add(FieldNames.Japanese(s.Weather));
                if (s.Terrain != Terrain.None) parts.Add(FieldNames.Japanese(s.Terrain));
                break;
        }
        s.Input = string.Join(" ", parts);
    }

    /// <summary>set・add -r 用: 入っている能力だけ「H32 D10」の形で付け、性格・特性は選んでいれば付ける。</summary>
    private void AddSpecParts(List<string> parts)
    {
        for (var i = 0; i < 6; i++)
            if (!string.IsNullOrWhiteSpace(s.Evs[i])) parts.Add(StatNames.Letter((Stat)i) + s.Evs[i].Trim());
        if (!string.IsNullOrEmpty(s.NatureName)) parts.Add(s.NatureName);
        if (!string.IsNullOrEmpty(s.AbilityName)) parts.Add(s.AbilityName);
    }

    private static readonly System.Text.RegularExpressions.Regex EvPairToken = new(@"([HABCDS])(\d{1,3})");

    /// <summary>set・add -r 用: 「H32 D10」・6 つの数字の並び・性格・特性を読み取って欄に入れる。</summary>
    private void ParseSpecTokens(List<string> tokens)
    {
        for (var i = 0; i < 6; i++) s.Evs[i] = "";
        s.NatureName = "";
        s.AbilityName = "";
        var numbers = tokens.TakeWhile(t => int.TryParse(t, out _)).Take(6).ToList();
        if (numbers.Count == 6)
        {
            for (var i = 0; i < 6; i++) s.Evs[i] = numbers[i];
            tokens = tokens.Skip(6).ToList();
        }
        foreach (var token in tokens)
        {
            var upper = token.ToUpperInvariant();
            var pairs = EvPairToken.Matches(upper);
            if (pairs.Count > 0 && string.Concat(pairs.Select(x => x.Value)) == upper)
            {
                foreach (System.Text.RegularExpressions.Match x in pairs)
                    if (StatNames.Parse(x.Groups[1].Value) is { } stat) s.Evs[(int)stat] = x.Groups[2].Value;
                continue;
            }
            if (data!.FindNature(token) is { } n) { s.NatureName = n.Name; continue; }
            if (s.Subject is not null && data.AbilitiesOf(s.Subject).FirstOrDefault(a => a.Name == token) is { } ab) s.AbilityName = ab.Name;
        }
    }

    private int evVersion;

    /// <summary>A の方が C 以上なら物理向け（性格を片方だけ選んだとき、C を下げる側に補う）。</summary>
    private bool CmdPhysical => (int.TryParse(s.Evs[(int)Stat.Attack], out var a) ? a : 0) >= (int.TryParse(s.Evs[(int)Stat.SpAttack], out var c) ? c : 0);

    /// <summary>その枠で選べる相手の技。選んだポケモンが覚える技から、ほかの枠で選んだ技を除く。</summary>
    private IReadOnlyList<Move> RivalMoveChoices(int slot)
    {
        if (data is null || s.Subject is null) return Array.Empty<Move>();
        var taken = s.RivalMoves.Where((m, i) => i != slot && m.Length > 0).ToHashSet();
        return data.LearnableMoves(s.Subject.Id).Where(m => !taken.Contains(m.Name)).ToList();
    }

    /// <summary>ポイントの入力欄の文字を、空欄か 0〜最大の数字にそろえる。</summary>
    private string EvText(object? value)
    {
        var max = EvRules.MaxPerStat(App.DataSet?.EvSystem ?? EvSystem.Classic);
        return int.TryParse(value?.ToString(), out var v) ? Math.Clamp(v, 0, max).ToString() : "";
    }

    /// <summary>set -r 用: 名前の後ろに書かれた、相手が覚える技を読み取って欄に入れる。</summary>
    private void ParseRivalMoves(List<string> tokens)
    {
        Array.Fill(s.RivalMoves, "");
        if (s.Subject is null) return;
        var learnable = data!.LearnableMoves(s.Subject.Id);
        var n = 0;
        foreach (var token in tokens)
            if (n < s.RivalMoves.Length && learnable.FirstOrDefault(m => m.Name == token) is { } mv && !s.RivalMoves.Contains(mv.Name)) s.RivalMoves[n++] = mv.Name;
    }

    /// <summary>set -r 用: 名前の後ろに書かれた、相手の持ち物（確定情報）を読み取って欄に入れる。</summary>
    private void ParseRivalItem(List<string> tokens)
    {
        s.ItemName = "";
        foreach (var token in tokens)
            if (data!.Items.FirstOrDefault(i => i.Name == token) is { } held) s.ItemName = held.Name;
    }

    private void OnInput(ChangeEventArgs e)
    {
        s.Input = e.Value?.ToString() ?? "";
        ParseText();
    }

    /// <summary>コマンドの種類を読み取る。分からなければ null（入力途中など）。</summary>
    private static string? DetectKind(List<string> tokens, out int consumed)
    {
        consumed = 0;
        if (tokens.Count == 0) return null;
        var first = tokens[0].ToLowerInvariant();
        var second = tokens.Count > 1 ? tokens[1].ToLowerInvariant() : "";
        if ((second is "-t" or "--team") && first is "add" or "rm" or "use" or "unuse" or "ls" or "detail") { consumed = 2; return first + " -t"; }
        if ((second is "-m" or "--my") && first is "add" or "set" or "rm" or "ls" or "detail") { consumed = 2; return first + " -m"; }
        if ((second is "-r" or "--rival") && first is "add" or "set" or "rm" or "ls" or "detail" or "clear") { consumed = 2; return first + " -r"; }
        if ((second is "-h" or "--history") && first is "rm" or "ls" or "detail") { consumed = 2; return first + " -h"; }
        if (first is "help" or "dmg" or "scan" or "faster" or "end") { consumed = 1; return first; }
        return null;
    }

    private static string NumberOrEmpty(IReadOnlyList<string> tokens, int index) =>
        index < tokens.Count && int.TryParse(tokens[index], out _) ? tokens[index] : "";

    /// <summary>コマンド文字列を読み取り、選択欄に反映する。</summary>
    private void ParseText()
    {
        if (data is null) return;
        var tokens = CommandText.Normalize(s.Input).Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (tokens.Count > 0 && tokens[0].StartsWith('!')) tokens.RemoveAt(0);
        var kind = DetectKind(tokens, out var consumed);
        if (kind is null) return;
        s.Kind = kind;
        tokens.RemoveRange(0, consumed);

        var pokemonResolver = DamageCommand.CreatePokemonResolver(data);
        Pokemon? PokemonAt(int i) => i < tokens.Count ? pokemonResolver.Resolve(tokens[i]).Value : null;

        switch (kind)
        {
            case "add -m":
                s.Subject = PokemonAt(0);
                ParseSpecTokens(tokens.Skip(1).ToList());
                return;
            case "ls -m":
            case "ls -h":
            case "detail -r":
            case "rm -r":
                s.Subject = PokemonAt(0);
                return;
            case "set -m":
                if (tokens.Count > 0 && int.TryParse(tokens[0].TrimStart('#'), out _)) { s.EntryId = tokens[0].TrimStart('#'); s.Subject = null; }
                else { s.EntryId = ""; s.Subject = PokemonAt(0); }
                ParseSpecTokens(tokens.Skip(1).ToList());
                return;
            case "add -r":
                Array.Clear(s.Rivals);
                for (int i = 0, n = 0; i < tokens.Count && n < 6; i++)
                    if (PokemonAt(i) is { } rp) s.Rivals[n++] = rp;
                return;
            case "set -r":
                s.Subject = PokemonAt(0);
                ParseSpecTokens(tokens.Skip(1).ToList());
                ParseRivalMoves(tokens.Skip(1).ToList());
                ParseRivalItem(tokens.Skip(1).ToList());
                return;
            case "detail -h":
            case "rm -h":
                s.EntryId = NumberOrEmpty(tokens, 0);
                return;
            case "end":
                s.Memo = string.Join(" ", tokens);
                return;
            case "clear -r":
            case "ls -r":
                return;
            case "detail -m":
            case "rm -m":
                s.EntryId = NumberOrEmpty(tokens, 0);
                return;
            case "add -t":
                s.TeamNo = NumberOrEmpty(tokens, 0);
                s.EntryId = NumberOrEmpty(tokens, 1);
                s.ItemName = tokens.Count > 2 && new NameResolver<Item>(data.Items, i => i.Name).Resolve(tokens[2]).Value is { } item ? item.Name : "";
                return;
            case "rm -t":
                s.TeamNo = NumberOrEmpty(tokens, 0);
                s.Subject = PokemonAt(1);
                return;
            case "use -t":
            case "detail -t":
                s.TeamNo = NumberOrEmpty(tokens, 0);
                return;
            case "unuse -t":
            case "ls -t":
            case "help":
                return;
        }

        // dmg / calc / faster
        s.Attacker = PokemonAt(0);
        RefreshMoves();
        s.Weather = Weather.None;
        s.Terrain = Terrain.None;
        var extras = new List<string>();
        List<string> rest;
        if (kind == "faster")
        {
            s.Defender = PokemonAt(1);
            rest = tokens.Skip(2).ToList();
        }
        else
        {
            var moveResolver = new NameResolver<Move>(data.Moves, m => m.Name);
            if (tokens.Count > 1)
            {
                var (moveName, rank) = DamageCommand.SplitRankSuffix(tokens[1]);
                s.Move = moveResolver.Resolve(moveName).Value;
                s.MoveRank = rank;
            }
            else
            {
                s.Move = null;
                s.MoveRank = 0;
            }
            s.Defender = PokemonAt(2);
            s.Damage = "";
            rest = tokens.Skip(3).ToList();
            if (kind == "scan" && rest.Count > 0)
            {
                s.Damage = rest[0];
                rest.RemoveAt(0);
            }
        }
        foreach (var token in rest)
        {
            if (DamageCommand.ParseWeather(token) is { } w) { s.Weather = w; continue; }
            if (kind != "faster" && DamageCommand.ParseTerrain(token) is { } t) { s.Terrain = t; continue; }
            extras.Add(token);
        }
        s.Extras = extras;
    }

    /// <summary>登録・削除・チームの変更など、データを書き換えるコマンドか（接頭辞は省略可）。</summary>
    private static bool IsMutating(string text)
    {
        var tokens = text.Split(new[] { ' ', '　', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        var i = tokens.Length > 0 && tokens[0].StartsWith('!') ? 1 : 0;
        return i < tokens.Length && tokens[i].ToLowerInvariant() is "add" or "set" or "rm" or "use" or "unuse" or "clear" or "end";
    }

    /// <summary>例をコマンド欄に入れるだけ。実行は「実行」を押したときだけ。</summary>
    private async Task UseExample(string example)
    {
        s.Input = example;
        ParseText();
        try { await JS.InvokeVoidAsync("faraFocus", "cmd-input"); }
        catch (JSException) { }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Run();
    }

    private async Task Run()
    {
        if (running) return;
        running = true;
        try
        {
            var text = s.Input.Trim();
            var match = await Poke.MatchAsync(text);
            if (match is null)
                text = $"!{App.CommandPrefix} {text.TrimStart('!')}";
            var result = await Poke.ExecuteAsync(text, new PokeCommandOptions { Format = App.Format });
            if (IsMutating(text))
            {
                // 登録データを変えるコマンドの結果は、画面右上のトーストで知らせる
                s.Output = "";
                if (result.Success) Toast.Success(result.Message); else Toast.Error(result.Message);
            }
            else
            {
                s.Success = result.Success;
                s.Output = result.Message;
            }
        }
        finally
        {
            running = false;
        }
    }

    /// <summary>コマンドの並び順（コマンド一覧とコマンドを作るの種類で同じ。種類ごとにまとめる）。</summary>
    private static readonly string[] CommandOrder =
    {
        "add -m", "set -m", "ls -m", "detail -m", "rm -m",
        "add -t", "rm -t", "use -t", "unuse -t", "ls -t", "detail -t",
        "add -r", "set -r", "ls -r", "detail -r", "rm -r", "clear -r",
        "dmg", "scan", "faster", "end",
        "ls -h", "detail -h", "rm -h",
        "help",
    };

    private static int OrderOf(string key) { var i = Array.IndexOf(CommandOrder, key); return i < 0 ? CommandOrder.Length : i; }

    /// <summary>書式（!pokech add -m …）から、並び順のキー（add -m / dmg）を取り出す。</summary>
    private static string KeyOf(string syntax)
    {
        var tokens = syntax.Split(' ', StringSplitOptions.RemoveEmptyEntries).Skip(1).ToList();
        if (tokens.Count == 0) return "";
        return tokens.Count > 1 && tokens[1].StartsWith('-') ? $"{tokens[0]} {tokens[1]}" : tokens[0];
    }

    private IEnumerable<CommandRow> CommandRows() => UnorderedCommandRows().OrderBy(r => OrderOf(KeyOf(r.Syntax)));

    private IEnumerable<CommandRow> UnorderedCommandRows()
    {
        var p = "!" + App.CommandPrefix;
        var ds = App.DataSet;
        var points = ds?.EvSystem == EvSystem.Points;
        var evLabel = EvRules.Label(ds?.EvSystem ?? EvSystem.Classic);
        var evExample = points ? "4 32 0 0 0 30" : "4 252 0 0 0 252";
        var gimmick = ds?.HasTerastal == true ? " テラスほのお" : ds?.HasDynamax == true ? " ダイマ" : "";
        // <...> は置き換える値（画面では色付きで表示）、[...] は省略できる部分
        yield return new($"{p} add -m <名前> <H> <A> <B> <C> <D> <S> <性格> [<特性>]", "育成ポケモン",
            points ? $"育成済みポケモンを登録（{evLabel}は各 0〜32、合計 66）" : $"育成済みポケモンを登録（{evLabel}は各 0〜252、合計 510）",
            new[] { $"{p} add -m ガブリアス {evExample} ようき さめはだ", $"{p} add --my ガブリアス {evExample} ようき さめはだ" });
        yield return new($"{p} ls -m [<名前>]", "育成ポケモン", "登録一覧（名前を付けるとそのポケモンだけ）", new[] { $"{p} ls -m", $"{p} ls --my", $"{p} ls -m ガブリアス" });
        yield return new($"{p} detail -m <登録ID>", "育成ポケモン", "登録の詳細（性格・振り・特性・実数値・所属チーム）", new[] { $"{p} detail -m 1", $"{p} detail --my 1" });
        yield return new($"{p} rm -m <登録ID>", "育成ポケモン", "登録を削除（チームからも外れる）", new[] { $"{p} rm -m 1", $"{p} rm --my 1" });
        yield return new($"{p} add -t <チーム番号> <登録ID> [<持ち物>]", "自分チーム", "チームに追加（6 体まで）。同じ登録 ID をもう一度指定すると持ち物を更新", new[] { $"{p} add -t 1 1 こだわりスカーフ", $"{p} add --team 1 1 こだわりスカーフ" });
        yield return new($"{p} rm -t <チーム番号> [<名前>]", "自分チーム", "チームから外す（名前を省くとチームごと削除。0 体になったチームも自動で削除）", new[] { $"{p} rm -t 1 ガブリアス", $"{p} rm --team 1 ガブリアス", $"{p} rm -t 1" });
        yield return new($"{p} use -t <チーム番号>", "自分チーム", "使用チームにする。以降の dmg / scan / faster はこのチームの構成で計算", new[] { $"{p} use -t 1", $"{p} use --team 1" });
        yield return new($"{p} unuse -t", "自分チーム", "使用チームを解除（以降は使用率に基づく既定値で計算）", new[] { $"{p} unuse -t", $"{p} unuse --team" });
        yield return new($"{p} ls -t", "自分チーム", "チーム一覧", new[] { $"{p} ls -t", $"{p} ls --team" });
        yield return new($"{p} detail -t <チーム番号>", "自分チーム", "チームの詳細", new[] { $"{p} detail -t 1", $"{p} detail --team 1" });
        yield return new($"{p} dmg <攻撃側> <技>[<±ランク>] <防御側> [<オプション>]", "対戦", "【攻撃側は登録済みのポケモンが必須】通常と急所のダメージと確定数。使用チームにいればその構成、いなければ登録の構成（持ち物は括弧内に表示）。同じポケモンを複数登録しているときは #登録ID で指定する（名前だけだと一覧を出して案内する）。特性でダメージが変わるときは、特性ごとの結果も出す。オプションは下の表",
            new[] { $"{p} dmg ガブリアス じしん リザードン", $"{p} dmg ガブリアス じしん+1 リザードン 晴れ 急所", $"{p} dmg ガブリアス げきりん ドドゲザン 壁", $"{p} dmg イエッサン ワイドフォース メガリザードンX サイコフィールド", $"{p} dmg ガブリアス じしん リザードン A252 いじっぱり{gimmick}" });
        yield return new($"{p} set -m <登録IDか名前> [<振り方>] [<性格>] [<特性>]", "育成ポケモン", "登録済みの育成ポケモンの、書いた項目だけを更新（技・チーム・持ち物はそのまま）。振り方を書いたときは振り方全体の置き換え（書いていない能力は 0）。性格は名前か B↑A↓ で指定",
