    /// <summary>書式の &lt;...&gt; を置き換える値（色付き）として表示する。&lt; &gt; 自体は出さない。</summary>
    private static RenderFragment RenderSyntax(string syntax) => __builder =>
    {
        foreach (var part in System.Text.RegularExpressions.Regex.Split(syntax, "(<[^>]+>)"))
        {
            if (part.Length == 0) continue;
            if (part.StartsWith('<') && part.EndsWith('>'))
            {
                <span class="cmd-ph">@part[1..^1]</span>
            }
            else
            {
                @part
            }
        }
    };
}
