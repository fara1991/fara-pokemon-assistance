        yield return new($"{p} ls -r", "相手チーム", "対戦中の相手の一覧（分かっている振り方・推定の範囲つき）", new[] { $"{p} ls -r", $"{p} ls --rival" });
        yield return new($"{p} detail -r <名前>", "相手チーム", "相手 1 体の詳細（推定の根拠つき）", new[] { $"{p} detail -r カイリュー", $"{p} detail --rival カイリュー" });
        yield return new($"{p} rm -r <名前>", "相手チーム", "登録ミスなどの取り消し（履歴には残さない）", new[] { $"{p} rm -r カイリュー", $"{p} rm --rival カイリュー" });
        yield return new($"{p} clear -r", "相手チーム", "対戦中の相手の登録を全員解除する（履歴には残さない）。試合を終えて履歴に残すときは end を使う",
            new[] { $"{p} clear -r", $"{p} clear --rival" });
        yield return new($"{p} end [<メモ>]", "対戦", "試合を終える。対戦中の相手を全員（名前だけの相手も）履歴に移し、対戦中の相手を空にする。選出した相手・見えた技・ポイント・性格・特性・推定も一緒に残る。メモを付けられる",
            new[] { $"{p} end", $"{p} end ○○さん戦" });
        yield return new($"{p} ls -h [<名前>]", "履歴", "終わった試合の履歴（新しい順）。名前を付けると、そのポケモンがいた試合の振り方", new[] { $"{p} ls -h", $"{p} ls --history", $"{p} ls -h カイリュー" });
