@inject NavigationManager Nav
@* 以前の URL を新しい URL に転送する（既存のリンク・ブックマーク用）。対応表は Core の SitePaths.Legacy。
   上の @page は対応表の以前の URL と同じにしておく（SitePathsTests で確認）。API のパス（/api/my/pokemon など）とは別 *@

@code {
    protected override void OnInitialized()
    {
        var target = FaraPokemonBattleAssistant.Core.SitePaths.Redirect(Nav.ToBaseRelativePath(Nav.Uri));
        if (target is not null) Nav.NavigateTo(target, replace: true);
    }
}
