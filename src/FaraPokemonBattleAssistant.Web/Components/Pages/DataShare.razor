@page "/data-share"
@using FaraPokemonBattleAssistant.Core.Roster
@implements IDisposable
@inject CloudSync Sync
@inject FaraPokemonBattleAssistant.Core.Roster.RosterRepository Repo
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>データ共有 | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>データ共有 <Help Title="データ共有">登録したポケモンとチームを、別のブラウザ・端末や配信用BOTと共有するための設定です。使わないときは、登録データはこのブラウザだけに保存されます。</Help></h3>
    <p class="text-muted mb-0">アクセスキーを作ると、<a href="my-pokemon">ポケモン登録</a>と<a href="my-team">チーム登録</a>のデータがクラウドに保存され、同じアクセスキーを入れた別のブラウザ・端末や配信用BOTから読み書きできます。</p>
</div>

@* PC: 見出しは固定にして、カードの中だけがスクロールする *@
<div class="pane-scroll">
<div class="sync-page">
<div class="card mb-3 sync-card">
    <div class="card-header">
        <h5>アクセスキー @(Sync.IsSyncing ? "（データ共有中）" : "（未共有）")</h5>
    </div>
    <div class="card-body">
        @if (!Sync.IsSyncing)
        {
            <Notice Class="mb-2">今はこのブラウザだけに保存しています。データ共有を始めると、別のブラウザ・端末や配信用BOTと同じ登録データを読み書きできます。</Notice>
            <div class="d-flex flex-wrap gap-2 align-items-start">
                <button class="btn btn-primary btn-sm" disabled="@syncBusy" @onclick="StartSyncAsync">データ共有を始める（新しいアクセスキーを作る）</button>
                <div class="input-group input-group-sm sync-join">
                    <input type="password" class="form-control" placeholder="アクセスキー（43 文字）" autocomplete="off" spellcheck="false" aria-label="アクセスキー"
                           value="@joinKey" @oninput="@(e => joinKey = e.Value?.ToString() ?? "")" />
                    <button class="btn btn-outline-primary" disabled="@(syncBusy || string.IsNullOrWhiteSpace(joinKey))" @onclick="JoinSyncAsync">アクセスキーを入力して共有</button>
                </div>
            </div>
            <p class="small text-muted mb-0 mt-2">アクセスキーを入力して共有を始めると、このブラウザの登録データはクラウドのデータに置き換わります。新しいアクセスキーを作ったときは、このブラウザの登録データがそのままクラウドに保存されます。</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <span>アクセスキー:</span>
                <code class="sync-key">@(showKey ? Sync.Key : new string('•', 16))</code>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => showKey = !showKey">@(showKey ? "隠す" : "表示")</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CopyKeyAsync">コピー</button>
            </div>
            <p class="small text-danger mb-2">アクセスキーはパスワードと同じです。知っている人は誰でも登録データを読み書きできるので、配信画面に映したり、人に教えたりしないでください。</p>
            <p class="small mb-2">
                @if (!string.IsNullOrEmpty(Sync.LastError))
                {
                    <span class="text-danger">読み書きできませんでした: @Sync.LastError</span>
                }
                else if (Sync.LastSyncedAt is { } at)
                {
                    <span class="text-muted">最終読み込み @at.ToLocalTime().ToString("HH:mm:ss")</span>
                }
                @if (!string.IsNullOrEmpty(Sync.LastNotice))
                {
                    <br /><span class="text-warning-emphasis">@Sync.LastNotice</span>
                }
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-primary btn-sm" disabled="@syncBusy" @onclick="ReloadAsync">読み込み直す</button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@syncBusy" @onclick="RotateKeyAsync">アクセスキーを作り直す</button>
                <button class="btn btn-outline-danger btn-sm" disabled="@syncBusy" @onclick="StopSyncAsync">データ共有をやめる</button>
            </div>
        }
    </div>
</div>


<div class="card mb-3">
    <div class="card-header"><h5>API で使うには</h5></div>
    <div class="card-body">
        <p class="small mb-2">アクセスキーを使うと、登録したポケモンとチームを、このサイトの外から API で読み書きできます。</p>
        <ol class="mb-2 ps-3">
            <li>上の「データ共有を始める」を押して、アクセスキーを作り、「コピー」でコピーします。</li>
            <li>リクエストの <code>Authorization: Bearer アクセスキー</code> ヘッダーに入れて、このサイトの API を呼びます。</li>
        </ol>
        <div class="table-responsive">
            <table class="table table-sm small mb-2">
                <thead><tr><th>API</th><th>内容</th></tr></thead>
                <tbody>
                    <tr><td><code>GET /api/my/pokemon</code></td><td>登録したポケモン（ゲームごと）を読み取ります</td></tr>
                    <tr><td><code>PUT /api/my/pokemon</code></td><td>ポケモンを保存します。消したポケモンはチームからも外れ、0 体になったチームは消えます</td></tr>
                    <tr><td><code>GET /api/my/team</code></td><td>チームと使用中のチームを読み取ります</td></tr>
                    <tr><td><code>PUT /api/my/team</code></td><td>チームと使用中のチームを保存します（登録に無いポケモン・7 体以上は受け付けません）</td></tr>
                    <tr><td><code>DELETE /api/my/access-key</code></td><td>このアクセスキーを使えなくし、データを消します（アクセスキーの作り直し用）</td></tr>
                </tbody>
            </table>
        </div>
        <p class="small text-muted mb-2">本文はゲームごと（<code>"dataSets": {"Champions": {...}}</code>）です。<code>PUT</code> には読み取ったときの <code>revision</code> を <code>baseRevision</code> として付けます。その間に他の場所で更新されていたら <code>409</code> になるので、読み直してからやり直してください（<code>revision</code> はポケモンとチームで共通です）。詳しくは <a href="https://github.com/fara1991/fara-pokemon-battle-assistant#登録データの共有-api" target="_blank" rel="noopener noreferrer">README</a> を見てください。</p>
        <p class="small text-muted mb-2">使い方の一例が、チャットの配信用BOTです。<a href="https://github.com/fara1991/fara-bot-moderator" target="_blank" rel="noopener noreferrer">FaraBotModerator</a>（Auto Bot Settings）の Game タブ → ポケモンシリーズ の「アクセスキー」欄に貼り付けると、チャットの <code>add -p</code> / <code>use -t</code> などと、このサイトが同じデータを読み書きするようになります。</p>
        <p class="small text-muted mb-2">データ共有中はクラウドのデータだけを使い、このブラウザには保存しません（コピーを取り合うのではなく、全員が同じデータを使います）。アクセスキーを作り直したら、API を使うほかのツールや端末にも新しいアクセスキーを入れ直してください（古いキーは使えなくなります）。</p>
        <p class="small text-muted mb-0">ポケモン・技・持ち物などのゲームデータ（このサイトが使っている CSV）は、アクセスキーなしで <code>/api/game/</code> から読めます（<a href="api/game/datasets.csv" target="_blank" rel="noopener noreferrer"><code>/api/game/datasets.csv</code></a> がゲームの一覧、<code>/api/game/ゲームのキー/pokemon.csv</code> などがその中身）。</p>
    </div>
</div>
</div>
</div>

@code {
    private bool syncBusy;
    private bool showKey;
    private string joinKey = "";

    protected override async Task OnInitializedAsync()
    {
        Sync.Changed += OnSyncChanged;
        // ページを直接開いたときも、保存してあるアクセスキーがあれば「データ共有中」と表示する
        await Sync.InitializeAsync();
    }

    private void OnSyncChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Sync.Changed -= OnSyncChanged;

    private void Show(string text, bool isError) => Toast.Show(text, isError);

    // ---- データ共有

    private async Task<bool> ConfirmAsync(string text)
    {
        try
        {
            return await JS.InvokeAsync<bool>("confirm", text);
        }
        catch (JSException)
        {
            return false;
        }
    }

    private async Task RunSyncAsync(Func<Task> action)
    {
        syncBusy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Show(CloudSync.Describe(ex), true);
        }
        finally
        {
            syncBusy = false;
        }
        StateHasChanged();
    }

    private Task StartSyncAsync() => RunSyncAsync(async () =>
    {
        var hadData = await Sync.LocalHasDataAsync();
        await Sync.StartNewAsync();
        showKey = false;
        Show("データ共有を始めました。" + (hadData ? "このブラウザの登録データをクラウドに保存しました。" : "") +
             "別の端末や配信用BOTで使うときは、アクセスキーを「コピー」して貼り付けてください", false);
    });

    private async Task JoinSyncAsync()
    {
        var key = joinKey.Trim();
        if (!RemoteRosterStore.IsValidKey(key))
        {
            Show("アクセスキーの形式が正しくありません（43 文字の英数字・-・_）", true);
            return;
        }
        if (await Sync.LocalHasDataAsync()
            && !await ConfirmAsync("このブラウザの登録データは削除され、クラウドのデータに置き換わります。よろしいですか？"))
            return;
        await RunSyncAsync(async () =>
        {
            var hasData = await Sync.JoinAsync(key);
            joinKey = "";
            showKey = false;
            Show(hasData
                ? "アクセスキーでデータ共有を始めました。クラウドの登録データを表示しています"
                : "アクセスキーでデータ共有を始めました（このアクセスキーのクラウドデータはまだ空です。打ち間違えていないか確認してください）", false);
        });
    }

    private async Task RotateKeyAsync()
    {
        if (!await ConfirmAsync("新しいアクセスキーを作り、データを移します。今のアクセスキーは使えなくなるので、配信用BOTや他の端末には新しいアクセスキーを入れ直してください。よろしいですか？"))
            return;
        await RunSyncAsync(async () =>
        {
            var deletedOld = await Sync.RotateAsync();
            showKey = false;
            Show(deletedOld
                ? "アクセスキーを作り直しました。配信用BOTや他の端末には新しいアクセスキーを入れ直してください"
                : "アクセスキーを作り直しました（古いアクセスキーのデータを消せませんでした。古いアクセスキーは控えずに破棄してください）", !deletedOld);
        });
    }

    private async Task StopSyncAsync()
    {
        if (!await ConfirmAsync("このブラウザでのデータ共有をやめます。クラウドのデータは残るので、アクセスキーを入力すればまた共有できます（アクセスキーを控えておいてください）。このブラウザの登録データは空になります。よろしいですか？"))
            return;
        await RunSyncAsync(async () =>
        {
            await Sync.StopAsync();
            showKey = false;
            Show("データ共有をやめました。アクセスキーを入力すれば、また同じデータで共有できます", false);
        });
    }

    private Task ReloadAsync() => RunSyncAsync(async () => { await Repo.GetAsync(); Show("クラウドの登録データを読み込み直しました", false); });

    private async Task CopyKeyAsync()
    {
        if (Sync.Key is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Sync.Key);
            Show("アクセスキーをコピーしました", false);
        }
        catch (JSException)
        {
            showKey = true;
            Show("コピーできませんでした。表示したアクセスキーを選択してコピーしてください", true);
        }
    }
}
