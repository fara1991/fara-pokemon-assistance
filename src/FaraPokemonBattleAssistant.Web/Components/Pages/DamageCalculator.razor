@page "/damage-calculator"
@inherits AppPageBase
@using FaraPokemonBattleAssistant.Core.Roster
@inject DataCatalog Catalog
@inject RosterRepository Repo
@inject NavigationManager Nav

<PageTitle>ダメージ計算機 | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>ダメージ計算機 <Help Title="ダメージ計算機">攻撃側と防御側のポケモンと技を選ぶと、乱数 16 通りのダメージと確定数を自動で出します（入力を変えるたびに計算し直します）。ポケモンを選ぶと使用率に基づく性格・持ち物・特性が既定値として入ります。ゲームとバトル形式は左のメニューで切り替えます。</Help></h3>
    <p class="text-muted mb-0">登録したポケモンは「登録から選ぶ」で、攻撃側・防御側のどちらにも呼び出せます。入力した内容は別のページへ移動しても残ります。</p>
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
@if (!string.IsNullOrEmpty(rosterError))
{
    <div class="alert alert-warning">@rosterError</div>
}

@if (dataSet is { CalcSupported: false })
{
    <CalcUnsupported DataSet="dataSet" Feature="ダメージ計算" />
}
else if (data is not null && dataSet is not null)
{
    UpdateResult();
    <div class="calc-grid pane-fill @(s.Result is not null ? "has-result-bar" : "")">
        <div class="calc-col">
            <div class="card">
                <div class="card-header"><h5>攻撃側</h5></div>
                <div class="card-body">
                    <RosterPicker Groups="rosterGroups" ShowEmptyHint="@(string.IsNullOrEmpty(rosterError))" OnPick="@(c => PickFromRoster(c, true))" />
                    <div class="form-group mb-2">
                        <label>ポケモン <Help Title="ポケモン">名前の一部（ひらがな・ローマ字でも可。例: ie → イエッサン）で絞り込めます。使用率の高い順に並んでいます。</Help></label>
                        <SearchableSelect TItem="Pokemon"
                            Items="pokemonList"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Attacker?.Pokemon.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnAttackerChanged"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p">@PokemonRow(p)</ItemTemplate>
                        </SearchableSelect>
                    </div>
                    @if (s.Attacker is not null)
                    {
                        <div class="poke-summary mb-2"><PokemonLabel Build="s.Attacker" /> <span class="small text-muted text-nowrap">種族値 @FormatStats(s.Attacker.Pokemon.BaseStats)</span></div>
                    }
                    <div class="form-group mb-3">
                        <label>技 <Help Title="技">攻撃側のポケモンが覚える技を、いまの攻撃側・防御側・天候・フィールド・壁で与える最大ダメージの多い順（火力の高い順）に表示します。防御側を選んでいないときは、タイプなし・種族値すべて 100 の相手で計算します。同じダメージなら使用率の高い順です。選んだ技の分類（物理 / 特殊）に合わせて、下の努力値・ランクの項目が切り替わります。</Help></label>
                        <SearchableSelect TItem="Move"
                            Items="MoveChoices"
                            DisplayText="@(m => m.Name)"
                            ValueSelector="@(m => m.Id.ToString())"
                            SelectedValue="@(s.Move?.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnMoveChanged"
                            Dropdown="true"
                            Placeholder="技名を入力...">
                            <ItemTemplate Context="m"><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span><span class="text-muted ms-auto">@CategoryText(m) @(m.Power > 0 ? m.Power.ToString() : "-")</span></ItemTemplate>
                        </SearchableSelect>
                        @if (s.Move is not null)
                        {
                            <div class="small text-muted mt-1"><TypeIcon Type="@s.Move.Type" Small="true" /> @CategoryText(s.Move) 威力 @(s.Move.Power > 0 ? s.Move.Power.ToString() : "-")@(s.Move.UsesPhysicalDefense ? "（相手のぼうぎょで計算）" : "")@(s.Move.IsFixedDamage ? "（固定ダメージ技のため計算できません）" : "")</div>
                        }
                        @if (dataSet.HasZMove && s.Move is { IsDamaging: true })
                        {
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" role="switch" id="zmove" checked="@s.IsZMove" @onchange="@(e => s.IsZMove = e.Value is true)" />
                                <label class="form-check-label" for="zmove">Z技にする（威力 @ZMove.Power(s.Move)） <Help Title="Z技">第7世代の Z 技として計算します。威力は元の技の威力から決まる Z 技の威力になり、持ち物は Z クリスタル扱い（ほかの持ち物の効果なし）です。接触・パンチなどの技の性質や追加効果は無くなるので、かたいツメ・てつのこぶし・ちからずくなどは効きません。スキン系の特性でタイプは変わりません。</Help></label>
                            </div>
                        }
                    </div>
                    @if (s.Attacker is not null)
                    {
                        @RenderBuildEditor(s.Attacker, true)
                    }
                </div>
            </div>
        </div>

        <div class="calc-right">
        <div class="calc-col">
            <div class="card">
                <div class="card-header"><h5>防御側</h5></div>
                <div class="card-body">
                    <RosterPicker Groups="rosterGroups" ShowEmptyHint="@(string.IsNullOrEmpty(rosterError))" OnPick="@(c => PickFromRoster(c, false))" />
                    <div class="form-group mb-2">
                        <label>ポケモン</label>
                        <SearchableSelect TItem="Pokemon"
                            Items="pokemonList"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Defender?.Pokemon.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnDefenderChanged"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p">@PokemonRow(p)</ItemTemplate>
                        </SearchableSelect>
                    </div>
                    @if (s.Defender is not null)
                    {
                        <div class="poke-summary mb-2"><PokemonLabel Build="s.Defender" /> <span class="small text-muted text-nowrap">種族値 @FormatStats(s.Defender.Pokemon.BaseStats)</span></div>
                        @RenderBuildEditor(s.Defender, false)
                    }
                </div>
            </div>
        </div>

        <div class="calc-col calc-side">
            <div class="card field-card">
                <div class="card-header"><h5>場の状態 <Help Title="場の状態">天候・フィールドは、攻撃側・防御側の特性（ひでり・サイコメイカーなど）から自動で入ります。変えたいときは選び直してください。技の並び順にもここの条件が反映されます。</Help></h5></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label mb-1" for="weather">天候 <Help Title="天候">晴れはほのお 1.5 倍・みず 0.5 倍、雨はその逆。砂嵐はいわタイプのとくぼう 1.5 倍、雪はこおりタイプのぼうぎょ 1.5 倍（第7世代までは「あられ」で、ぼうぎょは上がりません）。天候で発動する特性（サンパワー等）にも使います。</Help></label>
                            <select id="weather" class="form-select" value="@s.Weather" @onchange="@(e => s.Weather = ParseEnum(e.Value, Weather.None))">
                                @foreach (var w in Enum.GetValues<Weather>())
                                {
                                    <option value="@w">@FieldNames.Japanese(w, dataSet.Generation)</option>
                                }
                            </select>
                        </div>
                        @if (dataSet.HasTerrain)
                        {
                        <div class="col-sm-6">
                            <label class="form-label mb-1" for="terrain">フィールド <Help Title="フィールド">エレキ・グラス・サイコは対応タイプの技が 1.3 倍（第7世代までは 1.5 倍）、ミストはドラゴン技が 0.5 倍。グラスではじしん系が半減、サイコではワイドフォースが強化されます。地面にいるポケモンにだけ効きます。フィールドは第6世代から（サイコフィールドは第7世代から）です。</Help></label>
                            <select id="terrain" class="form-select" value="@s.Terrain" @onchange="@(e => s.Terrain = ParseEnum(e.Value, Terrain.None))">
                                @foreach (var t in Enum.GetValues<Terrain>().Where(t => t != Terrain.Psychic || dataSet.HasPsychicTerrain))
                                {
                                    <option value="@t">@FieldNames.Japanese(t)</option>
                                }
                            </select>
                        </div>
                        }
                    </div>
                    <div class="field-checks mt-2">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="reflect" checked="@s.Reflect" @onchange="@(e => s.Reflect = e.Value is true)" />
                            <label class="form-check-label" for="reflect">リフレクター <Help Title="リフレクター">防御側の場のリフレクター。物理技のダメージが 0.5 倍（ダブルは約 0.67 倍）になります。オーロラベールは両方にチェックしてください。急所と特性すりぬけは壁を無視します。</Help></label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="light-screen" checked="@s.LightScreen" @onchange="@(e => s.LightScreen = e.Value is true)" />
                            <label class="form-check-label" for="light-screen">ひかりのかべ <Help Title="ひかりのかべ">防御側の場のひかりのかべ。特殊技のダメージが 0.5 倍（ダブルは約 0.67 倍）になります。</Help></label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="crit" checked="@s.IsCritical" @onchange="@(e => s.IsCritical = e.Value is true)" />
                            <label class="form-check-label" for="crit">急所 <Help Title="急所">ダメージ 1.5 倍（スナイパーは 2.25 倍）。攻撃側のマイナスランクと防御側のプラスランクを無視します。</Help></label>
                        </div>
                    </div>
                </div>
            </div>

            @if (s.Result is not null && s.LastRequest is not null)
            {
                <div class="card result-card result-sticky">
                    <div class="card-header"><h5>計算結果 <Help Title="計算結果の見方">「確定 2 発」は 16 通りの乱数すべてで 2 回当てれば倒せること、「乱数 2 発(75%)」は 2 回で倒せる確率です。どく・やけどの定数ダメージ、オボンのみ等の回復きのみ、たべのこし・くろいヘドロ、グラスフィールドの回復、半減きのみ（1 発目のみ）、マルチスケイル（満タン時の 1 発目のみ）も確定数に含めています。入力を変えると自動で計算し直します。</Help></h5></div>
                    <div class="card-body">@RenderResultBody(s.Result, s.LastRequest)</div>
                </div>
                @* 狭い画面では、結果の要点を画面の下に出したままにする（押すと詳細を開く） *@
                <div class="result-bar @(resultBarOpen ? "open" : "")">
                    @if (resultBarOpen)
                    {
                        <div class="result-bar-detail" data-motion-static>@RenderResultBody(s.Result, s.LastRequest)</div>
                    }
                    <button type="button" class="result-bar-summary" aria-expanded="@(resultBarOpen ? "true" : "false")" @onclick="() => resultBarOpen = !resultBarOpen">
                        <TypeIcon Type="@s.Result.MoveType" Small="true" />
                        <strong>@s.Result.RangeText</strong>
                        <span class="badge @(s.Result.KnockOut.IsGuaranteed ? "bg-danger" : "bg-warning text-dark")">@s.Result.KnockOut</span>
                        <span class="result-bar-toggle" aria-hidden="true">@(resultBarOpen ? "▾ 閉じる" : "▴ 詳細")</span>
                    </button>
                </div>
            }
            else
            {
                <div class="card result-card">
                    <div class="card-header"><h5>計算結果</h5></div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-warning mb-0">@errorMessage</div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">攻撃側・防御側のポケモンと技を選ぶと、ここに結果が自動で出ます。</p>
                        }
                    </div>
                </div>
            }

            @if (s.Attacker is not null && s.Defender is not null)
            {
                @* あまり使わないので、普段は閉じておく（推定結果があるときは開いたまま） *@
                <details class="card collapsible-card" open="@(!string.IsNullOrEmpty(s.EstimateText))">
                    <summary class="card-header"><h5>相手の@(EvRules.Label(dataSet.EvSystem))を推定（calc）</h5></summary>
                    <div class="card-body">
                        <p class="small text-muted mb-2">攻撃側に自分の構成、防御側に相手のポケモンを選び、実際に受けた（与えた）ダメージを入力すると、そのダメージになりうる相手の@(EvRules.Label(dataSet.EvSystem))と性格補正の候補を出します。相手は持ち物なしとして計算します。</p>
                        <div class="input-group">
                            <span class="input-group-text">受けたダメージ</span>
                            <input class="form-control" placeholder="93 または 45%" value="@s.ObservedDamageText" @onchange="@(e => s.ObservedDamageText = e.Value?.ToString() ?? "")" />
                            <button class="btn btn-outline-primary" @onclick="EstimateEvs">推定</button>
                        </div>
                        @if (!string.IsNullOrEmpty(s.EstimateText))
                        {
                            <div class="alert alert-light border chat-output mt-2 mb-0">@s.EstimateText</div>
                        }
                    </div>
                </details>
            }
        </div>
        </div>
    </div>
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public BattleFormat Format { get; set; }
        public PokemonBuild? Attacker { get; set; }
        public PokemonBuild? Defender { get; set; }
        public Move? Move { get; set; }
        public bool IsCritical { get; set; }
        /// <summary>Z 技として使う（第 7 世代）。</summary>
        public bool IsZMove { get; set; }
        public bool Reflect { get; set; }
        public bool LightScreen { get; set; }
        public Weather Weather { get; set; }
        public Terrain Terrain { get; set; }
        public string ObservedDamageText { get; set; } = "";
        public string EstimateText { get; set; } = "";
        public DamageResult? Result { get; set; }
        public DamageRequest? LastRequest { get; set; }
    }

    private State s = new();
    private DataSetInfo? dataSet;
    private PokemonDataSet? data;
    private UsageData? usage;
    private string loadError = "";
    private string rosterError = "";
    private string errorMessage = "";

    private IReadOnlyList<Pokemon> pokemonList = Array.Empty<Pokemon>();
    private IReadOnlyList<Move> attackerMoves = Array.Empty<Move>();
    private IReadOnlyList<Item> attackerItems = Array.Empty<Item>();
    private IReadOnlyList<Item> defenderItems = Array.Empty<Item>();
    private IReadOnlyList<RosterChoiceGroup> rosterGroups = Array.Empty<RosterChoiceGroup>();

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>("damage");
        await LoadDataSet();
        // ポケモン一覧から開いたとき（?attacker=ID / ?defender=ID）は、そのポケモンを入れてから URL を戻す
        if (AttackerQuery is > 0 || DefenderQuery is > 0)
        {
            if (AttackerQuery is > 0 and var a) OnAttackerChanged(a.ToString());
            if (DefenderQuery is > 0 and var d) OnDefenderChanged(d.ToString());
            Nav.NavigateTo("damage-calculator", replace: true);
        }
    }

    [SupplyParameterFromQuery(Name = "attacker")] public int? AttackerQuery { get; set; }
    [SupplyParameterFromQuery(Name = "defender")] public int? DefenderQuery { get; set; }

    protected override Task OnAppChangedAsync() => LoadDataSet();

    private static int ParseId(object? value) => int.TryParse(value?.ToString(), out var id) ? id : 0;
    private static T ParseEnum<T>(object? value, T fallback) where T : struct => Enum.TryParse<T>(value?.ToString(), out var v) ? v : fallback;

    private async Task LoadDataSet()
    {
        try
        {
            loadError = "";
            dataSet = App.DataSet;
            data = await Catalog.GetDataSetAsync(App.DataSetKey);
            usage = await data.GetUsageAsync(App.Format);
            (rosterGroups, rosterError) = await RosterReading.ChoiceGroupsAsync(Repo, App.DataSetKey, data);
            pokemonList = usage.IsEmpty
                ? data.Pokemon
                : data.Pokemon.OrderBy(p => usage.RankOf(p.Id)).ToList();
            if (s.DataSetKey != App.DataSetKey)
            {
                s.DataSetKey = App.DataSetKey;
                s.Attacker = null;
                s.Defender = null;
                s.Move = null;
                s.Result = null;
                s.LastRequest = null;
                s.EstimateText = "";
            }
            s.Format = App.Format;
            // そのゲームに無いフィールド（第 5 世代まで・サイコフィールドは第 6 世代まで）は外す
            if (dataSet is { HasTerrain: false } || s.Terrain == Terrain.Psychic && dataSet is { HasPsychicTerrain: false }) s.Terrain = Terrain.None;
            RefreshAttackerLists();
            RefreshDefenderLists();
        }
        catch (Exception ex)
        {
            loadError = $"データの読み込みに失敗しました: {ex.Message}";
        }
    }

    private RenderFragment PokemonRow(Pokemon p) => __builder =>
    {
        <PokemonIcon Pokemon="p" Small="true" />
        <span>@p.Name@(p.IsProvisional ? "※未収録" : "")</span>
        <PokemonTypes Pokemon="p" Small="true" />
        <span class="text-muted ms-auto small">@FormatStats(p.BaseStats)</span>
    };

    private static string CategoryText(Move m) => m.Category switch
    {
        MoveCategory.Physical => "物理",
        MoveCategory.Special => "特殊",
        _ => "変化",
    };

    private PokemonBuild NewBuild(Pokemon pokemon, bool isAttacker)
    {
        var side = isAttacker ? AbilityEffects.Side.Attacker : AbilityEffects.Side.Defender;
        var build = new PokemonBuild(pokemon, dataSet?.EvSystem ?? EvSystem.Classic)
        {
            Nature = usage?.TopNature(pokemon.Id) ?? NeutralNature(),
            Item = usage?.TopItem(pokemon.Id),
            // 天候・フィールドを作る特性やダメージが上がる特性を優先（場の状態と技の並び順に反映される）
            Ability = usage?.DefaultAbility(pokemon, side) ?? (data is null ? null : AbilityEffects.ChooseDefault(data.AbilitiesOf(pokemon), null, side)),
        };
        ApplyFixedChoices(build);
        return build;
    }

    /// <summary>メガシンカ後はメガストーン固定、特性が 1 つなら固定。</summary>
    private void ApplyFixedChoices(PokemonBuild build)
    {
        if (data is null) return;
        if (build.Pokemon.IsMega)
            build.Item = data.FindItem(build.Pokemon.MegaStoneId!.Value) ?? build.Item;
        var abilities = data.AbilitiesOf(build.Pokemon);
        if (abilities.Count == 1) build.Ability = abilities[0];
        else if (build.Ability is not null && !abilities.Contains(build.Ability)) build.Ability = abilities.FirstOrDefault();
    }

    private void OnAttackerChanged(string value)
    {
        var pokemon = data?.FindPokemon(ParseId(value));
        if (pokemon is null)
        {
            s.Attacker = null;
            attackerMoves = Array.Empty<Move>();
            return;
        }
        s.Attacker = NewBuild(pokemon, true);
        ApplyFieldFromAbility(s.Attacker);
        RefreshAttackerLists();
        s.Move = DefaultMove(pokemon.Id);
        ApplyDefaultEvs(s.Attacker, s.Move, true);
        if (s.Defender is not null) ApplyDefaultEvs(s.Defender, s.Move, false);
    }

    private void OnMoveChanged(string value)
    {
        s.Move = data?.FindMove(ParseId(value));
        if (s.Attacker is not null) ApplyDefaultEvs(s.Attacker, s.Move, true);
        if (s.Defender is not null) ApplyDefaultEvs(s.Defender, s.Move, false);
    }

    private void OnDefenderChanged(string value)
    {
        var pokemon = data?.FindPokemon(ParseId(value));
        if (pokemon is null)
        {
            s.Defender = null;
            return;
        }
        s.Defender = NewBuild(pokemon, false);
        ApplyFieldFromAbility(s.Defender);
        RefreshDefenderLists();
        ApplyDefaultEvs(s.Defender, s.Move, false);
    }

    /// <summary>登録済みの構成（チームのメンバーならチームで持たせた持ち物つき）を、その側の入力欄に写す。登録データ自体は変わらない。</summary>
    private void PickFromRoster(RosterChoice choice, bool isAttacker)
    {
        if (data is null) return;
        var build = RosterRepository.ToBuild(choice.Entry, data, choice.Item);
        if (build is null) return;
        ApplyFixedChoices(build);
        ApplyFieldFromAbility(build);
        if (isAttacker)
        {
            s.Attacker = build;
            RefreshAttackerLists();
            s.Move = DefaultMove(build.Pokemon.Id);
        }
        else
        {
            s.Defender = build;
            RefreshDefenderLists();
        }
    }

    private void EstimateEvs()
    {
        s.EstimateText = "";
        if (data is null || s.Attacker is null || s.Defender is null || s.Move is null) { s.EstimateText = "ポケモンと技を選択してください。"; return; }
        var text = s.ObservedDamageText.Trim();
        var asPercent = text.EndsWith('%') || text.EndsWith('％');
        if (!double.TryParse(text.TrimEnd('%', '％'), out var observed) || observed <= 0) { s.EstimateText = "受けたダメージを 93 または 45% の形で入力してください。"; return; }
        var request = new DamageRequest
        {
            Attacker = s.Attacker,
            Move = s.Move,
            Defender = s.Defender.Clone(),
            Format = App.Format,
            IsCritical = s.IsCritical,
            IsZMove = UseZMove,
            Weather = s.Weather,
            Terrain = s.Terrain,
            Reflect = s.Reflect,
            LightScreen = s.LightScreen,
        };
        request.Defender.Item = null;
        var estimate = new EvEstimator(data.TypeChart, data.Info.Generation).Run(request, observed, asPercent);
        s.EstimateText = EvEstimator.Format(estimate, s.Defender.Pokemon, s.Move, data.Info.EvSystem) + "（相手は持ち物なし想定）";
    }

    /// <summary>特性が場に出す天候・フィールドを、まだ選んでいなければ既定値にする（ひでり・サイコメイカーなど）。</summary>
    private void ApplyFieldFromAbility(PokemonBuild build)
    {
        var id = build.Ability?.Identifier;
        if (s.Weather == Weather.None && FaraPokemonBattleAssistant.Core.Battle.FieldEffects.WeatherFromAbility(id) is { } w) s.Weather = w;
        if (s.Terrain == Terrain.None && FaraPokemonBattleAssistant.Core.Battle.FieldEffects.TerrainFromAbility(id) is { } t) s.Terrain = t;
    }

    private void SetAbility(PokemonBuild build, int abilityId)
    {
        build.Ability = data?.FindAbility(abilityId);
        ApplyFieldFromAbility(build);
    }

    private Nature? NeutralNature() => data is null ? null : NatureSelection.Neutral(data.Natures);

    /// <summary>技に合わせて、攻撃側は A か C、防御側は H に全振り。既に振ってある側はそのまま。</summary>
    private static void ApplyDefaultEvs(PokemonBuild build, Move? move, bool isAttacker)
    {
        var full = EvRules.Full(build.EvSystem);
        if (isAttacker)
        {
            if (move is null) return;
            var stat = move.AttackStatUsed;
            if (build.EVs[stat] == full) return;
            if (build.EVs.Total == 0 || build.EVs[Stat.Attack] == full || build.EVs[Stat.SpAttack] == full)
            {
                build.EVs = new StatSet();
                build.EVs[stat] = full;
            }
        }
        else if (build.EVs.Total == 0)
        {
            build.EVs[Stat.HP] = full;
        }
    }

    private IReadOnlyList<Move> sortedMoves = Array.Empty<Move>();
    private string sortedMovesKey = "";

    /// <summary>
    /// 技の候補。いまの攻撃側・防御側・天候・フィールド・壁で与える最大ダメージの多い順（火力の高い順）。同じなら使用率順。
    /// 描画のたびに全部の技を計算しないよう、条件が変わったときだけ並べ直す。
    /// </summary>
    private IReadOnlyList<Move> MoveChoices
    {
        get
        {
            if (data is null || s.Attacker is null) return attackerMoves;
            var defender = s.Defender ?? FaraPokemonBattleAssistant.Core.Battle.DamageCalculator.NeutralDefender(s.Attacker.EvSystem);
            var key = string.Join(";", BuildKey(s.Attacker), BuildKey(defender), s.Weather, s.Terrain, App.Format, s.IsCritical, s.Reflect, s.LightScreen, UseZMove,
                attackerMoves.Count, attackerMoves.FirstOrDefault()?.Id);
            if (key != sortedMovesKey)
            {
                sortedMovesKey = key;
                sortedMoves = new FaraPokemonBattleAssistant.Core.Battle.DamageCalculator(data.TypeChart, data.Info.Generation).SortByDamage(new DamageRequest
                {
                    Attacker = s.Attacker, Move = attackerMoves.FirstOrDefault() ?? new Move(), Defender = defender,
                    Format = App.Format, IsCritical = s.IsCritical, Weather = s.Weather, Terrain = s.Terrain, Reflect = s.Reflect, LightScreen = s.LightScreen, IsZMove = UseZMove,
                }, attackerMoves);
            }
            return sortedMoves;
        }
    }

    /// <summary>ダメージに関わる構成の要約（並べ直すかどうかの判定用）。</summary>
    private static string BuildKey(PokemonBuild b)
    {
        var stats = StatCalculator.CalculateAll(b);
        return string.Join(",", b.Pokemon.Id, b.Level, stats.HP, stats.Attack, stats.Defense, stats.SpAttack, stats.SpDefense, stats.Speed,
            b.Boosts.Attack, b.Boosts.Defense, b.Boosts.SpAttack, b.Boosts.SpDefense, b.Ability?.Identifier, b.Item?.Id,
            b.TeraType, b.Status, b.IsDynamax, b.CurrentHp);
    }

    // 既定の技は使用率 1 位（代用した使用率でもよい）。努力値の既定もこの技に合わせるので、並び順の先頭とは限らない
    private Move? DefaultMove(int pokemonId) =>
        usage?.TopMove(pokemonId) ?? MoveChoices.FirstOrDefault(m => m.IsDamaging);

    private void RefreshAttackerLists()
    {
        if (data is null || s.Attacker is null) { attackerMoves = Array.Empty<Move>(); return; }
        var moves = data.LearnableMoves(s.Attacker.Pokemon.Id).Where(m => m.Category != MoveCategory.Status).ToList();
        attackerMoves = usage is null ? moves : usage.SortByUsage(moves, m => m.Id, usage.MoveOrder(s.Attacker.Pokemon.Id));
        attackerItems = ItemChoices(s.Attacker, i => i.IsOffensive);
    }

    private void RefreshDefenderLists()
    {
        if (data is null || s.Defender is null) return;
        defenderItems = ItemChoices(s.Defender, i => i.IsDefensive);
    }

    /// <summary>そのゲームで選べるすべての持ち物。その側に関係する持ち物を先に（使用率順）、残りをその後ろに並べる。</summary>
    private IReadOnlyList<Item> ItemChoices(PokemonBuild build, Func<Item, bool> relevant)
    {
        var all = data!.Items.Where(i => !i.IsMegaStone).ToList();
        if (build.Item is not null && !all.Contains(build.Item)) all.Insert(0, build.Item);
        var first = all.Where(relevant).ToList();
        var rest = all.Where(i => !first.Contains(i));
        var ordered = usage is null ? first : usage.SortByUsage(first, i => i.Id, usage.ItemOrder(build.Pokemon.Id));
        return ordered.Concat(rest).ToList();
    }

    private IReadOnlyList<Stat> EvStats(bool isAttacker)
    {
        var move = s.Move;
        if (isAttacker)
            return move is null || move.IsFixedDamage ? Array.Empty<Stat>() : new[] { move.AttackStatUsed };
        return move is null || move.IsFixedDamage ? new[] { Stat.HP } : new[] { Stat.HP, move.DefenseStatUsed };
    }

    private IReadOnlyList<Stat> BoostStats(bool isAttacker)
    {
        var move = s.Move;
        if (move is null || move.IsFixedDamage) return Array.Empty<Stat>();
        return new[] { isAttacker ? move.AttackStatUsed : move.DefenseStatUsed };
    }

