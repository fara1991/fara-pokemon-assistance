                @if (abilities.Count <= 1)
                {
                    <FixedField Value="@build.Ability?.Name" Reason="@FixedField.SingleAbilityReason" />
                }
                else
                {
                    <select class="form-select" value="@(build.Ability?.Id.ToString() ?? "")" @onchange="@(e => SetAbility(build, ParseId(e.Value)))">
                        @foreach (var a in abilities)
                        {
                            <option value="@a.Id">@a.Name</option>
                        }
                    </select>
                }
            </div>
            @if (dataSet!.HasTerastal)
            {
                <div class="form-group mb-3">
                    <label>テラスタル <Help Title="テラスタル">テラスタル後のタイプ。攻撃側はテラスタイプと同じ技が 1.5 倍（元のタイプとも一致なら 2 倍）、防御側は受けるタイプがテラスタイプだけになります。</Help></label>
                    <select class="form-select" value="@(build.TeraType ?? "")" @onchange="@(e => build.TeraType = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                        <option value="">なし</option>
                        @foreach (var t in TypeNames.All)
                        {
                            <option value="@t">@TypeNames.ToJapanese(t)</option>
                        }
                    </select>
                </div>
            }
            @if (dataSet.HasDynamax)
            {
                <div class="form-check form-switch build-check">
                    <input class="form-check-input" type="checkbox" role="switch" id="dmax-@side" checked="@build.IsDynamax" @onchange="@(e => build.IsDynamax = e.Value is true)" />
                    <label class="form-check-label" for="dmax-@side">ダイマックス <Help Title="ダイマックス">HP が 2 倍になり、技はダイマックス技の威力（威力 90〜150、かくとう・どくは 70〜100）になります。</Help></label>
                </div>
            }
            @if (evStats.Count > 0 && !unknown)
            {
                <div class="form-group @(evStats.Count > 1 ? "build-wide" : "")">
                    <label>@EvRules.Label(build.EvSystem) <Help Title="@EvRules.Label(build.EvSystem)">@(build.EvSystem == EvSystem.Points ? "チャンピオンズは 1 ポイントで実数値が 1 上がります（各 0〜32、合計 66）。" : "各 0〜252、合計 510。4 ごとに実数値が 1 上がります。")選んだ技に関係する能力だけを表示しています。ボタンで 0 と最大を入れられます（合計の上限を超えるときは、入る分だけ）。</Help></label>
                    <div class="ev-grid">
                        @foreach (var stat in evStats)
                        {
                            <div class="ev-cell">
                                <span class="ev-label">@StatNames.Letter(stat)（@StatNames.Japanese(stat)）</span>
                                <input type="number" class="form-control form-control-sm" min="0" max="@EvRules.MaxPerStat(build.EvSystem)" step="@EvRules.Step(build.EvSystem)"
                                       value="@build.EVs[stat]" @onchange="@(e => build.EVs[stat] = ClampEv(e.Value, build.EvSystem))" />
                                <div class="ev-buttons">
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => build.EVs[stat] = 0">0</button>
                                    @* 合計の上限を超えるときは、入る分だけ振る *@
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => build.EVs[stat] = EvRules.MaxAllowed(build.EvSystem, build.EVs, stat)">@EvRules.MaxPerStat(build.EvSystem)</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (boostStats.Count > 0)
            {
                <div class="form-group mb-2">
                    <label>ランク補正 <Help Title="ランク補正">つるぎのまい等で変化した能力ランク（-6〜+6）。+1 で 1.5 倍、+2 で 2 倍、-1 で 2/3 倍です。</Help></label>
                    <div class="ev-grid">
                        @foreach (var stat in boostStats)
                        {
                            <div class="ev-cell">
                                <span class="ev-label">@StatNames.Letter(stat)（@StatNames.Japanese(stat)）</span>
                                <select class="form-select form-select-sm" value="@build.Boosts[stat]" @onchange="@(e => build.Boosts[stat] = ParseBoost(e.Value))">
                                    @for (var b = 6; b >= -6; b--)
                                    {
                                        <option value="@b">@(b > 0 ? "+" + b : b.ToString())</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="form-group mb-2">
                <label>状態異常 <Help Title="状態異常">やけどは物理技のダメージ 0.5 倍（こんじょう・からげんきは除く）。どく・もうどくは毎ターンの定数ダメージを確定数に含めます。まひはすばやさ 0.5 倍です。</Help></label>
                <select class="form-select form-select-sm" value="@build.Status" @onchange="@(e => build.Status = ParseEnum(e.Value, StatusCondition.None))">
                    @foreach (var st in Enum.GetValues<StatusCondition>())
                    {
                        <option value="@st">@StatusNames.Japanese(st)</option>
                    }
                </select>
            </div>
            <div class="form-group build-wide">
                <label>残り HP <Help Title="残り HP">@(isAttacker ? "もうか・しんりょく・げきりゅう・むしのしらせは HP が 1/3 以下で対応タイプの技が 1.5 倍になります。" : "確定数を今の HP から数えます。マルチスケイル・ファントムガードは HP 満タンのときだけ効きます。")スライダーと % は割合、右の欄は実数値（例: 133 / 135）で指定できます。どちらを変えても、もう一方に反映されます。</Help></label>
                <div class="hp-editor">
                    <input type="range" class="form-range hp-range" min="1" max="100" value="@build.HpPercent" style="--hp:@(build.HpPercent)%" data-level="@(build.HpPercent > 50 ? "high" : build.HpPercent > 20 ? "mid" : "low")" aria-label="残り HP（%）" @oninput="@(e => build.HpPercent = Math.Clamp(ParseId(e.Value), 1, 100))" />
                    <div class="input-group input-group-sm hp-input">
                        <input type="number" class="form-control" min="1" max="100" value="@build.HpPercent" aria-label="残り HP（%）" @onchange="@(e => build.HpPercent = Math.Clamp(ParseId(e.Value), 1, 100))" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="input-group input-group-sm hp-input">
                        <input type="number" class="form-control" min="1" max="@build.MaxHp" value="@build.CurrentHp" aria-label="残り HP（実数値）" @onchange="@(e => build.CurrentHp = Math.Clamp(ParseId(e.Value), 1, build.MaxHp))" />
                        <span class="input-group-text">/ @build.MaxHp</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="stats-summary">
            <div>
                実数値：@foreach (var (stat, i) in Enum.GetValues<Stat>().Select((st, idx) => (st, idx)))
                {
                    if (i > 0) { <span>-</span> }
                    <span class="@StatColor(build, stat)">@(StatNames.Letter(stat))@(stats[stat])</span>
                }
            </div>
        </div>
    };

    /// <summary>計算結果の中身（結果カードと、狭い画面の下のバーで使う）。</summary>
    private RenderFragment RenderResultBody(DamageResult result, DamageRequest lastRequest, DamageResult? crit, DamageRequest? critRequest) => __builder =>
    {
        @* 入力欄に画像が出ているので、ここは 1 行の文字だけにする *@
        <p class="result-matchup mb-1">
            <strong>@lastRequest.Attacker.Pokemon.Name</strong>
            <span class="mx-1"><TypeIcon Type="@result.MoveType" Small="true" /> @lastRequest.Move.Name@(result.Converted is { } conv ? $"（{conv.Name}）" : "") →</span>
            <strong data-swap="@lastRequest.Defender.Pokemon.Name">@lastRequest.Defender.Pokemon.Name</strong>
            @if (result.TypeEffectiveness != 1.0) { <span class="ms-1 result-effect">（@EffectLabel(result)）</span> }
        </p>
        @* 数字は data-count の span に分ける（見た目の文字は RangeText と同じ。入力を変えると前の結果から数え上げる） *@
        @* 急所なし・ありを並べて出す。上が通常、下が急所 *@
        <p class="result-main result-main-row mb-1">
            <span class="result-kind">通常</span>
            <strong><span data-count="@Inv(result.MinPercent)" data-count-dec="1">@($"{result.MinPercent:0.0}")</span>〜<span data-count="@Inv(result.MaxPercent)" data-count-dec="1">@($"{result.MaxPercent:0.0}")</span>% (<span data-count="@result.MinDamage">@result.MinDamage</span>〜<span data-count="@result.MaxDamage">@result.MaxDamage</span>)</strong>
            <span class="ms-2 badge @(result.KnockOut.IsGuaranteed ? "bg-danger" : "bg-warning text-dark")" data-pop="@result.KnockOut">@result.KnockOut</span>
        </p>
        @if (crit is not null)
        {
            <p class="result-main result-main-row result-main-crit mb-2">
                <span class="result-kind">急所</span>
                <strong>@($"{crit.MinPercent:0.0}〜{crit.MaxPercent:0.0}% ({crit.MinDamage}〜{crit.MaxDamage})")</strong>
                <span class="ms-2 badge @(crit.KnockOut.IsGuaranteed ? "bg-danger" : "bg-warning text-dark")">@crit.KnockOut</span>
            </p>
        }
        @if (result.ParentalBond && result.HitRolls is { Count: 2 } hr)
        {
            <p class="mb-1 small">おやこあい: 1回目 @(hr[0][0])〜@(hr[0][^1]) ・ 2回目 @(hr[1][0])〜@(hr[1][^1])（急所なし）</p>
        }
        @foreach (var line in MultiHitLines(lastRequest, critRequest))
        {
            <p class="mb-1 small">@line</p>
        }
        @RenderHpBar(result, lastRequest)
        @if (lastRequest.Attacker.Pokemon.IsProvisional || lastRequest.Defender.Pokemon.IsProvisional)
        {
            <p class="mb-1 text-warning">※ 「未収録」のポケモンは @data!.Info.Name に正式収録されていないため、第9世代のデータで計算しています。</p>
        }
        <hr />
        <p class="mb-1 text-muted small">チャットでの表示</p>
        <div class="alert alert-light border chat-output mb-0">@(crit is null ? DamageCommand.Format(lastRequest, result, data!.Info) : DamageCommand.FormatBoth(lastRequest, result, crit, data!.Info))</div>
    };

    /// <summary>2〜5 回当たる連続技の回数表示（ダメージは 1 回あたり。急所は 1 回ごとに判定されるため）。</summary>
    private static IEnumerable<string> MultiHitLines(DamageRequest request, DamageRequest? critRequest)
    {
        if (!MoveEffects.HitsTwoToFive(request.Move)) yield break;
        yield return request.Attacker.Ability?.Identifier == "skill-link"
            ? "1回あたりのダメージ。5回攻撃（スキルリンク） ×5"
            : "1回あたりのダメージ。2〜5回攻撃 ×2〜5";
    }

    /// <summary>いまひとつ・ばつぐん・こうかなし（倍率の数字は付けない）。</summary>
    private static string EffectLabel(DamageResult r)
    {
        var t = r.EffectivenessText;
        var i = t.IndexOf('(');
        return i > 0 ? t[..i] : t;
    }

    /// <summary>技の下に出す「タイプ一致」の補正（結果の補正の一覧にあるものを、攻撃側の技のところに出す）。</summary>
    private string StabText() =>
        s.Result?.Modifiers.FirstOrDefault(m => m.StartsWith("タイプ一致")) is { } stab ? $"　{stab}" : "";

    private static string Inv(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static string Pct(double v) => Inv(Math.Max(0, v)) + "%";

    /// <summary>HP バーの起点にする HP（防御側の今の HP。最大 HP を超えない）。</summary>
    private static int StartHp(DamageResult result, DamageRequest lastRequest) =>
        Math.Max(1, Math.Min(lastRequest.Defender.CurrentHp, result.DefenderHP));

    /// <summary>
    /// 防御側の HP バー。必ず残る HP（最大ダメージ後）・乱数で減る幅・必ず減る HP（最小ダメージ分）の 3 つを、
    /// 今の HP を起点に最大 HP に対する割合で描く。動き（前の結果からの伸び縮み・ポケモンを変えたときは満タンから）は wwwroot/js/motion.js が付ける。
    /// </summary>
    private RenderFragment RenderHpBar(DamageResult result, DamageRequest lastRequest) => __builder =>
    {
        // HP バーは急所なし（通常）だけを出す。急所は、上の「通常」「急所」の行で見る
        var maxHp = result.DefenderHP;
        var start = StartHp(result, lastRequest);
        var immune = result.TypeEffectiveness == 0.0;
        var minD = immune ? 0 : Math.Min(result.MinDamage, start);
        var maxD = immune ? 0 : Math.Min(result.MaxDamage, start);
        double P(int hp) => hp * 100.0 / maxHp;
        var keep = P(start - maxD);
        var level = keep > 50 ? "high" : keep > 20 ? "mid" : "low";
        var name = lastRequest.Defender.Pokemon.Name;
        var left = immune ? $"{start} / {maxHp}（減らない）" : $"残り {Math.Max(0, start - maxD)}〜{Math.Max(0, start - minD)} / {maxHp}";
        <div class="hp-calc" data-hp-calc data-hp-key="@name" data-hp-immune="@(immune ? "1" : "0")" data-hp-start="@Pct(P(start))">
            <div class="hp-calc-line">
                <span class="hp-calc-name" data-swap="@name"><PokemonIcon Pokemon="lastRequest.Defender.Pokemon" Small="true" /> @name の HP@(start < maxHp ? $"（現在 {start}）" : "")</span>
                <span class="hp-calc-left">@left</span>
            </div>
            <div class="hp-calc-bar" role="img" aria-label="@(immune ? $"{name} の HP は減りません" : $"{name} の HP {left}")">
                <div class="hp-calc-gone" data-hp-part="gone" style="left:@Pct(P(start - minD));width:@Pct(P(minD))"></div>
                <div class="hp-calc-fill" data-hp-part="fill" data-level="@level" style="left:0%;width:@Pct(keep)"></div>
                <div class="hp-calc-range" data-hp-part="range" style="left:@Pct(keep);width:@Pct(P(maxD - minD));@(immune ? "display:none" : "")"></div>
            </div>
            <div class="hp-calc-legend">
                <span><i class="hp-key-keep"></i>必ず残る HP</span>
                <span><i class="hp-key-gone"></i>必ず減る HP</span>
                <span><i class="hp-key-range"></i>乱数で減る幅</span>
            </div>
        </div>
    };

    private static string StatColor(PokemonBuild build, Stat stat) =>
        build.Nature?.IncreasedStat == stat ? "stat-up" : build.Nature?.DecreasedStat == stat ? "stat-down" : "";

    private static string FormatStats(StatSet st) =>
        $"H{st.HP}-A{st.Attack}-B{st.Defense}-C{st.SpAttack}-D{st.SpDefense}-S{st.Speed}";

    private static int ClampEv(object? value, EvSystem system) =>
        Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, 0, EvRules.MaxPerStat(system));

    private static int ParseBoost(object? value) =>
        Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, -6, 6);

    private string resultKey = "";
    private bool resultBarOpen;

    /// <summary>
    /// 攻撃側・防御側・技がそろっていれば、結果を出す。描画のたびに呼ぶが、計算に関わる入力
    /// （構成の実数値・ランク・特性・持ち物・状態・残り HP・テラスタル・ダイマックス、技、場の状態、形式）が変わったときだけ計算し直す。
    /// </summary>
    /// <summary>Z 技で計算するか（第 7 世代でチェックしたときだけ）。</summary>
    /// <summary>ダイマックス・Z 技がオンのときの、変換後の技名と威力（例: （ダイソウゲン 威力 140））。計算に使う威力と同じ値。</summary>
    private string MaxZText()
    {
        if (s.Attacker is null || s.Move is null || dataSet is null) return "";
        var c = ConvertedMoves.Preview(s.Move, s.Attacker, UseZMove, dataSet.Generation, s.Weather, s.Terrain);
        return c is null ? "" : $"（{c.Name} 威力 {c.Power}）";
    }

    private bool UseZMove => s.IsZMove && dataSet?.HasZMove == true;

    private void UpdateResult()
    {
        if (data is null || s.Attacker is null || s.Defender is null || s.Move is null)
        {
            resultKey = "";
            errorMessage = "";
            s.Result = null;
            s.LastRequest = null;
            s.ResultCrit = null;
            s.LastRequestCrit = null;
            return;
        }
        var key = string.Join(";", App.DataSetKey, BuildKey(s.Attacker), BuildKey(s.Defender), s.Move.Id,
            s.Weather, s.Terrain, App.Format, s.Reflect, s.LightScreen, UseZMove);
        if (key == resultKey) return;
        resultKey = key;
        Calculate();
    }

    private void Calculate()
    {
        errorMessage = "";
        s.Result = null;
        s.LastRequest = null;
        s.ResultCrit = null;
        s.LastRequestCrit = null;
        if (data is null || s.Attacker is null || s.Defender is null || s.Move is null) return;
        if (!s.Move.IsDamaging)
        {
            errorMessage = s.Move.IsFixedDamage
                ? $"{s.Move.Name} は固定ダメージ技のため計算できません。"
                : $"{s.Move.Name} はダメージを与える技ではありません。";
            return;
        }
        try
        {
            s.LastRequest = new DamageRequest
            {
                Attacker = s.Attacker,
                Move = s.Move,
                Defender = s.Defender,
                Format = App.Format,
                IsCritical = false,
                IsZMove = UseZMove,
                Weather = s.Weather,
                Terrain = s.Terrain,
                Reflect = s.Reflect,
                LightScreen = s.LightScreen,
                HitCountOverride = MoveEffects.HitsTwoToFive(s.Move) ? 1 : null,
            };
            // 急所なし・ありの両方を計算して並べて出す
            var calc = new FaraPokemonBattleAssistant.Core.Battle.DamageCalculator(data.TypeChart, data.Info.Generation);
            s.Result = calc.Calculate(s.LastRequest);
            s.LastRequestCrit = s.LastRequest.With(isCritical: true);
            s.ResultCrit = calc.Calculate(s.LastRequestCrit);
        }
        catch (Exception ex)
        {
            errorMessage = $"計算エラー: {ex.Message}";
        }
    }
}
