@page "/my-pokemon"
@inherits RosterPageBase
@using FaraPokemonBattleAssistant.Core.Roster
@inject BattleStage Stage

<PageTitle>育成ポケモン | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>育成ポケモン <Help Title="育成ポケモン">育成済みのポケモン（努力値・性格・特性）を登録します。登録したポケモンは、ダメージ計算機・素早さ比較の「登録から選ぶ」や、自分チーム・チャットコマンドで使えます。データはゲームごとに分かれています。</Help></h3>
    <p class="text-muted mb-0">登録したポケモンは、チームに入れると計算に自動で使われます（<a href="my-team">自分チーム</a>）。</p>
    <RegistrationStorageNote />
</div>

@if (dataSet is { CalcSupported: false })
{
    <CalcUnsupported DataSet="dataSet" Feature="「育成ポケモン」ページ" />
}
else if (data is not null && roster is not null && dataSet is not null)
{
    @* PC: 左（登録フォーム）と右（登録一覧）がそれぞれ画面内に収まり、中だけがスクロールする *@
    <div class="reg-layout pane-fill">
        <div class="reg-col">
            <div class="card mb-3">
                <div class="card-header"><h5>ポケモンを登録</h5></div>
                <div class="card-body">
                    <div class="form-group mb-2">
                        <label>ポケモン</label>
                        <SearchableSelect TItem="Pokemon"
                            Items="@(data.Pokemon.Where(p => !p.IsMega || p.Id == s.NewPokemon?.Id).ToList())"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.NewPokemon?.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnNewPokemonChanged"
                            Disabled="@(s.EditingId is not null)"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                        @if (s.NewPokemon is not null)
                        {
                            <div class="mt-2"><PokemonLabel Pokemon="s.NewPokemon" /></div>
                        }
                    </div>
                    <div class="form-group mb-2">
                        <label>@EvRules.Label(dataSet.EvSystem)（各 0〜@EvRules.MaxPerStat(dataSet.EvSystem)、合計 @EvRules.MaxTotal(dataSet.EvSystem)） <Help Title="@EvRules.Label(dataSet.EvSystem)">@(dataSet.EvSystem == EvSystem.Points ? "チャンピオンズは 1 ポイントで実数値が 1 上がります。各 0〜32、合計 66 まで。" : "各 0〜252、合計 510 まで。4 刻みで実数値が 1 上がります。") ボタンで 0 と最大を入れられます（合計の上限を超えるときは、入る分だけ）。</Help></label>
                        <div class="ev-grid">
                            @foreach (var stat in Enum.GetValues<Stat>())
                            {
                                <div class="ev-cell">
                                    <span class="ev-label">@StatNames.Letter(stat)</span>
                                    <input type="number" class="form-control form-control-sm" min="0" max="@EvRules.MaxPerStat(dataSet.EvSystem)" step="@EvRules.Step(dataSet.EvSystem)"
                                           value="@s.NewEvs[stat]" @onchange="@(e => s.NewEvs[stat] = Clamp(e.Value, EvRules.MaxPerStat(dataSet.EvSystem)))" />
                                    <div class="ev-buttons">
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => s.NewEvs[stat] = 0">0</button>
                                        @* 合計の上限を超えるときは、入る分だけ振る *@
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => s.NewEvs[stat] = EvRules.MaxAllowed(dataSet.EvSystem, s.NewEvs, stat)">@EvRules.MaxPerStat(dataSet.EvSystem)</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="small @(s.NewEvs.Total > EvRules.MaxTotal(dataSet.EvSystem) ? "text-danger" : "text-muted")">合計 @s.NewEvs.Total / @EvRules.MaxTotal(dataSet.EvSystem)</div>
                    </div>
                    <div class="form-group mb-2">
                        <label>性格 <Help Title="性格">能力ごとの ▲（上昇）・▼（下降）を押して選びます。もう一度押すと外れます。能力を選ぶと性格が決まります（片方だけ押したときは、もう片方を A・C の振り方に合わせて補います）。名前で探すこともできます。</Help></label>
                        <NaturePicker Natures="data.Natures" Value="s.NewNature" ValueChanged="@(n => s.NewNature = n)"
                            Physical="@(s.NewEvs.Attack >= s.NewEvs.SpAttack)" />
                    </div>
                    <div class="form-group mb-3">
                        <label>特性</label>
                        @if (s.NewPokemon is not null && data.AbilitiesOf(s.NewPokemon).Count == 1)
                        {
                            <FixedField Value="@s.NewAbility?.Name" Ability="s.NewAbility" Reason="@FixedField.SingleAbilityReason" />
                        }
                        else
                        {
                            <div class="with-desc">
                                <SearchableSelect TItem="Ability" Items="@(s.NewPokemon is null ? Array.Empty<Ability>() : data.AbilitiesOf(s.NewPokemon))" DisplayText="@(a => a.Name)" ValueSelector="@(a => a.Id.ToString())"
                                    SelectedValue="@(s.NewAbility?.Id.ToString() ?? "")" SelectedValueChanged="@(v => { if (v.Length > 0) OnAbilityChanged(data.FindAbility(ParseId(v))); })"
                                    Disabled="@(s.NewPokemon is null)" Dropdown="true" Placeholder="特性名を入力..." />
                                <DescHelp Name="@(s.NewAbility?.Name)" Description="@(s.NewAbility?.Description)" />
                            </div>
                        }
                    </div>
                    <div class="form-group mb-3">
                        <label>技（4 つまで） <Help Title="技">登録するポケモンが覚える技から、4 つまで選べます（選ばなくても登録できます）。同じ技は 1 つだけです。候補は、いま入力している努力値・性格・特性で、タイプなし・種族値すべて 100 の相手に与える最大ダメージの多い順（火力の高い順）に並びます。特性が天候・フィールドを出すとき（サイコメイカー・ひでりなど）は、その状態で計算します。同じダメージなら、技の並び順どおりです（みらいよちなど、遅れて当たる技は同じダメージのとき後ろに並びます）。左のメニューの「対戦画面で表示」をオンにすると、選んだ技が威力つきで対戦画面の右下に出ます。</Help></label>
                        <div class="move-pick-grid">
                            @for (var i = 0; i < RegisteredPokemon.MaxMoves; i++)
                            {
                                var slot = i;
                                <SearchableSelect TItem="Move"
                                    Items="MoveChoices(slot)"
                                    DisplayText="@(m => m.Name)"
                                    ValueSelector="@(m => m.Id.ToString())"
                                    SelectedValue="@(s.NewMoves[slot]?.Id.ToString() ?? "")"
                                    SelectedValueChanged="@(v => OnMoveChanged(slot, v))"
                                    Disabled="@(s.NewPokemon is null)"
                                    Dropdown="true"
                                    EmptyOption="なし"
                                    Placeholder="@($"技 {slot + 1}")">
                                    <ItemTemplate Context="m"><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span><span class="text-muted ms-auto">@MoveInfo(m)</span></ItemTemplate>
                                </SearchableSelect>
                            }
                        </div>
                        @if (s.NewMoves.Any(m => m is not null))
                        {
                            @* 選んだ技の分類と威力 *@
                            <ul class="move-pick-summary small mt-2 mb-0">
                                @foreach (var m in s.NewMoves.OfType<Move>())
                                {
                                    <li><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span><span class="text-muted ms-auto">@MoveInfo(m)</span></li>
                                }
                            </ul>
                        }
                    </div>
                    @if (s.NewPokemon is not null)
                    {
                        <div class="stats-summary mb-2">実数値：@FormatStats(StatCalculator.CalculateAll(NewBuild()))</div>
                    }
                    @* 登録 = 新しく登録する。更新・取り消し = 登録一覧で選んだポケモンを編集しているとき（登録は押せない） *@
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-primary" @onclick="AddPokemonAsync" disabled="@(s.EditingId is not null || s.NewPokemon is null || s.NewNature is null)">登録</button>
                        <button class="btn btn-success" @onclick="UpdatePokemonAsync" disabled="@(s.EditingId is null || s.NewNature is null)">更新</button>
                        <button class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@(s.EditingId is null)">取り消し</button>
                        @if (s.EditingId is { } editing)
                        {
                            <span class="small text-muted">#@editing を編集中</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="reg-col">
            <div class="card mb-3">
                <div class="card-header"><h5>登録一覧（@roster.Pokemon.Count 体）</h5></div>
                <div class="card-body p-0">
                    @if (roster.Pokemon.Count == 0)
                    {
                        <Notice Empty="true" Class="m-3">まだ登録がありません。</Notice>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush reg-list">
                        @foreach (var e in roster.Pokemon)
                        {
                            var build = RosterRepository.ToBuild(e, data);
                            <li class="list-group-item reg-item @(s.EditingId == e.Id ? "reg-selected" : "")" role="button" tabindex="0" aria-pressed="@(s.EditingId == e.Id ? "true" : "false")"
                                @onclick="() => SelectEntry(e)" @onkeydown="@(k => { if (k.Key is "Enter" or " ") SelectEntry(e); })">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <span class="text-muted small me-1">#@e.Id</span><PokemonLabel Pokemon="data.FindPokemon(e.PokemonId)" Small="true" />
                                        <small class="text-muted ms-1">@(build?.Ability?.Name)</small>
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm flex-shrink-0" @onclick="() => RemovePokemonAsync(e.Id)" @onclick:stopPropagation="true">削除</button>
                                </div>
                                <div class="small mt-1">@NatureText(e.Nature)　@EvRules.Label(dataSet.EvSystem) @e.EVs.ToShortString()</div>
                                @if (e.MoveIds.Count > 0)
                                {
                                    <div class="small reg-moves">技：@foreach (var mid in e.MoveIds)
                                    {
                                        if (data.FindMove(mid) is { } mv) { <span class="reg-move"><TypeIcon Type="@mv.Type" Small="true" />@mv.Name</span> }
                                    }</div>
                                }
                                <div class="small text-muted">実数値 @(build is null ? "-" : FormatStats(StatCalculator.CalculateAll(build)))</div>
                            </li>
                        }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public Pokemon? NewPokemon { get; set; }
        public StatSet NewEvs { get; set; } = new();
        public Nature? NewNature { get; set; }
        public Ability? NewAbility { get; set; }
        /// <summary>選んでいる技（4 つの枠。空の枠は null）。</summary>
        public Move?[] NewMoves { get; set; } = new Move?[RegisteredPokemon.MaxMoves];
        /// <summary>技の並び順（火力）と、対戦画面の背景に使う天候・フィールド。</summary>
        /// <summary>登録一覧で選んで、編集しているポケモンの登録 ID（null なら新しく登録する）。</summary>
        public int? EditingId { get; set; }
        public Weather NewWeather { get; set; }
        public Terrain NewTerrain { get; set; }
    }

    private State s = new();

    protected override string StateKey => "roster";

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>(StateKey);
        await base.OnAppReadyAsync();
    }

    protected override void OnDataLoaded()
    {
        if (data is null) return;
        if (s.DataSetKey != App.DataSetKey)
        {
            s.DataSetKey = App.DataSetKey;
            s.NewPokemon = null;
            s.NewEvs = new StatSet();
            s.NewNature = data.FindNature("まじめ");
            s.NewAbility = null;
            s.NewMoves = new Move?[RegisteredPokemon.MaxMoves];
            s.NewWeather = Weather.None;
            s.NewTerrain = Terrain.None;
            s.EditingId = null;
        }
        s.NewNature ??= data.FindNature("まじめ");
    }

    // 登録するポケモンを、背景のバトルフィールドの自分側（左下）に立たせ、選んだ技を「対戦画面で表示」に出す。
    // 登録の入力は、ダメージ計算機・素早さ比較で選んだポケモンには入れない（ShowOnly）
    protected override void OnAfterRender(bool firstRender)
    {
        Stage.ShowOnly(App.DataSetKey, s.NewPokemon, null);
        Stage.SetScene(this, BuildScene());
        Stage.SetConditions(this, s.NewWeather, s.NewTerrain);
    }

    public override void Dispose()
    {
        Stage.ClearScene(this);
        base.Dispose();
    }

    private BattleScene? BuildScene()
    {
        if (dataSet is null or { CalcSupported: false }) return null;   // 読み込み前・未対応のゲームは、対戦画面にしない
        if (s.NewPokemon is null) return new WaitingScene("登録するポケモンを選ぶと、ここに出ます。");
        var moves = s.NewMoves.OfType<Move>().Select(m => new MoveSlot(m.Name, m.Type, m.Power)).ToList();
        return new RegisterScene(s.NewPokemon.Name, StatCalculator.CalculateAll(NewBuild()).HP, moves);
    }

    private static readonly Pokemon NeutralTarget = new() { Name = "（相手なし）" };

    /// <summary>
    /// 分類と威力。特性が天候・フィールドを出すとき（サイコメイカー・ひでりなど）に、その補正がかかる技は
    /// 「威力 補正前（補正後）」で出す（例: 80（120））。
    /// </summary>
    private string MoveInfo(Move m)
    {
        var category = m.Category switch { MoveCategory.Physical => "物理", MoveCategory.Special => "特殊", _ => "変化" };
        if (m.Power <= 0) return $"{category} -";
        var power = m.Power.ToString();
        var id = s.NewAbility?.Identifier;
        var makesField = FaraPokemonBattleAssistant.Core.Battle.FieldEffects.WeatherFromAbility(id) is not null
            || FaraPokemonBattleAssistant.Core.Battle.FieldEffects.TerrainFromAbility(id) is not null;
        if (makesField && s.NewPokemon is not null && dataSet is not null)
        {
            var field = FaraPokemonBattleAssistant.Core.Battle.SelfFieldEffects.For(m, m.Type, s.NewPokemon, s.NewAbility, NeutralTarget, null, dataSet.Generation);
            if (!field.Fails && Math.Abs(field.PowerFactor - 1.0) > 0.001)
                power += $"（{Math.Round(m.Power * field.PowerFactor)}）";
        }
        return $"{category} {power}";
    }

    private IReadOnlyList<Move> sortedMoves = Array.Empty<Move>();
    private string sortedMovesKey = "";

    /// <summary>
    /// 登録するポケモンが覚える技を、いま入力している構成（努力値・性格・特性）・天候・フィールドで、
    /// タイプなし・種族値すべて 100 の相手に与える最大ダメージの多い順に並べる（ダメージ計算機の技の並びと同じ計算）。
    /// 描画のたびに計算しないよう、条件が変わったときだけ並べ直す。
    /// </summary>
    private IReadOnlyList<Move> SortedLearnableMoves()
    {
        if (data is null || dataSet is null || s.NewPokemon is null) return Array.Empty<Move>();
        var learnable = data.LearnableMoves(s.NewPokemon.Id);
        var attacker = NewBuild();
        var key = string.Join(";", App.DataSetKey, s.NewPokemon.Id, FormatStats(StatCalculator.CalculateAll(attacker)), attacker.Nature?.Name, attacker.Ability?.Id,
            s.NewWeather, s.NewTerrain, App.Format, learnable.Count);
        if (key != sortedMovesKey)
        {
            sortedMovesKey = key;
            sortedMoves = new FaraPokemonBattleAssistant.Core.Battle.DamageCalculator(data.TypeChart, data.Info.Generation).SortByDamage(new DamageRequest
            {
                Attacker = attacker, Move = learnable.FirstOrDefault() ?? new Move(),
                Defender = FaraPokemonBattleAssistant.Core.Battle.DamageCalculator.NeutralDefender(attacker.EvSystem),
                Format = App.Format, Weather = s.NewWeather, Terrain = s.NewTerrain,
            }, learnable);
        }
        return sortedMoves;
    }

    private static T ParseEnum<T>(object? value, T fallback) where T : struct => Enum.TryParse<T>(value?.ToString(), out var v) ? v : fallback;

    /// <summary>その枠で選べる技。登録するポケモンが覚える技から、ほかの枠で選んだ技を除く。</summary>
    private IReadOnlyList<Move> MoveChoices(int slot)
    {
        if (data is null || s.NewPokemon is null) return Array.Empty<Move>();
        var taken = s.NewMoves.Where((m, i) => i != slot && m is not null).Select(m => m!.Id).ToHashSet();
        return SortedLearnableMoves().Where(m => !taken.Contains(m.Id)).ToList();
    }

    private void OnMoveChanged(int slot, string value) => s.NewMoves[slot] = data?.FindMove(ParseId(value));

    private static int Clamp(object? value, int max) => Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, 0, max);

    private void OnNewPokemonChanged(string value)
    {
        s.NewPokemon = data?.FindPokemon(ParseId(value));
        s.NewMoves = new Move?[RegisteredPokemon.MaxMoves];
        OnAbilityChanged(s.NewPokemon is null || data is null ? null : AbilityEffects.ChooseDefault(data.AbilitiesOf(s.NewPokemon), null));
    }

    /// <summary>
    /// 特性を変える。特性が場に出す天候・フィールド（ひでり・サイコメイカーなど）は、その状態で技の並び順（火力）を計算し、
    /// 対戦画面の背景にも出す。登録の画面には天候・フィールドの欄は無い（特性だけで決まる）。
    /// </summary>
    private void OnAbilityChanged(Ability? next)
    {
        s.NewAbility = next;
        var id = next?.Identifier;
        s.NewWeather = FaraPokemonBattleAssistant.Core.Battle.FieldEffects.WeatherFromAbility(id) ?? Weather.None;
        s.NewTerrain = FaraPokemonBattleAssistant.Core.Battle.FieldEffects.TerrainFromAbility(id) ?? Terrain.None;
    }

    private PokemonBuild NewBuild() => new(s.NewPokemon!, dataSet!.EvSystem) { EVs = s.NewEvs, Nature = s.NewNature, Ability = s.NewAbility };

    private async Task AddPokemonAsync()
    {
        if (data is null || dataSet is null || s.NewPokemon is null || s.NewNature is null) return;
        if (EvRules.Validate(dataSet.EvSystem, s.NewEvs) is { } error) { Show(error, true); return; }
        await MutateAsync(async () =>
        {
            var entry = await Repo.AddPokemonAsync(App.DataSetKey, s.NewPokemon, s.NewEvs.Clone(), s.NewNature, s.NewAbility, s.NewMoves.OfType<Move>().Select(m => m.Id).ToList());
            Show($"#{entry.Id} {entry.PokemonName} を登録しました", false);
            // 続けて別のポケモンを登録しやすいよう、選択中のポケモンと特性は空に戻す（振り分けは 0 に戻す。性格は残す）
            s.NewPokemon = null;
            OnAbilityChanged(null);
            s.NewEvs = new StatSet();
            s.NewMoves = new Move?[RegisteredPokemon.MaxMoves];
        });
    }

    /// <summary>登録一覧のポケモンを選び、そのポイント・性格・特性・技を入力欄に入れて、編集できるようにする。</summary>
    private void SelectEntry(RegisteredPokemon entry)
    {
        if (data is null) return;
        s.EditingId = entry.Id;
        s.NewPokemon = data.FindPokemon(entry.PokemonId);
        s.NewEvs = entry.EVs.Clone();
        s.NewNature = data.FindNature(entry.Nature) ?? s.NewNature;
        OnAbilityChanged(entry.AbilityId is { } aid ? data.FindAbility(aid) : null);
        var moves = new Move?[RegisteredPokemon.MaxMoves];
        for (var i = 0; i < entry.MoveIds.Count && i < moves.Length; i++) moves[i] = data.FindMove(entry.MoveIds[i]);
        s.NewMoves = moves;
    }

    private void ClearForm()
    {
        s.EditingId = null;
        s.NewPokemon = null;
        OnAbilityChanged(null);
        s.NewEvs = new StatSet();
        s.NewMoves = new Move?[RegisteredPokemon.MaxMoves];
    }

    private void CancelEdit() => ClearForm();

    private async Task UpdatePokemonAsync()
    {
        if (data is null || dataSet is null || s.EditingId is not { } id || s.NewNature is null) return;
        if (EvRules.Validate(dataSet.EvSystem, s.NewEvs) is { } error) { Show(error, true); return; }
        await MutateAsync(async () =>
        {
            var entry = await Repo.UpdatePokemonAsync(App.DataSetKey, id, s.NewEvs.Clone(), s.NewNature, s.NewAbility, s.NewMoves.OfType<Move>().Select(m => m.Id).ToList());
            if (entry is null) { Show($"#{id} は登録にありません（削除された可能性があります）", true); }
            else Show($"#{entry.Id} {entry.PokemonName} を更新しました", false);
            ClearForm();
        });
    }

    private async Task RemovePokemonAsync(int id)
    {
        if (s.EditingId == id) ClearForm();
        var before = roster?.Teams.Select(t => t.Number).ToList() ?? new List<int>();
        await MutateAsync(async () =>
        {
            await Repo.RemovePokemonAsync(App.DataSetKey, id);
            var after = (await Repo.GetAsync()).For(App.DataSetKey).Teams.Select(t => t.Number);
            var deleted = before.Except(after).ToList();
            Show($"#{id} を削除しました" + (deleted.Count > 0 ? $"（0 体になった{string.Join("・", deleted.Select(n => $"チーム{n}"))}も削除しました）" : ""), false);
        });
    }
}
