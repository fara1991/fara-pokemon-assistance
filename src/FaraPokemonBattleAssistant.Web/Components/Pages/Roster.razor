@page "/pokemon"
@inherits RosterPageBase
@using FaraPokemonBattleAssistant.Core.Roster

<PageTitle>ポケモン登録 | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>ポケモン登録 <Help Title="ポケモン登録">育成済みのポケモン（努力値・性格・特性）を登録します。登録したポケモンは、ダメージ計算機・素早さ比較の「登録から選ぶ」や、チーム登録・チャットコマンドで使えます。データはゲームごとに分かれています。</Help></h3>
    <p class="text-muted mb-0">チャットの <code>!@(App.CommandPrefix) add -p</code> と同じ内容をここで編集できます。登録したポケモンは、チームに入れると計算に自動で使われます（<a href="team">チーム登録</a>）。</p>
    <p class="text-muted small mb-0 mt-1">H: HP / A: こうげき / B: ぼうぎょ / C: とくこう / D: とくぼう / S: すばやさ（<a href="glossary">用語・略語</a>）</p>
    <RegistrationStorageNote />
</div>

@if (dataSet is { CalcSupported: false })
{
    <CalcUnsupported DataSet="dataSet" Feature="ポケモン登録" />
}
else if (data is not null && roster is not null && dataSet is not null)
{
    @* PC: 左（登録フォーム）と右（登録一覧）がそれぞれ画面内に収まり、中だけがスクロールする *@
    <div class="reg-layout pane-fill">
        <div class="reg-col">
            <div class="card mb-3">
                <div class="card-header"><h5>ポケモンを登録</h5></div>
                <div class="card-body">
                    <div class="form-group mb-2">
                        <label>ポケモン</label>
                        <SearchableSelect TItem="Pokemon"
                            Items="data.Pokemon"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.NewPokemon?.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnNewPokemonChanged"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                        @if (s.NewPokemon is not null)
                        {
                            <div class="mt-2"><PokemonLabel Pokemon="s.NewPokemon" /></div>
                        }
                    </div>
                    <div class="form-group mb-2">
                        <label>@EvRules.Label(dataSet.EvSystem)（各 0〜@EvRules.MaxPerStat(dataSet.EvSystem)、合計 @EvRules.MaxTotal(dataSet.EvSystem)） <Help Title="@EvRules.Label(dataSet.EvSystem)">@(dataSet.EvSystem == EvSystem.Points ? "チャンピオンズは 1 ポイントで実数値が 1 上がります。各 0〜32、合計 66 まで。" : "各 0〜252、合計 510 まで。4 刻みで実数値が 1 上がります。") ボタンで 0 と最大を入れられます（合計の上限を超えるときは、入る分だけ）。</Help></label>
                        <div class="ev-grid">
                            @foreach (var stat in Enum.GetValues<Stat>())
                            {
                                <div class="ev-cell">
                                    <span class="ev-label">@StatNames.Letter(stat)</span>
                                    <input type="number" class="form-control form-control-sm" min="0" max="@EvRules.MaxPerStat(dataSet.EvSystem)" step="@EvRules.Step(dataSet.EvSystem)"
                                           value="@s.NewEvs[stat]" @onchange="@(e => s.NewEvs[stat] = Clamp(e.Value, EvRules.MaxPerStat(dataSet.EvSystem)))" />
                                    <div class="ev-buttons">
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => s.NewEvs[stat] = 0">0</button>
                                        @* 合計の上限を超えるときは、入る分だけ振る *@
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => s.NewEvs[stat] = EvRules.MaxAllowed(dataSet.EvSystem, s.NewEvs, stat)">@EvRules.MaxPerStat(dataSet.EvSystem)</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="small @(s.NewEvs.Total > EvRules.MaxTotal(dataSet.EvSystem) ? "text-danger" : "text-muted")">合計 @s.NewEvs.Total / @EvRules.MaxTotal(dataSet.EvSystem)</div>
                    </div>
                    <div class="form-group mb-2">
                        <label>性格 <Help Title="性格">「上昇」「下降」のボタンで能力を選ぶと性格が決まります（片方だけ押したときは、もう片方を A・C の振り方に合わせて補います）。名前で探すこともできます。</Help></label>
                        <NaturePicker Natures="data.Natures" Value="s.NewNature" ValueChanged="@(n => s.NewNature = n)"
                            Physical="@(s.NewEvs.Attack >= s.NewEvs.SpAttack)" />
                    </div>
                    <div class="form-group mb-3">
                        <label>特性</label>
                        @if (s.NewPokemon is not null && data.AbilitiesOf(s.NewPokemon).Count == 1)
                        {
                            <FixedField Value="@s.NewAbility?.Name" Reason="@FixedField.SingleAbilityReason" />
                        }
                        else
                        {
                            <select class="form-select" value="@(s.NewAbility?.Id.ToString() ?? "")" disabled="@(s.NewPokemon is null)" @onchange="@(e => s.NewAbility = data.FindAbility(ParseId(e.Value)))">
                                @if (s.NewPokemon is not null)
                                {
                                    @foreach (var a in data.AbilitiesOf(s.NewPokemon))
                                    {
                                        <option value="@a.Id">@a.Name</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                    @if (s.NewPokemon is not null)
                    {
                        <div class="stats-summary mb-2">実数値：@FormatStats(StatCalculator.CalculateAll(NewBuild()))</div>
                    }
                    <button class="btn btn-primary" @onclick="AddPokemonAsync" disabled="@(s.NewPokemon is null || s.NewNature is null)">登録</button>
                </div>
            </div>
        </div>
        <div class="reg-col">
            <div class="card mb-3">
                <div class="card-header"><h5>登録一覧（@roster.Pokemon.Count 体）</h5></div>
                <div class="card-body p-0">
                    @if (roster.Pokemon.Count == 0)
                    {
                        <Notice Empty="true" Class="m-3">まだ登録がありません。</Notice>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush reg-list">
                        @foreach (var e in roster.Pokemon)
                        {
                            var build = RosterRepository.ToBuild(e, data);
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <span class="text-muted small me-1">#@e.Id</span><PokemonLabel Pokemon="data.FindPokemon(e.PokemonId)" Small="true" />
                                        <small class="text-muted ms-1">@(build?.Ability?.Name)</small>
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm flex-shrink-0" @onclick="() => RemovePokemonAsync(e.Id)">削除</button>
                                </div>
                                <div class="small mt-1">@NatureText(e.Nature)　@EvRules.Label(dataSet.EvSystem) @e.EVs.ToShortString()</div>
                                <div class="small text-muted">実数値 @(build is null ? "-" : FormatStats(StatCalculator.CalculateAll(build)))</div>
                            </li>
                        }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public Pokemon? NewPokemon { get; set; }
        public StatSet NewEvs { get; set; } = new();
        public Nature? NewNature { get; set; }
        public Ability? NewAbility { get; set; }
    }

    private State s = new();

    protected override string StateKey => "roster";

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>(StateKey);
        await base.OnAppReadyAsync();
    }

    protected override void OnDataLoaded()
    {
        if (data is null) return;
        if (s.DataSetKey != App.DataSetKey)
        {
            s.DataSetKey = App.DataSetKey;
            s.NewPokemon = null;
            s.NewEvs = new StatSet();
            s.NewNature = data.FindNature("まじめ");
            s.NewAbility = null;
        }
        s.NewNature ??= data.FindNature("まじめ");
    }

    private static int Clamp(object? value, int max) => Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, 0, max);

    private void OnNewPokemonChanged(string value)
    {
        s.NewPokemon = data?.FindPokemon(ParseId(value));
        s.NewAbility = s.NewPokemon is null || data is null ? null : AbilityEffects.ChooseDefault(data.AbilitiesOf(s.NewPokemon), null);
    }

    private PokemonBuild NewBuild() => new(s.NewPokemon!, dataSet!.EvSystem) { EVs = s.NewEvs, Nature = s.NewNature, Ability = s.NewAbility };

    private async Task AddPokemonAsync()
    {
        if (data is null || dataSet is null || s.NewPokemon is null || s.NewNature is null) return;
        if (EvRules.Validate(dataSet.EvSystem, s.NewEvs) is { } error) { Show(error, true); return; }
        await MutateAsync(async () =>
        {
            var entry = await Repo.AddPokemonAsync(App.DataSetKey, s.NewPokemon, s.NewEvs.Clone(), s.NewNature, s.NewAbility);
            Show($"#{entry.Id} {entry.PokemonName} を登録しました", false);
            // 続けて別のポケモンを登録しやすいよう、選択中のポケモンと特性は空に戻す（振り分けは 0 に戻す。性格は残す）
            s.NewPokemon = null;
            s.NewAbility = null;
            s.NewEvs = new StatSet();
        });
    }

    private async Task RemovePokemonAsync(int id)
    {
        var before = roster?.Teams.Select(t => t.Number).ToList() ?? new List<int>();
        await MutateAsync(async () =>
        {
            await Repo.RemovePokemonAsync(App.DataSetKey, id);
            var after = (await Repo.GetAsync()).For(App.DataSetKey).Teams.Select(t => t.Number);
            var deleted = before.Except(after).ToList();
            Show($"#{id} を削除しました" + (deleted.Count > 0 ? $"（0 体になった{string.Join("・", deleted.Select(n => $"チーム{n}"))}も削除しました）" : ""), false);
        });
    }
}
