@* 性格の選択。「上昇」「下降」のボタンを 1 回押すだけで能力を選べる。名前で探す欄も残す。
   片方だけ押したときは、もう片方を技の分類（Physical）に合わせて補う（NatureSelection 参照）。
   Partial="true" のとき（相手の性格など）は、補わない。上がる能力・下がる能力を別々に選べて、分からない方は「不明」のままにする。 *@
<div class="nature-picker">
    <SearchableSelect TItem="Nature"
        Items="Natures"
        DisplayText="@(n => n.Describe())"
        ValueSelector="@(n => n.Name)"
        SelectedValue="@(Value?.Name ?? "")"
        SelectedValueChanged="@(v => Change(Natures.FirstOrDefault(n => n.Name == v)))"
        Dropdown="true"
        Placeholder="性格名で探す..." />
    <div class="nature-rows">
    @foreach (var (label, increased) in new[] { ("上昇", true), ("下降", false) })
    {
        var current = Partial ? (increased ? Up : Down) : (increased ? Value?.IncreasedStat : Value?.DecreasedStat);
        @* 性格が未選択のときは、「なし」も押した状態にしない（補正なしの性格を選んだ状態と区別する） *@
        var noneSelected = Partial ? current is null : Value is not null && current is null;
        <div class="nature-row">
            <span class="nature-row-label @(increased ? "stat-up" : "stat-down")">@label</span>
            <div class="nature-buttons" role="group" aria-label="@(label)する能力">
                <button type="button" class="btn btn-sm @(noneSelected ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(noneSelected)"
                        @onclick="() => Press(increased, null)">@(Partial ? "不明" : "なし")</button>
                @foreach (var stat in NatureSelection.Stats)
                {
                    var st = stat;
                    @* ボタンの表記はポイント欄と同じ H/A/B/C/D/S（性格は HP に関係しないので H は無い）。名前は title・読み上げで補う *@
                    <button type="button" class="btn btn-sm @(current == st ? "btn-primary" : "btn-outline-secondary")"
                            aria-pressed="@(current == st)"
                            title="@(label)する能力: @StatNames.Japanese(st)" aria-label="@StatNames.Japanese(st)"
                            @onclick="() => Press(increased, st)">@StatNames.Letter(st)</button>
                }
            </div>
        </div>
    }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<Nature> Natures { get; set; } = Array.Empty<Nature>();
    [Parameter] public Nature? Value { get; set; }
    [Parameter] public EventCallback<Nature?> ValueChanged { get; set; }
    /// <summary>片方だけ選んだとき、物理技向け（C を下げる）に補うか。false なら特殊技向け（A を下げる）。</summary>
    [Parameter] public bool Physical { get; set; } = true;

    /// <summary>Partial="true" のとき、上がる能力・下がる能力として現在選んでいるもの。</summary>
    [Parameter] public bool Partial { get; set; }
    [Parameter] public Stat? Up { get; set; }
    [Parameter] public Stat? Down { get; set; }
    /// <summary>Partial="true" のとき、上がる能力・下がる能力のボタンを押したときに、新しい組を渡す（もう片方は補わない）。</summary>
    [Parameter] public EventCallback<(Stat? Up, Stat? Down)> PairChanged { get; set; }

    private async Task Press(bool increased, Stat? stat)
    {
        if (Partial)
        {
            var up = increased ? stat : Up;
            var down = increased ? Down : stat;
            // 同じ能力を上がる側・下がる側の両方にはできない（あとから押した方を優先する）
            if (up is not null && up == down) { if (increased) down = null; else up = null; }
            await PairChanged.InvokeAsync((up, down));
            return;
        }
        await Change(increased ? NatureSelection.WithIncreased(Natures, Value, stat, Physical) : NatureSelection.WithDecreased(Natures, Value, stat, Physical));
    }

    private async Task Change(Nature? nature)
    {
        if (nature is null || nature == Value) return;
        await ValueChanged.InvokeAsync(nature);
    }
}
