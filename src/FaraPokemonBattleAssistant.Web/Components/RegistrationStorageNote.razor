@inject CloudSync Sync
@implements IDisposable
@* 登録データの保存先を 1 行で知らせる。データ連携のページへの入口も兼ねる。 *@
@if (!Sync.IsSyncing)
{
    <Notice Class="mt-2">このブラウザだけに保存しています。ほかの端末やボットと共有するには<a href="data-sync">データ連携</a>を使います。</Notice>
}

@code {
    protected override void OnInitialized() => Sync.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Sync.Changed -= OnChanged;
}
