@using FaraPokemonBattleAssistant.Core.Roster
@* 登録から選ぶ。登録済みのポケモンを、チームごとに分けて呼び出す（チームで持たせた持ち物つき）。
   選んだ構成は写しで、手で値を変えても登録データは変わらない。登録が 1 件もなければ、登録ページへの案内を出す。 *@
@if (Groups.Count > 0)
{
    <div class="form-group mb-2">
        <label>登録から選ぶ <Help Title="登録から選ぶ">「登録・チーム」に登録したポケモンの性格・努力値（ポイント）・特性と、チームで持たせた持ち物を呼び出します。呼び出したあとに値を変えても、登録データは変わりません。</Help></label>
        <select class="form-select" @onchange="OnChanged">
            <option value="">（選択）</option>
            @foreach (var group in Groups)
            {
                <optgroup label="@group.Label">
                    @foreach (var choice in group.Choices)
                    {
                        <option value="@choice.Key">@choice.Label</option>
                    }
                </optgroup>
            }
        </select>
    </div>
}
else if (ShowEmptyHint)
{
    <p class="small text-muted mb-2">登録したポケモンの構成を呼び出せます（<a href="roster">登録・チーム</a>で登録）。</p>
}

@code {
    [Parameter] public IReadOnlyList<RosterChoiceGroup> Groups { get; set; } = Array.Empty<RosterChoiceGroup>();
    [Parameter] public EventCallback<RosterChoice> OnPick { get; set; }
    /// <summary>登録が無いときに案内を出すか（読み込みに失敗したときは出さない）。</summary>
    [Parameter] public bool ShowEmptyHint { get; set; } = true;

    private async Task OnChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        var choice = Groups.SelectMany(g => g.Choices).FirstOrDefault(c => c.Key == key);
        if (choice is not null) await OnPick.InvokeAsync(choice);
    }
}
