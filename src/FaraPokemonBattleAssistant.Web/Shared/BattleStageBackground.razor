@* 背景のバトルフィールド（見た目だけの飾りで、操作には関わらない）。CSS は app.css の「バトルフィールドの背景」。
   足場に立つ 2 体は BattleStage（ダメージ計算機・素早さ比較で選んだポケモン。どちらも未選択ならランダム） *@
@inject AppState App
@inject DataCatalog Catalog
@inject BattleStage Stage
@inject IJSRuntime JS
@implements IDisposable

<div class="bg-scene @(Stage.BattleActive ? "battle" : "") @ConditionClass" aria-hidden="true">
    <div class="bg-layer bg-blob blob-1"><span></span></div>
    <div class="bg-layer bg-blob blob-2"><span></span></div>
    <div class="bg-layer bg-blob blob-3"><span></span></div>
    <div class="field-sky"></div>
    <div class="field-stands"></div>
    <span class="field-flash" style="top: 28%; left: 12%"></span>
    <span class="field-flash" style="top: 33%; left: 31%; animation-delay: -2.4s"></span>
    <span class="field-flash" style="top: 26%; left: 58%; animation-delay: -4.1s; animation-duration: 9s"></span>
    <span class="field-flash" style="top: 35%; left: 77%; animation-delay: -1.2s; animation-duration: 8s"></span>
    <span class="field-flash" style="top: 30%; left: 91%; animation-delay: -5.6s"></span>
    <div class="field-floor">
        <div class="field-plane">
            <svg class="field-court" viewBox="0 0 200 320" preserveAspectRatio="none">
                <rect class="cf" x="4" y="4" width="192" height="312"></rect>
                <rect class="band" x="4" y="44" width="192" height="40"></rect>
                <rect class="band" x="4" y="124" width="192" height="72"></rect>
                <rect class="band" x="4" y="236" width="192" height="40"></rect>
                <rect class="cl" x="4" y="4" width="192" height="312"></rect>
                <line class="cl" x1="4" y1="160" x2="196" y2="160"></line>
                <circle class="cl" cx="100" cy="160" r="38"></circle>
                <path class="em" d="M66 160A34 34 0 0 1 134 160H112A12 12 0 0 0 88 160Z"></path>
                <circle class="cl" cx="100" cy="160" r="12"></circle>
                <rect class="cl" x="56" y="4" width="88" height="34"></rect>
                <rect class="cl" x="56" y="282" width="88" height="34"></rect>
            </svg>
            <div class="field-pad field-pad-foe"></div>
            <div class="field-pad field-pad-mine"></div>
        </div>
    </div>
    @* ポケモンは床とは別に置き、足場の位置に合わせる（index.html の faraPlaceStage） *@
    @if (Stage.Foe is { Icon.Length: > 0 } foe)
    {
        <img class="field-mon field-mon-foe" src="@foe.Icon" alt="" onerror="this.style.display='none'" />
    }
    @if (Stage.Mine is { Icon.Length: > 0 } mine)
    {
        <img class="field-mon field-mon-mine" src="@mine.Icon" alt="" onerror="this.style.display='none'" />
    }
    <div class="field-horizon"></div>
    <div class="field-beam field-beam-1"></div>
    <div class="field-beam field-beam-2"></div>
    @* 天候（雨・晴れ・砂嵐・雪）。対戦画面で、入力している天候を見た目で出す *@
    <div class="wx-layer"><canvas class="wx-canvas"></canvas></div>
</div>

@code {
    /// <summary>
    /// 開いているページで入力している天候・フィールドに合わせた class（app.css の「天候・フィールド」の節）。
    /// 対戦画面のときは濃く、そうでないときは控えめに出す（CSS 側で .battle の有無で変える）。
    /// </summary>
    private string ConditionClass =>
        $"{Stage.Weather switch { Weather.Sun => "wx-sun", Weather.Rain => "wx-rain", Weather.Sand => "wx-sand", Weather.Snow => "wx-snow", _ => "" }} " +
        $"{Stage.Terrain switch { Terrain.Electric => "tr-electric", Terrain.Grassy => "tr-grassy", Terrain.Psychic => "tr-psychic", Terrain.Misty => "tr-misty", _ => "" }}";

    /// <summary>雨・砂嵐・雪の粒（index.html の faraWeather）。種類と、対戦画面かどうか（濃さ）を渡す。</summary>
    private string ParticleKind => Stage.Weather switch { Weather.Rain => "rain", Weather.Sand => "sand", Weather.Snow => "snow", _ => "" };

    protected override async Task OnInitializedAsync()
    {
        Stage.Changed += OnStageChanged;
        App.Changed += OnAppChangedAsync;
        await App.InitializeAsync();
        await EnsureDefaultsAsync();
    }

    // ゲーム（データセット）が変わったら、そのゲームのポケモンで選び直す
    private Task OnAppChangedAsync() => EnsureDefaultsAsync();

    private async Task EnsureDefaultsAsync()
    {
        try
        {
            var data = await Catalog.GetDataSetAsync(App.DataSetKey);
            Stage.EnsureDefaults(App.DataSetKey, data);
        }
        catch
        {
            // 背景だけの飾りなので、データが読めなくても何もしない
        }
    }

    private void OnStageChanged() => InvokeAsync(StateHasChanged);

    // ポケモンの画像を足場の位置に合わせる（画面の大きさが変わったときは index.html 側で合わせ直す）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("faraPlaceStage");
            await JS.InvokeVoidAsync("faraWeather", ParticleKind, Stage.BattleActive);
        }
        catch { /* 背景だけの飾りなので、失敗しても何もしない */ }
    }

    public void Dispose()
    {
        Stage.Changed -= OnStageChanged;
        App.Changed -= OnAppChangedAsync;
    }
}
