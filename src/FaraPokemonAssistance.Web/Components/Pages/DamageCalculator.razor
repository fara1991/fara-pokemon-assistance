@page "/damage-calculator"
@inherits AppPageBase
@using FaraPokemonAssistance.Core.Roster
@inject DataCatalog Catalog
@inject RosterRepository Repo

<PageTitle>ダメージ計算機</PageTitle>

<div class="page-header">
    <h3>ダメージ計算機 <Help Title="ダメージ計算機">攻撃側と防御側のポケモンと技を選ぶと、乱数 16 通りのダメージと確定数を出します。ポケモンを選ぶと使用率に基づく性格・持ち物・特性が既定値として入ります。ゲームとバトル形式は左のメニューで切り替えます。</Help></h3>
    <p class="text-muted mb-0">使用チームがあれば「使用チームから」で自分の構成を呼び出せます。入力した内容は別のページへ移動しても残ります。</p>
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}

@if (data is not null && dataSet is not null)
{
    <div class="split-row">
        <div class="split-half">
            <div class="card">
                <div class="card-header"><h5>攻撃側</h5></div>
                <div class="card-body">
                    @if (teamMembers.Count > 0)
                    {
                        <div class="form-group mb-2">
                            <label>使用チームから <Help Title="使用チームから">「登録・チーム」で使用中にしたチームのポケモンを、努力値・性格・持ち物・特性ごと呼び出します。</Help></label>
                            <select class="form-select" @onchange="@(e => PickFromTeam(e.Value, true))">
                                <option value="">（選択）</option>
                                @foreach (var (entry, item) in teamMembers)
                                {
                                    <option value="@entry.Id">#@entry.Id @entry.PokemonName @(item is null ? "" : "@" + item.Name)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-group mb-2">
                        <label>ポケモン <Help Title="ポケモン">名前の一部（ひらがなでも可）で絞り込めます。使用率の高い順に並んでいます。</Help></label>
                        <SearchableSelect TItem="Pokemon"
                            Items="pokemonList"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Attacker?.Pokemon.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnAttackerChanged"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p">@PokemonRow(p)</ItemTemplate>
                        </SearchableSelect>
                    </div>
                    @if (s.Attacker is not null)
                    {
                        <div class="mb-2"><PokemonLabel Build="s.Attacker" /> <span class="small text-muted">種族値 @FormatStats(s.Attacker.Pokemon.BaseStats)</span></div>
                    }
                    <div class="form-group mb-3">
                        <label>技 <Help Title="技">攻撃側のポケモンが覚える技だけを、使用率の高い順に表示します。使用率が公開されていないゲームでは、威力にタイプ一致・相性（防御側を選んだとき）・天候・フィールド・威力が上がる特性や持ち物を掛けた値の大きい順です。選んだ技の分類（物理 / 特殊）に合わせて、下の努力値・ランクの項目が切り替わります。</Help></label>
                        <SearchableSelect TItem="Move"
                            Items="MoveChoices"
                            DisplayText="@(m => m.Name)"
                            ValueSelector="@(m => m.Id.ToString())"
                            SelectedValue="@(s.Move?.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnMoveChanged"
                            Placeholder="技名を入力...">
                            <ItemTemplate Context="m"><TypeIcon Type="@m.Type" Small="true" /><span>@m.Name</span><span class="text-muted ms-auto">@CategoryText(m) @(m.Power > 0 ? m.Power.ToString() : "-")</span></ItemTemplate>
                        </SearchableSelect>
                        @if (s.Move is not null)
                        {
                            <div class="small text-muted mt-1"><TypeIcon Type="@s.Move.Type" Small="true" /> @CategoryText(s.Move) 威力 @(s.Move.Power > 0 ? s.Move.Power.ToString() : "-")@(s.Move.UsesPhysicalDefense ? "（相手の防御で計算）" : "")@(s.Move.IsFixedDamage ? "（固定ダメージ技のため計算できません）" : "")</div>
                        }
                    </div>
                    @if (s.Attacker is not null)
                    {
                        @RenderBuildEditor(s.Attacker, true)
                    }
                </div>
            </div>
        </div>

        <div class="split-half">
            <div class="card">
                <div class="card-header"><h5>防御側</h5></div>
                <div class="card-body">
                    @if (teamMembers.Count > 0)
                    {
                        <div class="form-group mb-2">
                            <label>使用チームから</label>
                            <select class="form-select" @onchange="@(e => PickFromTeam(e.Value, false))">
                                <option value="">（選択）</option>
                                @foreach (var (entry, item) in teamMembers)
                                {
                                    <option value="@entry.Id">#@entry.Id @entry.PokemonName @(item is null ? "" : "@" + item.Name)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="form-group mb-2">
                        <label>ポケモン</label>
                        <SearchableSelect TItem="Pokemon"
                            Items="pokemonList"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.Defender?.Pokemon.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnDefenderChanged"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p">@PokemonRow(p)</ItemTemplate>
                        </SearchableSelect>
                    </div>
                    @if (s.Defender is not null)
                    {
                        <div class="mb-3"><PokemonLabel Build="s.Defender" /> <span class="small text-muted">種族値 @FormatStats(s.Defender.Pokemon.BaseStats)</span></div>
                        @RenderBuildEditor(s.Defender, false)
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="split-row mt-3">
        <div class="split-half">
            <div class="form-group mb-3">
                <label for="weather">天候（任意） <Help Title="天候">晴れはほのお 1.5 倍・みず 0.5 倍、雨はその逆。砂嵐はいわタイプの特防 1.5 倍、雪はこおりタイプの防御 1.5 倍。天候で発動する特性（サンパワー等）にも使います。</Help></label>
                <select id="weather" class="form-select" value="@s.Weather" @onchange="@(e => s.Weather = ParseEnum(e.Value, Weather.None))">
                    @foreach (var w in Enum.GetValues<Weather>())
                    {
                        <option value="@w">@FieldNames.Japanese(w)</option>
                    }
                </select>
            </div>
        </div>
        <div class="split-half">
            <div class="form-group mb-3">
                <label for="terrain">フィールド（任意） <Help Title="フィールド">エレキ・グラス・サイコは対応タイプの技が 1.3 倍、ミストはドラゴン技が 0.5 倍。グラスではじしん系が半減、サイコではワイドフォースが強化されます。地面にいるポケモンにだけ効きます。</Help></label>
                <select id="terrain" class="form-select" value="@s.Terrain" @onchange="@(e => s.Terrain = ParseEnum(e.Value, Terrain.None))">
                    @foreach (var t in Enum.GetValues<Terrain>())
                    {
                        <option value="@t">@FieldNames.Japanese(t)</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
        <button class="btn btn-primary" @onclick="Calculate">ダメージを計算</button>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="screen" checked="@s.Screen" @onchange="@(e => s.Screen = e.Value is true)" />
            <label class="form-check-label" for="screen">壁 <Help Title="壁">防御側の場のリフレクター（物理技）・ひかりのかべ（特殊技）・オーロラベール（両方）。ダメージが 0.5 倍（ダブルは約 0.67 倍）になります。急所と特性すりぬけは壁を無視します。</Help></label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="crit" checked="@s.IsCritical" @onchange="@(e => s.IsCritical = e.Value is true)" />
            <label class="form-check-label" for="crit">急所 <Help Title="急所">ダメージ 1.5 倍（スナイパーは 2.25 倍）。攻撃側のマイナスランクと防御側のプラスランクを無視します。</Help></label>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    @if (s.Result is not null && s.LastRequest is not null)
    {
        var result = s.Result;
        var lastRequest = s.LastRequest;
        <div class="card mt-3 result-card">
            <div class="card-header"><h5>計算結果 <Help Title="計算結果の見方">「確定 2 発」は 16 通りの乱数すべてで 2 回当てれば倒せること、「乱数 2 発(75%)」は 2 回で倒せる確率です。どく・やけどの定数ダメージ、オボンのみ等の回復きのみ、たべのこし・くろいヘドロ、グラスフィールドの回復、半減きのみ（1 発目のみ）、マルチスケイル（満タン時の 1 発目のみ）も確定数に含めています。</Help></h5></div>
            <div class="card-body">
                <p class="mb-2">
                    <PokemonLabel Build="lastRequest.Attacker" Small="true" />
                    <span class="mx-2">@lastRequest.Move.Name <TypeIcon Type="@result.MoveType" Small="true" /> →</span>
                    <PokemonLabel Build="lastRequest.Defender" Small="true" />
                </p>
                <p class="result-main mb-2">
                    <strong>@result.RangeText</strong>
                    <span class="ms-2 badge @(result.KnockOut.IsGuaranteed ? "bg-danger" : "bg-warning text-dark")">@result.KnockOut</span>
                    @if (result.TypeEffectiveness != 1.0)
                    {
                        <span class="ms-2 badge bg-secondary">@result.EffectivenessText</span>
                    }
                </p>
                <p class="mb-1"><strong>防御側 HP:</strong> @result.DefenderHP　<strong>攻撃実数値:</strong> @result.AttackStat　<strong>防御実数値:</strong> @result.DefenseStat　<strong>威力:</strong> @result.BasePower（@TypeNames.ToJapanese(result.MoveType)）</p>
                @if (lastRequest.Attacker.Pokemon.IsProvisional || lastRequest.Defender.Pokemon.IsProvisional)
                {
                    <p class="mb-1 text-warning">※ 「未収録」のポケモンは @data.Info.Name に正式収録されていないため、第9世代のデータで計算しています。</p>
                }
                <p class="mb-1"><strong>乱数:</strong> <span class="font-monospace">@string.Join(" ", result.Rolls)</span></p>
                @if (result.Modifiers.Count > 0)
                {
                    <p class="mb-1"><strong>補正:</strong> @string.Join("、", result.Modifiers)</p>
                }
                <hr />
                <p class="mb-1 text-muted small">チャットでの表示</p>
                <div class="alert alert-light border chat-output mb-0">@DamageCommand.Format(lastRequest, result, data.Info)</div>
            </div>
        </div>
    }

    @if (s.Attacker is not null && s.Defender is not null)
    {
        <div class="card mt-3">
            <div class="card-header"><h5>相手の@(EvRules.Label(dataSet.EvSystem))を推定（calc） <Help Title="努力値の推定">攻撃側に自分の構成、防御側に相手のポケモンを選び、実際に受けた（与えた）ダメージを入力すると、そのダメージになりうる相手の@(EvRules.Label(dataSet.EvSystem))と性格補正の候補を出します。相手は持ち物なしとして計算します。</Help></h5></div>
            <div class="card-body">
                <div class="input-group" style="max-width: 420px;">
                    <span class="input-group-text">受けたダメージ</span>
                    <input class="form-control" placeholder="93 または 45%" value="@s.ObservedDamageText" @onchange="@(e => s.ObservedDamageText = e.Value?.ToString() ?? "")" />
                    <button class="btn btn-outline-primary" @onclick="EstimateEvs">推定</button>
                </div>
                @if (!string.IsNullOrEmpty(s.EstimateText))
                {
                    <div class="alert alert-light border chat-output mt-2 mb-0">@s.EstimateText</div>
                }
            </div>
        </div>
    }
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public BattleFormat Format { get; set; }
        public PokemonBuild? Attacker { get; set; }
        public PokemonBuild? Defender { get; set; }
        public Move? Move { get; set; }
        public bool IsCritical { get; set; }
        public bool Screen { get; set; }
        public Weather Weather { get; set; }
        public Terrain Terrain { get; set; }
        public string ObservedDamageText { get; set; } = "";
        public string EstimateText { get; set; } = "";
        public DamageResult? Result { get; set; }
        public DamageRequest? LastRequest { get; set; }
    }

    private State s = new();
    private DataSetInfo? dataSet;
    private PokemonDataSet? data;
    private UsageData? usage;
    private string loadError = "";
    private string errorMessage = "";

    private IReadOnlyList<Pokemon> pokemonList = Array.Empty<Pokemon>();
    private IReadOnlyList<Move> attackerMoves = Array.Empty<Move>();
    private IReadOnlyList<Item> attackerItems = Array.Empty<Item>();
    private IReadOnlyList<Item> defenderItems = Array.Empty<Item>();
    private IReadOnlyList<(RegisteredPokemon Entry, Item? Item)> teamMembers = Array.Empty<(RegisteredPokemon, Item?)>();

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>("damage");
        await LoadDataSet();
    }

    protected override Task OnAppChangedAsync() => LoadDataSet();

    private static int ParseId(object? value) => int.TryParse(value?.ToString(), out var id) ? id : 0;
    private static T ParseEnum<T>(object? value, T fallback) where T : struct => Enum.TryParse<T>(value?.ToString(), out var v) ? v : fallback;

    private async Task LoadDataSet()
    {
        try
        {
            loadError = "";
            dataSet = App.DataSet;
            data = await Catalog.GetDataSetAsync(App.DataSetKey);
            usage = await data.GetUsageAsync(App.Format);
            teamMembers = await Repo.ActiveTeamMembersAsync(App.DataSetKey, data);
            pokemonList = usage.IsEmpty
                ? data.Pokemon
                : data.Pokemon.OrderBy(p => usage.RankOf(p.Id)).ToList();
            if (s.DataSetKey != App.DataSetKey)
            {
                s.DataSetKey = App.DataSetKey;
                s.Attacker = null;
                s.Defender = null;
                s.Move = null;
                s.Result = null;
                s.LastRequest = null;
                s.EstimateText = "";
            }
            s.Format = App.Format;
            RefreshAttackerLists();
            RefreshDefenderLists();
        }
        catch (Exception ex)
        {
            loadError = $"データの読み込みに失敗しました: {ex.Message}";
        }
    }

    private RenderFragment PokemonRow(Pokemon p) => __builder =>
    {
        <PokemonIcon Pokemon="p" Small="true" />
        <span>@p.Name@(p.IsProvisional ? "※未収録" : "")</span>
        <PokemonTypes Pokemon="p" Small="true" />
        <span class="text-muted ms-auto small">@FormatStats(p.BaseStats)</span>
    };

    private static string CategoryText(Move m) => m.Category switch
    {
        MoveCategory.Physical => "物理",
        MoveCategory.Special => "特殊",
        _ => "変化",
    };

    private PokemonBuild NewBuild(Pokemon pokemon)
    {
        var build = new PokemonBuild(pokemon, dataSet?.EvSystem ?? EvSystem.Classic)
        {
            Nature = usage?.TopNature(pokemon.Id) ?? NeutralNature(),
            Item = usage?.TopItem(pokemon.Id),
            Ability = usage?.TopAbility(pokemon) ?? data?.AbilitiesOf(pokemon).FirstOrDefault(),
        };
        ApplyFixedChoices(build);
        return build;
    }

    /// <summary>メガシンカ後はメガストーン固定、特性が 1 つなら固定。</summary>
    private void ApplyFixedChoices(PokemonBuild build)
    {
        if (data is null) return;
        if (build.Pokemon.IsMega)
            build.Item = data.FindItem(build.Pokemon.MegaStoneId!.Value) ?? build.Item;
        var abilities = data.AbilitiesOf(build.Pokemon);
        if (abilities.Count == 1) build.Ability = abilities[0];
        else if (build.Ability is not null && !abilities.Contains(build.Ability)) build.Ability = abilities.FirstOrDefault();
    }

    private void OnAttackerChanged(string value)
    {
        var pokemon = data?.FindPokemon(ParseId(value));
        if (pokemon is null)
        {
            s.Attacker = null;
            attackerMoves = Array.Empty<Move>();
            return;
        }
        s.Attacker = NewBuild(pokemon);
        RefreshAttackerLists();
        s.Move = DefaultMove(pokemon.Id);
        ApplyDefaultEvs(s.Attacker, s.Move, true);
        if (s.Defender is not null) ApplyDefaultEvs(s.Defender, s.Move, false);
    }

    private void OnMoveChanged(string value)
    {
        s.Move = data?.FindMove(ParseId(value));
        if (s.Attacker is not null) ApplyDefaultEvs(s.Attacker, s.Move, true);
        if (s.Defender is not null) ApplyDefaultEvs(s.Defender, s.Move, false);
    }

    private void OnDefenderChanged(string value)
    {
        var pokemon = data?.FindPokemon(ParseId(value));
        if (pokemon is null)
        {
            s.Defender = null;
            return;
        }
        s.Defender = NewBuild(pokemon);
        RefreshDefenderLists();
        ApplyDefaultEvs(s.Defender, s.Move, false);
    }

    private void PickFromTeam(object? value, bool isAttacker)
    {
        var id = ParseId(value);
        var member = teamMembers.FirstOrDefault(m => m.Entry.Id == id);
        if (member.Entry is null || data is null) return;
        var build = RosterRepository.ToBuild(member.Entry, data, member.Item);
        if (build is null) return;
        ApplyFixedChoices(build);
        if (isAttacker)
        {
            s.Attacker = build;
            RefreshAttackerLists();
            s.Move = DefaultMove(build.Pokemon.Id);
        }
        else
        {
            s.Defender = build;
            RefreshDefenderLists();
        }
    }

    private void EstimateEvs()
    {
        s.EstimateText = "";
        if (data is null || s.Attacker is null || s.Defender is null || s.Move is null) { s.EstimateText = "ポケモンと技を選択してください。"; return; }
        var text = s.ObservedDamageText.Trim();
        var asPercent = text.EndsWith('%') || text.EndsWith('％');
        if (!double.TryParse(text.TrimEnd('%', '％'), out var observed) || observed <= 0) { s.EstimateText = "受けたダメージを 93 または 45% の形で入力してください。"; return; }
        var request = new DamageRequest
        {
            Attacker = s.Attacker,
            Move = s.Move,
            Defender = s.Defender.Clone(),
            Format = App.Format,
            IsCritical = s.IsCritical,
            Weather = s.Weather,
            Terrain = s.Terrain,
            Screen = s.Screen,
        };
        request.Defender.Item = null;
        var estimate = new EvEstimator(data.TypeChart).Run(request, observed, asPercent);
        s.EstimateText = EvEstimator.Format(estimate, s.Defender.Pokemon, s.Move, data.Info.EvSystem) + "（相手は持ち物なし想定）";
    }

    private Nature? NeutralNature() => data?.FindNature("まじめ") ?? data?.Natures.FirstOrDefault(n => n.IsNeutral);

    /// <summary>技に合わせて、攻撃側は A か C、防御側は H に全振り。既に振ってある側はそのまま。</summary>
    private static void ApplyDefaultEvs(PokemonBuild build, Move? move, bool isAttacker)
    {
        var full = EvRules.Full(build.EvSystem);
        if (isAttacker)
        {
            if (move is null) return;
            var stat = move.AttackStatUsed;
            if (build.EVs[stat] == full) return;
            if (build.EVs.Total == 0 || build.EVs[Stat.Attack] == full || build.EVs[Stat.SpAttack] == full)
            {
                build.EVs = new StatSet();
                build.EVs[stat] = full;
            }
        }
        else if (build.EVs.Total == 0)
        {
            build.EVs[Stat.HP] = full;
        }
    }

    /// <summary>このゲーム自身の使用率がある（他のゲームの使用率で代用していない）か。</summary>
    private bool HasOwnUsage => usage is { IsEmpty: false } && usage.SourceKey == App.DataSetKey;

    /// <summary>技の候補。使用率が無いゲームでは、いまの防御側・天候・フィールドでの実質威力が大きい順に並べ直す。</summary>
    private IReadOnlyList<Move> MoveChoices
    {
        get
        {
            if (HasOwnUsage || data is null || s.Attacker is null) return attackerMoves;
            var calc = new FaraPokemonAssistance.Core.Battle.DamageCalculator(data.TypeChart);
            var defender = s.Defender ?? new PokemonBuild(new Pokemon());
            return attackerMoves
                .OrderByDescending(m => calc.EffectivePower(new DamageRequest
                {
                    Attacker = s.Attacker, Move = m, Defender = defender, Format = App.Format, Weather = s.Weather, Terrain = s.Terrain,
                }))
                .ToList();
        }
    }

    private Move? DefaultMove(int pokemonId) =>
        (HasOwnUsage ? usage!.TopMove(pokemonId) : null) ?? MoveChoices.FirstOrDefault(m => m.IsDamaging);

    private void RefreshAttackerLists()
    {
        if (data is null || s.Attacker is null) { attackerMoves = Array.Empty<Move>(); return; }
        var moves = data.LearnableMoves(s.Attacker.Pokemon.Id).Where(m => m.Category != MoveCategory.Status).ToList();
        attackerMoves = usage is null ? moves : usage.SortByUsage(moves, m => m.Id, usage.MoveOrder(s.Attacker.Pokemon.Id));
        attackerItems = ItemChoices(s.Attacker, i => i.IsOffensive);
    }

    private void RefreshDefenderLists()
    {
        if (data is null || s.Defender is null) return;
        defenderItems = ItemChoices(s.Defender, i => i.IsDefensive);
    }

    /// <summary>その側に関係する持ち物だけ（使用率順）。今持たせている持ち物は必ず含める。</summary>
    private IReadOnlyList<Item> ItemChoices(PokemonBuild build, Func<Item, bool> relevant)
    {
        var items = data!.Items.Where(i => relevant(i) && !i.IsMegaStone).ToList();
        if (build.Item is not null && !items.Contains(build.Item)) items.Insert(0, build.Item);
        return usage is null ? items : usage.SortByUsage(items, i => i.Id, usage.ItemOrder(build.Pokemon.Id));
    }

    private IReadOnlyList<Stat> EvStats(bool isAttacker)
    {
        var move = s.Move;
        if (isAttacker)
            return move is null || move.IsFixedDamage ? Array.Empty<Stat>() : new[] { move.AttackStatUsed };
        return move is null || move.IsFixedDamage ? new[] { Stat.HP } : new[] { Stat.HP, move.DefenseStatUsed };
    }

    private IReadOnlyList<Stat> BoostStats(bool isAttacker)
    {
        var move = s.Move;
        if (move is null || move.IsFixedDamage) return Array.Empty<Stat>();
        return new[] { isAttacker ? move.AttackStatUsed : move.DefenseStatUsed };
    }

    private RenderFragment RenderBuildEditor(PokemonBuild build, bool isAttacker) => __builder =>
    {
        var stats = StatCalculator.CalculateAll(build);
        var items = isAttacker ? attackerItems : defenderItems;
        var abilities = data!.AbilitiesOf(build.Pokemon);
        var evStats = EvStats(isAttacker);
        var boostStats = BoostStats(isAttacker);
        var side = isAttacker ? "atk" : "def";
        <div class="form-group mb-3">
            <label>性格 <Help Title="性格">上がる能力は 1.1 倍、下がる能力は 0.9 倍。実数値の赤が上昇、青が下降です。</Help></label>
            <SearchableSelect TItem="Nature"
                Items="data.Natures"
                DisplayText="@(n => n.Describe())"
                ValueSelector="@(n => n.Name)"
                SelectedValue="@(build.Nature?.Name ?? "")"
                SelectedValueChanged="@(v => build.Nature = data.FindNature(v))"
                Placeholder="性格を入力..." />
        </div>
        <div class="form-group mb-3">
            <label>持ち物 <Help Title="持ち物">@(isAttacker ? "攻撃側はダメージに関係する持ち物（こだわり系・いのちのたま・タイプ強化など）だけを表示します。" : "防御側は防御に関係する持ち物（とつげきチョッキ・しんかのきせきなど）だけを表示します。")メガシンカ後のポケモンはメガストーンで固定です。</Help></label>
            @if (build.Pokemon.IsMega)
            {
                <input class="form-control" value="@(build.Item?.Name ?? "")" disabled />
            }
            else
            {
                <SearchableSelect TItem="Item"
                    Items="items"
                    DisplayText="@(i => i.Name)"
                    ValueSelector="@(i => i.Id.ToString())"
                    SelectedValue="@(build.Item?.Id.ToString() ?? "")"
                    SelectedValueChanged="@(v => build.Item = data.FindItem(ParseId(v)))"
                    Placeholder="持ち物なし" />
            }
        </div>
        <div class="form-group mb-3">
            <label>特性 <Help Title="特性">そのポケモンが持てる特性だけを表示します。特性が 1 つしかないポケモン（メガシンカ後など）は固定です。</Help></label>
            @if (abilities.Count <= 1)
            {
                <input class="form-control" value="@(build.Ability?.Name ?? "")" disabled />
            }
            else
            {
                <select class="form-select" value="@(build.Ability?.Id.ToString() ?? "")" @onchange="@(e => build.Ability = data.FindAbility(ParseId(e.Value)))">
                    @foreach (var a in abilities)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            }
        </div>
        @if (dataSet!.HasTerastal)
        {
            <div class="form-group mb-3">
                <label>テラスタル <Help Title="テラスタル">テラスタル後のタイプ。攻撃側はテラスタイプと同じ技が 1.5 倍（元のタイプとも一致なら 2 倍）、防御側は受けるタイプがテラスタイプだけになります。</Help></label>
                <select class="form-select" value="@(build.TeraType ?? "")" @onchange="@(e => build.TeraType = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())">
                    <option value="">なし</option>
                    @foreach (var t in TypeNames.All)
                    {
                        <option value="@t">@TypeNames.ToJapanese(t)</option>
                    }
                </select>
            </div>
        }
        @if (dataSet.HasDynamax)
        {
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="dmax-@side" checked="@build.IsDynamax" @onchange="@(e => build.IsDynamax = e.Value is true)" />
                <label class="form-check-label" for="dmax-@side">ダイマックス <Help Title="ダイマックス">HP が 2 倍になり、技はダイマックス技の威力（威力 90〜150、かくとう・どくは 70〜100）になります。</Help></label>
            </div>
        }
        @if (evStats.Count > 0)
        {
            <div class="form-group mb-2">
                <label>@EvRules.Label(build.EvSystem) <Help Title="@EvRules.Label(build.EvSystem)">@(build.EvSystem == EvSystem.Points ? "チャンピオンズは 1 ポイントで実数値が 1 上がります（各 0〜32、合計 66）。" : "各 0〜252、合計 510。4 ごとに実数値が 1 上がります。")選んだ技に関係する能力だけを表示しています。ボタンで 0 と最大を入れられます。</Help></label>
                <div class="ev-grid">
                    @foreach (var stat in evStats)
                    {
                        <div class="ev-cell">
                            <span class="ev-label">@StatNames.Letter(stat)（@StatNames.Japanese(stat)）</span>
                            <input type="number" class="form-control form-control-sm" min="0" max="@EvRules.MaxPerStat(build.EvSystem)" step="@EvRules.Step(build.EvSystem)"
                                   value="@build.EVs[stat]" @onchange="@(e => build.EVs[stat] = ClampEv(e.Value, build.EvSystem))" />
                            <div class="ev-buttons">
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => build.EVs[stat] = 0">0</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => build.EVs[stat] = EvRules.MaxPerStat(build.EvSystem)">@EvRules.MaxPerStat(build.EvSystem)</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="small @(build.EVs.Total > EvRules.MaxTotal(build.EvSystem) ? "text-danger" : "text-muted")">合計 @build.EVs.Total / @EvRules.MaxTotal(build.EvSystem)</div>
            </div>
        }
        @if (boostStats.Count > 0)
        {
            <div class="form-group mb-2">
                <label>ランク補正 <Help Title="ランク補正">つるぎのまい等で変化した能力ランク（-6〜+6）。+1 で 1.5 倍、+2 で 2 倍、-1 で 2/3 倍です。</Help></label>
                <div class="ev-grid">
                    @foreach (var stat in boostStats)
                    {
                        <div class="ev-cell">
                            <span class="ev-label">@StatNames.Letter(stat)（@StatNames.Japanese(stat)）</span>
                            <select class="form-select form-select-sm" value="@build.Boosts[stat]" @onchange="@(e => build.Boosts[stat] = ParseBoost(e.Value))">
                                @for (var b = 6; b >= -6; b--)
                                {
                                    <option value="@b">@(b > 0 ? "+" + b : b.ToString())</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        }
        <div class="form-group mb-2">
            <label>状態異常 <Help Title="状態異常">やけどは物理技のダメージ 0.5 倍（こんじょう・からげんきは除く）。どく・もうどくは毎ターンの定数ダメージを確定数に含めます。まひは素早さ 0.5 倍です。</Help></label>
            <select class="form-select form-select-sm" value="@build.Status" @onchange="@(e => build.Status = ParseEnum(e.Value, StatusCondition.None))">
                @foreach (var st in Enum.GetValues<StatusCondition>())
                {
                    <option value="@st">@StatusNames.Japanese(st)</option>
                }
            </select>
        </div>
        <div class="form-group mb-2">
            <label>残り HP（%） <Help Title="残り HP">@(isAttacker ? "もうか・しんりょく・げきりゅう・むしのしらせは HP が 1/3 以下で対応タイプの技が 1.5 倍になります。" : "確定数を今の HP から数えます。マルチスケイル・ファントムガードは HP 満タンのときだけ効きます。")100 で満タンです。</Help></label>
            <div class="d-flex align-items-center gap-2">
                <input type="range" class="form-range" min="1" max="100" value="@build.HpPercent" @onchange="@(e => build.HpPercent = Math.Clamp(ParseId(e.Value), 1, 100))" />
                <input type="number" class="form-control form-control-sm" style="width: 5rem;" min="1" max="100" value="@build.HpPercent" @onchange="@(e => build.HpPercent = Math.Clamp(ParseId(e.Value), 1, 100))" />
                <span class="small text-muted text-nowrap">@build.CurrentHp / @build.MaxHp</span>
            </div>
        </div>
        <div class="stats-summary">
            <div>
                実数値：@foreach (var (stat, i) in Enum.GetValues<Stat>().Select((st, idx) => (st, idx)))
                {
                    if (i > 0) { <span>-</span> }
                    <span class="@StatColor(build, stat)">@(StatNames.Letter(stat))@(stats[stat])</span>
                }
            </div>
        </div>
    };

    private static string StatColor(PokemonBuild build, Stat stat) =>
        build.Nature?.IncreasedStat == stat ? "stat-up" : build.Nature?.DecreasedStat == stat ? "stat-down" : "";

    private static string FormatStats(StatSet st) =>
        $"H{st.HP}-A{st.Attack}-B{st.Defense}-C{st.SpAttack}-D{st.SpDefense}-S{st.Speed}";

    private static int ClampEv(object? value, EvSystem system) =>
        Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, 0, EvRules.MaxPerStat(system));

    private static int ParseBoost(object? value) =>
        Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, -6, 6);

    private void Calculate()
    {
        errorMessage = "";
        s.Result = null;
        if (data is null || s.Attacker is null || s.Defender is null || s.Move is null)
        {
            errorMessage = "ポケモンと技を選択してください。";
            return;
        }
        if (!s.Move.IsDamaging)
        {
            errorMessage = s.Move.IsFixedDamage
                ? $"{s.Move.Name} は固定ダメージ技のため計算できません。"
                : $"{s.Move.Name} はダメージを与える技ではありません。";
            return;
        }
        try
        {
            s.LastRequest = new DamageRequest
            {
                Attacker = s.Attacker,
                Move = s.Move,
                Defender = s.Defender,
                Format = App.Format,
                IsCritical = s.IsCritical,
                Weather = s.Weather,
                Terrain = s.Terrain,
                Screen = s.Screen,
            };
            s.Result = new FaraPokemonAssistance.Core.Battle.DamageCalculator(data.TypeChart).Calculate(s.LastRequest);
        }
        catch (Exception ex)
        {
            errorMessage = $"計算エラー: {ex.Message}";
        }
    }
}
