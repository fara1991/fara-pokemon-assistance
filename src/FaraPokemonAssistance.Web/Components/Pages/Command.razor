@page "/command"
@inject DataCatalog Catalog
@inject PokeCommand Poke

<PageTitle>チャットコマンド</PageTitle>

<h3>チャットコマンドを試す</h3>
<p class="text-muted">Twitch のチャットに打つのと同じ文字列を入力すると、ボットが返す 1 行がそのまま表示されます。</p>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label" for="dataset">データ</label>
        <select id="dataset" class="form-select" @bind="dataSetKey">
            @foreach (var ds in dataSets)
            {
                <option value="@ds.Key">@ds.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="format">バトル形式</label>
        <select id="format" class="form-select" @bind="format">
            <option value="@BattleFormat.Singles">シングル</option>
            <option value="@BattleFormat.Doubles">ダブル</option>
        </select>
    </div>
</div>

<div class="input-group mb-3">
    <input class="form-control" placeholder="!@(CurrentPrefix) dmg イエッサン♂ ワイドフォース メガリザードンX サイコ" @bind="input" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <button class="btn btn-primary" @onclick="Run" disabled="@running">実行</button>
</div>
<p class="small text-muted">接頭辞を省略すると選択中のデータ（<code>!@(CurrentPrefix)</code>）として実行します。</p>

@if (!string.IsNullOrEmpty(output))
{
    <div class="alert @(success ? "alert-success" : "alert-warning")" style="white-space: pre-wrap; word-break: break-all;">@output</div>
}

<div class="card mt-4">
    <div class="card-header">コマンド一覧（<code>!pokech</code> = チャンピオンズ、<code>!pokesv</code> = SV、<code>!pokess</code> = 剣盾）</div>
    <div class="card-body">
        <table class="table table-sm">
            <tbody>
                <tr><td><code>add 名前 H A B C D S 性格 [特性]</code></td><td>育成済みポケモンを登録（チャンピオンズは各 0〜32・合計 66、SV/剣盾は各 0〜252・合計 510）</td></tr>
                <tr><td><code>ls [名前]</code> / <code>more ID</code> / <code>rm ID</code></td><td>一覧 / 詳細（性格・振り・特性・実数値）/ 削除</td></tr>
                <tr><td><code>add team 番号 ID [持ち物]</code></td><td>チームに追加（6 体まで）。同じ ID を再指定すると持ち物を更新</td></tr>
                <tr><td><code>rm team 番号 [名前]</code> / <code>use team 番号</code></td><td>チームから外す（名前なしならチーム削除）/ 使用チームにする</td></tr>
                <tr><td><code>ls team</code> / <code>more team 番号</code></td><td>チーム一覧 / チーム詳細</td></tr>
                <tr><td><code>dmg 攻撃側 技±ランク 防御側 [オプション]</code></td><td>通常と急所のダメージ。使用チームにいるポケモンはその構成（持ち物は括弧内に表示）</td></tr>
                <tr><td><code>calc 攻撃側 技±ランク 防御側 ダメージ</code></td><td>受けたダメージ（<code>93</code> または <code>45%</code>）から相手の防御努力値と性格補正を推定</td></tr>
                <tr><td><code>diff 自分 相手 [+1 晴れ]</code></td><td>素早さ比較（自分は使用チーム、相手は 無振り/準速/最速/スカーフ最速）</td></tr>
            </tbody>
        </table>
        <p class="small text-muted mb-1">dmg のオプション: <code>A252</code> <code>H252</code>（努力値、チャンピオンズはポイント）、性格、持ち物、特性、<code>攻:</code>/<code>防:</code>、<code>+2</code>、<code>急所</code>、<code>ダブル</code>、<code>テラスほのお</code>、<code>晴れ</code>、<code>サイコ</code> など。</p>
        <p class="small text-muted mb-0">指定が無い項目は「攻撃側 全振り、防御側 H 全振り、性格・持ち物・特性は使用率 1 位（無ければ第 1 特性）」で補われ、結果に明記されます。</p>
    </div>
</div>

@code {
    private IReadOnlyList<DataSetInfo> dataSets = Array.Empty<DataSetInfo>();
    private string dataSetKey = DataCatalog.DefaultDataSetKey;
    private BattleFormat format = BattleFormat.Singles;
    private string input = "";
    private string output = "";
    private bool success;
    private bool running;

    protected override async Task OnInitializedAsync()
    {
        dataSets = await Catalog.GetDataSetsAsync();
        dataSetKey = await Catalog.ResolveDefaultKeyAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Run();
    }

    private string CurrentPrefix => dataSets.FirstOrDefault(d => d.Key == dataSetKey)?.CommandPrefix ?? "pokech";

    private async Task Run()
    {
        if (running) return;
        running = true;
        try
        {
            var text = input.Trim();
            var match = await Poke.MatchAsync(text);
            if (match is null)
                text = $"!{CurrentPrefix} {text.TrimStart('!')}";
            var result = await Poke.ExecuteAsync(text, new PokeCommandOptions { Format = format });
            success = result.Success;
            output = result.Message;
        }
        finally
        {
            running = false;
        }
    }
}
