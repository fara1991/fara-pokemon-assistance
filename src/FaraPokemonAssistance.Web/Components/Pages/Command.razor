@page "/command"
@inject DataCatalog Catalog
@inject DamageCommand DamageCmd

<PageTitle>チャットコマンド</PageTitle>

<h3>チャットコマンドを試す</h3>
<p class="text-muted">Twitch のチャットに打つのと同じ文字列を入力すると、ボットが返す 1 行がそのまま表示されます。</p>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label" for="dataset">データ</label>
        <select id="dataset" class="form-select" @bind="dataSetKey">
            @foreach (var ds in dataSets)
            {
                <option value="@ds.Key">@ds.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="format">バトル形式</label>
        <select id="format" class="form-select" @bind="format">
            <option value="@BattleFormat.Singles">シングル</option>
            <option value="@BattleFormat.Doubles">ダブル</option>
        </select>
    </div>
</div>

<div class="input-group mb-3">
    <span class="input-group-text">!dmg</span>
    <input class="form-control" placeholder="イエッサン♂ ワイドフォース メガリザードンX サイコ" @bind="input" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <button class="btn btn-primary" @onclick="Run" disabled="@running">実行</button>
</div>

@if (!string.IsNullOrEmpty(output))
{
    <div class="alert @(success ? "alert-success" : "alert-warning")" style="white-space: pre-wrap; word-break: break-all;">@output</div>
}

<div class="card mt-4">
    <div class="card-header">書き方</div>
    <div class="card-body">
        <pre class="mb-2">!dmg 攻撃側 技 防御側 [オプション...]</pre>
        <ul class="mb-0">
            <li>名前はカタカナ・ひらがな・略称（メガリザX など）・前方一致で解決します。</li>
            <li><code>A252</code> <code>C252</code> <code>S4</code> は攻撃側、<code>H252</code> <code>B4</code> <code>D252</code> は防御側の努力値になります。</li>
            <li>性格は上昇補正が攻撃・特攻・素早さなら攻撃側、防御・特防なら防御側に付きます。</li>
            <li>持ち物はとつげきチョッキ・しんかのきせきが防御側、それ以外は攻撃側に付きます。</li>
            <li><code>攻:</code> / <code>防:</code> を前に付けると側を明示できます（例: <code>防:ずぶとい</code>）。</li>
            <li><code>+2</code> で攻撃側のランク、<code>防:+1</code> で防御側のランク。<code>急所</code>、<code>ダブル</code>、<code>Lv100</code>、<code>無振り</code> も使えます。</li>
            <li>特性名（ちからもち など）はそのポケモンが持てる側に付きます。<code>テラス</code>（技タイプにテラスタル）、<code>テラスほのお</code>、<code>防:テラスみず</code>。</li>
            <li>天候: <code>晴れ</code> <code>雨</code> <code>砂</code> <code>雪</code>、フィールド: <code>エレキ</code> <code>グラス</code> <code>サイコ</code> <code>ミスト</code>。</li>
            <li>指定が無い項目は「攻撃側 252 振り、防御側 H252、性格・持ち物・特性は使用率 1 位（無ければ第 1 特性）」で補われ、結果に明記されます。</li>
        </ul>
    </div>
</div>

@code {
    private IReadOnlyList<DataSetInfo> dataSets = Array.Empty<DataSetInfo>();
    private string dataSetKey = DataCatalog.DefaultDataSetKey;
    private BattleFormat format = BattleFormat.Singles;
    private string input = "";
    private string output = "";
    private bool success;
    private bool running;

    protected override async Task OnInitializedAsync()
    {
        dataSets = await Catalog.GetDataSetsAsync();
        dataSetKey = await Catalog.ResolveDefaultKeyAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Run();
    }

    private async Task Run()
    {
        if (running) return;
        running = true;
        try
        {
            var result = await DamageCmd.ExecuteAsync(input, new DamageCommandOptions { DataSetKey = dataSetKey, Format = format });
            success = result.Success;
            output = result.Message;
        }
        finally
        {
            running = false;
        }
    }
}
