@page "/types"
@inherits AppPageBase
@inject DataCatalog Catalog

<PageTitle>タイプ相性表</PageTitle>

<div class="page-header">
    <h3>タイプ相性表 <Help Title="タイプ相性表の見方">縦が攻撃する技のタイプ、横が受けるポケモンのタイプです。2 つのタイプを持つポケモンは、両方の倍率を掛け合わせます（例: ◎2 × △½ = 等倍）。マスにカーソルを合わせると、その行と列が強調されます。</Help></h3>
    <p class="text-muted mb-0">縦が攻撃側、横が防御側です。</p>
</div>

<div class="type-legend mb-3">
    <span><span class="type-mark type-weak">◎</span> 効果抜群（2 倍）</span>
    <span><span class="type-mark type-resist">△</span> いまひとつ（½ 倍）</span>
    <span><span class="type-mark type-immune">×</span> 効果なし（0 倍）</span>
    <span><span class="type-mark">&nbsp;</span> 空欄は等倍</span>
</div>

@if (chart is not null)
{
    <div class="table-responsive">
        <table class="table table-bordered table-sm type-chart" @onmouseleave="() => { hoverRow = null; hoverCol = null; }">
            <thead>
                <tr>
                    <th class="type-corner">攻＼防</th>
                    @foreach (var d in TypeNames.All)
                    {
                        <th class="type-head @(hoverCol == d ? "type-hover" : "")"><TypeIcon Type="@d" /></th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var a in TypeNames.All)
            {
                <tr>
                    <th class="type-head @(hoverRow == a ? "type-hover" : "")"><TypeIcon Type="@a" /></th>
                    @foreach (var d in TypeNames.All)
                    {
                        var m = chart.Against(a, d);
                        var hover = hoverRow == a || hoverCol == d ? "type-hover" : "";
                        <td class="@CellClass(m) @hover" title="@TypeNames.ToJapanese(a) → @TypeNames.ToJapanese(d): @Describe(m)"
                            @onmouseover="() => { hoverRow = a; hoverCol = d; }">@Mark(m)</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private TypeChart? chart;
    private string? hoverRow;
    private string? hoverCol;

    protected override Task OnAppReadyAsync() => LoadAsync();

    protected override Task OnAppChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        chart = (await Catalog.GetDataSetAsync(App.DataSetKey)).TypeChart;
    }

    private static string Mark(double m) => m switch
    {
        0.0 => "×",
        < 1.0 => "△",
        > 1.0 => "◎",
        _ => "",
    };

    private static string Describe(double m) => m switch
    {
        0.0 => "効果なし（0 倍）",
        < 1.0 => $"いまひとつ（{m:0.##} 倍）",
        > 1.0 => $"効果抜群（{m:0.##} 倍）",
        _ => "等倍",
    };

    private static string CellClass(double m) => m switch
    {
        0.0 => "type-immune",
        < 1.0 => "type-resist",
        > 1.0 => "type-weak",
        _ => "",
    };
}
