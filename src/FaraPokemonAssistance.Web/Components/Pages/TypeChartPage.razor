@page "/types"
@inherits AppPageBase
@inject DataCatalog Catalog

<PageTitle>タイプ相性表</PageTitle>

<div class="page-header">
    <h3>タイプ相性表 <Help Title="タイプ相性表の見方">縦が攻撃する技のタイプ、横が受けるポケモンのタイプです。2 つのタイプを持つポケモンは、両方の倍率を掛け合わせます（例: 2 × ½ = 等倍）。</Help></h3>
    <p class="text-muted mb-0">縦が攻撃側、横が防御側。<span class="badge type-weak">2</span> 効果抜群、<span class="badge type-resist">½</span> いまひとつ、<span class="badge type-immune">0</span> 効果なし。アイコンにカーソルを合わせるとタイプ名が出ます。</p>
</div>

@if (chart is not null)
{
    <div class="table-responsive">
        <table class="table table-bordered table-sm type-chart">
            <thead>
                <tr>
                    <th class="type-corner">攻＼防</th>
                    @foreach (var d in TypeNames.All)
                    {
                        <th class="type-head"><TypeIcon Type="@d" /></th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var a in TypeNames.All)
            {
                <tr>
                    <th class="type-head"><TypeIcon Type="@a" /></th>
                    @foreach (var d in TypeNames.All)
                    {
                        var m = chart.Against(a, d);
                        <td class="@CellClass(m)" title="@TypeNames.ToJapanese(a) → @TypeNames.ToJapanese(d): @(m == 1.0 ? "等倍" : MultText(m) + "倍")">@(m == 1.0 ? "" : MultText(m))</td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private TypeChart? chart;

    protected override Task OnAppReadyAsync() => LoadAsync();

    protected override Task OnAppChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        chart = (await Catalog.GetDataSetAsync(App.DataSetKey)).TypeChart;
    }

    private static string MultText(double m) => m switch
    {
        0.0 => "0",
        0.25 => "¼",
        0.5 => "½",
        2.0 => "2",
        4.0 => "4",
        _ => m.ToString("0.##"),
    };

    private static string CellClass(double m) => m switch
    {
        0.0 => "type-immune",
        < 1.0 => "type-resist",
        > 1.0 => "type-weak",
        _ => "",
    };
}
