@page "/roster"
@inherits AppPageBase
@using FaraPokemonAssistance.Core.Roster
@inject DataCatalog Catalog
@inject RosterRepository Repo

<PageTitle>登録ポケモン・チーム</PageTitle>

<div class="page-header">
    <h3>登録ポケモン・チーム <Help Title="登録・チーム">育成済みのポケモン（努力値・性格・特性）を登録し、チームにまとめて「使用中」にすると、ダメージ計算機・素早さ比較・チャットコマンドでその構成が自動で使われます。データはこのブラウザだけに保存され、ゲームごとに分かれています。</Help></h3>
    <p class="text-muted mb-0">チャットの <code>!@(App.CommandPrefix) add / add team / use team</code> と同じ内容をここで編集できます。</p>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")">@message</div>
}

@if (data is not null && roster is not null && dataSet is not null)
{
    <div class="split-row">
        <div class="split-half">
            <div class="card mb-3">
                <div class="card-header"><h5>ポケモンを登録</h5></div>
                <div class="card-body">
                    <div class="form-group mb-2">
                        <label>ポケモン</label>
                        <SearchableSelect TItem="Pokemon"
                            Items="data.Pokemon"
                            DisplayText="@(p => p.Name)"
                            ValueSelector="@(p => p.Id.ToString())"
                            SelectedValue="@(s.NewPokemon?.Id.ToString() ?? "")"
                            SelectedValueChanged="@OnNewPokemonChanged"
                            Placeholder="ポケモン名を入力...">
                            <ItemTemplate Context="p"><PokemonIcon Pokemon="p" Small="true" /><span>@p.Name</span><PokemonTypes Pokemon="p" Small="true" /></ItemTemplate>
                        </SearchableSelect>
                        @if (s.NewPokemon is not null)
                        {
                            <div class="mt-2"><PokemonLabel Pokemon="s.NewPokemon" /></div>
                        }
                    </div>
                    <div class="form-group mb-2">
                        <label>@EvRules.Label(dataSet.EvSystem)（各 0〜@EvRules.MaxPerStat(dataSet.EvSystem)、合計 @EvRules.MaxTotal(dataSet.EvSystem)） <Help Title="@EvRules.Label(dataSet.EvSystem)">@(dataSet.EvSystem == EvSystem.Points ? "チャンピオンズは 1 ポイントで実数値が 1 上がります。各 0〜32、合計 66 まで。" : "各 0〜252、合計 510 まで。4 刻みで実数値が 1 上がります。") ボタンで 0 と最大を入れられます。</Help></label>
                        <div class="ev-grid">
                            @foreach (var stat in Enum.GetValues<Stat>())
                            {
                                <div class="ev-cell">
                                    <span class="ev-label">@StatNames.Letter(stat)</span>
                                    <input type="number" class="form-control form-control-sm" min="0" max="@EvRules.MaxPerStat(dataSet.EvSystem)" step="@EvRules.Step(dataSet.EvSystem)"
                                           value="@s.NewEvs[stat]" @onchange="@(e => s.NewEvs[stat] = Clamp(e.Value, EvRules.MaxPerStat(dataSet.EvSystem)))" />
                                    <div class="ev-buttons">
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => s.NewEvs[stat] = 0">0</button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => s.NewEvs[stat] = EvRules.MaxPerStat(dataSet.EvSystem)">@EvRules.MaxPerStat(dataSet.EvSystem)</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="small @(s.NewEvs.Total > EvRules.MaxTotal(dataSet.EvSystem) ? "text-danger" : "text-muted")">合計 @s.NewEvs.Total / @EvRules.MaxTotal(dataSet.EvSystem)</div>
                    </div>
                    <div class="form-group mb-2">
                        <label>性格</label>
                        <SearchableSelect TItem="Nature"
                            Items="data.Natures"
                            DisplayText="@(n => n.Describe())"
                            ValueSelector="@(n => n.Name)"
                            SelectedValue="@(s.NewNature?.Name ?? "")"
                            SelectedValueChanged="@(v => s.NewNature = data.FindNature(v))"
                            Placeholder="性格を入力..." />
                    </div>
                    <div class="form-group mb-3">
                        <label>特性</label>
                        <select class="form-select" value="@(s.NewAbility?.Id.ToString() ?? "")" disabled="@(s.NewPokemon is null || data.AbilitiesOf(s.NewPokemon).Count <= 1)" @onchange="@(e => s.NewAbility = data.FindAbility(ParseId(e.Value)))">
                            @if (s.NewPokemon is not null)
                            {
                                @foreach (var a in data.AbilitiesOf(s.NewPokemon))
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            }
                        </select>
                    </div>
                    @if (s.NewPokemon is not null)
                    {
                        <div class="stats-summary mb-2">実数値：@FormatStats(StatCalculator.CalculateAll(NewBuild()))</div>
                    }
                    <button class="btn btn-primary" @onclick="AddPokemonAsync" disabled="@(s.NewPokemon is null || s.NewNature is null)">登録</button>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><h5>登録一覧（@roster.Pokemon.Count 体）</h5></div>
                <div class="card-body p-0">
                    @if (roster.Pokemon.Count == 0)
                    {
                        <p class="p-3 mb-0 text-muted">まだ登録がありません。</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead><tr><th>ID</th><th>ポケモン</th><th>性格</th><th>@EvRules.Label(dataSet.EvSystem)</th><th>実数値</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var e in roster.Pokemon)
                            {
                                var build = RosterRepository.ToBuild(e, data);
                                <tr>
                                    <td>#@e.Id</td>
                                    <td><PokemonLabel Pokemon="data.FindPokemon(e.PokemonId)" Small="true" /><br /><small class="text-muted">@(build?.Ability?.Name)</small></td>
                                    <td>@e.Nature</td>
                                    <td>@e.EVs.ToShortString()</td>
                                    <td class="small">@(build is null ? "-" : FormatStats(StatCalculator.CalculateAll(build)))</td>
                                    <td><button class="btn btn-outline-danger btn-sm" @onclick="() => RemovePokemonAsync(e.Id)">削除</button></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="split-half">
            <div class="card mb-3">
                <div class="card-header"><h5>チームに追加 <Help Title="チーム">1 チーム 6 体まで。同じ登録 ID をもう一度追加すると持ち物だけ更新します。メガシンカ後のポケモンはメガストーンが自動で付きます。</Help></h5></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label">チーム番号</label>
                            <input type="number" class="form-control" min="1" value="@s.TeamNumber" @onchange="@(e => s.TeamNumber = Math.Max(1, ParseId(e.Value)))" />
                        </div>
                        <div class="col-8">
                            <label class="form-label">登録ポケモン</label>
                            <select class="form-select" value="@s.TeamEntryId" @onchange="OnTeamEntryChanged">
                                <option value="0">選択...</option>
                                @foreach (var e in roster.Pokemon)
                                {
                                    <option value="@e.Id">#@e.Id @e.PokemonName（@e.Nature）</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">持ち物</label>
                            @if (TeamEntryIsMega)
                            {
                                <input class="form-control" value="@(s.TeamItem?.Name ?? "")" disabled />
                            }
                            else
                            {
                                <SearchableSelect TItem="Item"
                                    Items="data.Items.Where(i => !i.IsMegaStone)"
                                    DisplayText="@(i => i.Name)"
                                    ValueSelector="@(i => i.Id.ToString())"
                                    SelectedValue="@(s.TeamItem?.Id.ToString() ?? "")"
                                    SelectedValueChanged="@(v => s.TeamItem = data.FindItem(ParseId(v)))"
                                    Placeholder="持ち物を入力（任意）..." />
                            }
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" @onclick="AddToTeamAsync" disabled="@(s.TeamEntryId == 0 || s.TeamNumber < 1)">チームに追加</button>
                </div>
            </div>

            @foreach (var team in roster.Teams)
            {
                var isActive = roster.ActiveTeam == team.Number;
                <div class="card mb-3 @(isActive ? "border-primary" : "")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">チーム@(team.Number) @(isActive ? "（使用中）" : "")</h5>
                        <div>
                            @if (!isActive)
                            {
                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => UseTeamAsync(team.Number)">このチームを使用</button>
                            }
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveTeamAsync(team.Number)">チーム削除</button>
                        </div>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var slot in team.Slots)
                        {
                            var entry = roster.Pokemon.FirstOrDefault(p => p.Id == slot.EntryId);
                            var item = slot.ItemId is { } iid ? data.FindItem(iid) : null;
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>#@slot.EntryId <PokemonLabel Pokemon="entry is null ? null : data.FindPokemon(entry.PokemonId)" Small="true" /> <small class="text-muted">@(entry?.Nature) @(entry?.EVs.ToShortString())</small> @(item is null ? "" : "@" + item.Name)</span>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => RemoveFromTeamAsync(team.Number, slot.EntryId)">外す</button>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public Pokemon? NewPokemon { get; set; }
        public StatSet NewEvs { get; set; } = new();
        public Nature? NewNature { get; set; }
        public Ability? NewAbility { get; set; }
        public int TeamNumber { get; set; } = 1;
        public int TeamEntryId { get; set; }
        public Item? TeamItem { get; set; }
    }

    private State s = new();
    private DataSetInfo? dataSet;
    private PokemonDataSet? data;
    private DataSetRoster? roster;
    private string message = "";
    private bool messageIsError;

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>("roster");
        await LoadAsync();
    }

    protected override Task OnAppChangedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            dataSet = App.DataSet;
            data = await Catalog.GetDataSetAsync(App.DataSetKey);
            roster = (await Repo.GetAsync()).For(App.DataSetKey);
            if (s.DataSetKey != App.DataSetKey)
            {
                s.DataSetKey = App.DataSetKey;
                s.NewPokemon = null;
                s.NewEvs = new StatSet();
                s.NewNature = data.FindNature("まじめ");
                s.NewAbility = null;
                s.TeamItem = null;
                s.TeamEntryId = 0;
            }
            s.NewNature ??= data.FindNature("まじめ");
        }
        catch (Exception ex)
        {
            Show($"読み込みに失敗しました: {ex.Message}", true);
        }
    }

    private bool TeamEntryIsMega =>
        roster?.Pokemon.FirstOrDefault(p => p.Id == s.TeamEntryId) is { } entry && data?.FindPokemon(entry.PokemonId)?.IsMega == true;

    private static int ParseId(object? value) => int.TryParse(value?.ToString(), out var v) ? v : 0;
    private static int Clamp(object? value, int max) => Math.Clamp(int.TryParse(value?.ToString(), out var v) ? v : 0, 0, max);
    private static string FormatStats(StatSet st) => $"H{st.HP}-A{st.Attack}-B{st.Defense}-C{st.SpAttack}-D{st.SpDefense}-S{st.Speed}";

    private void Show(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }

    private void OnNewPokemonChanged(string value)
    {
        s.NewPokemon = data?.FindPokemon(ParseId(value));
        s.NewAbility = s.NewPokemon is null ? null : data?.AbilitiesOf(s.NewPokemon).FirstOrDefault();
    }

    private void OnTeamEntryChanged(ChangeEventArgs e)
    {
        s.TeamEntryId = ParseId(e.Value);
        var entry = roster?.Pokemon.FirstOrDefault(p => p.Id == s.TeamEntryId);
        var pokemon = entry is null ? null : data?.FindPokemon(entry.PokemonId);
        if (pokemon?.IsMega == true)
            s.TeamItem = data?.FindItem(pokemon.MegaStoneId!.Value);
        else if (s.TeamItem?.IsMegaStone == true)
            s.TeamItem = null;
    }

    private PokemonBuild NewBuild() => new(s.NewPokemon!, dataSet!.EvSystem) { EVs = s.NewEvs, Nature = s.NewNature, Ability = s.NewAbility };

    private async Task AddPokemonAsync()
    {
        if (data is null || dataSet is null || s.NewPokemon is null || s.NewNature is null) return;
        if (EvRules.Validate(dataSet.EvSystem, s.NewEvs) is { } error) { Show(error, true); return; }
        var entry = await Repo.AddPokemonAsync(App.DataSetKey, s.NewPokemon, s.NewEvs.Clone(), s.NewNature, s.NewAbility);
        Show($"#{entry.Id} {entry.PokemonName} を登録しました", false);
        s.NewEvs = new StatSet();
    }

    private async Task RemovePokemonAsync(int id)
    {
        await Repo.RemovePokemonAsync(App.DataSetKey, id);
        Show($"#{id} を削除しました", false);
    }

    private async Task AddToTeamAsync()
    {
        try
        {
            var (team, _, replaced) = await Repo.AddToTeamAsync(App.DataSetKey, s.TeamNumber, s.TeamEntryId, s.TeamItem);
            Show($"チーム{team.Number} に{(replaced ? "更新" : "追加")}しました（{team.Slots.Count}/6）", false);
        }
        catch (Exception ex)
        {
            Show(ex.Message, true);
        }
    }

    private async Task RemoveFromTeamAsync(int teamNo, int entryId)
    {
        await Repo.RemoveFromTeamAsync(App.DataSetKey, teamNo, e => e.Id == entryId);
    }

    private async Task RemoveTeamAsync(int teamNo)
    {
        await Repo.RemoveTeamAsync(App.DataSetKey, teamNo);
        Show($"チーム{teamNo} を削除しました", false);
    }

    private async Task UseTeamAsync(int teamNo)
    {
        await Repo.UseTeamAsync(App.DataSetKey, teamNo);
        Show($"チーム{teamNo} を使用します", false);
    }
}
