@page "/"
@inherits AppPageBase
@inject HttpClient Http

<PageTitle>ホーム</PageTitle>

<div class="page-header">
    <h3>ポケモン対戦アシスタント</h3>
    <p class="text-muted mb-0">ダメージ計算・素早さ比較・育成済みポケモンとチームの管理・タイプ相性をまとめたサイトです。配信中は Twitch のチャットコマンドからも同じ機能を使えます。</p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">ダメージ計算機</h5>
                <p class="card-text">
                    努力値・性格・持ち物・特性・ランク補正・急所・壁・天候・フィールド・状態異常・残り HP を指定して、
                    乱数 16 通りのダメージと確定数を出します。確定数には回復きのみ・たべのこし・定数ダメージも含めます。受けたダメージから相手の努力値を推定することもできます。
                </p>
                <a href="damage-calculator" class="btn btn-primary">計算機を開く</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">チャットコマンド</h5>
                <p class="card-text">
                    配信中に <code>!@(App.CommandPrefix) dmg ガブリアス じしん リザードン</code> のように打つと、ボットが結果を 1 行で返します。
                    同じコマンドをブラウザで試せます。
                </p>
                <a href="command" class="btn btn-secondary">コマンドを試す</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h6 class="card-title">登録・チーム</h6><p class="card-text small">育成済みのポケモンとチームを登録しておくと、計算のときに自分の構成が自動で入ります（<code>!@(App.CommandPrefix) add / add team / use team</code>）。</p><a href="roster" class="btn btn-outline-primary btn-sm">開く</a></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h6 class="card-title">素早さ比較</h6><p class="card-text small">2 体のポケモンの素早さを比べて、どちらが先に動くかを確認します（チャットでは <code>!@(App.CommandPrefix) diff</code>）。</p><a href="speed" class="btn btn-outline-primary btn-sm">開く</a></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h6 class="card-title">タイプ相性表</h6><p class="card-text small">18 タイプの相性をアイコンで一覧できます。</p><a href="types" class="btn btn-outline-primary btn-sm">開く</a></div></div></div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">対応しているゲーム <Help Title="ゲームの切り替え">左のメニューの「ゲーム」で切り替えます。選んだゲームは全ページとチャットコマンドの接頭辞に反映されます。</Help></h6>
                <ul class="mb-0 small">
                    <li>ソード・シールド（鎧の孤島・冠の雪原を含む）: ダイマックスに対応</li>
                    <li>スカーレット・バイオレット（DLC を含む）: テラスタルに対応。ポケモン HOME のランクバトル使用率から、よく使われる技・持ち物・性格を既定値にしています</li>
                    <li>ポケモンチャンピオンズ: 収録ポケモン（231 種とメガシンカ・フォルム違い）、メガシンカ、ポイント制の努力値に対応</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">サイト内ポケモンデータの更新 <Help Title="サイト内ポケモンデータの更新">ポケモン・技・持ち物・使用率のデータは毎週月曜の昼に自動で更新されます。更新後にページを再読み込みすると新しいデータになります。</Help></h6>
                <table class="table table-sm mb-0 small">
                    <tbody>
                        <tr><th class="text-nowrap">最終更新</th><td>@(lastUpdated ?? "取得中…")</td></tr>
                        <tr><th class="text-nowrap">次回更新</th><td>@nextUpdate（毎週月曜）</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@code {
    // update-data.yml の cron（17 3 * * 1 UTC = 毎週月曜 12:17 JST）
    private static readonly TimeSpan UpdateTimeUtc = new(3, 17, 0);
    private static readonly TimeSpan Jst = TimeSpan.FromHours(9);

    private string? lastUpdated;
    private string nextUpdate = "";

    protected override async Task OnAppReadyAsync()
    {
        nextUpdate = FormatJst(NextUpdateUtc(DateTime.UtcNow));
        try
        {
            var text = (await Http.GetStringAsync("data/updated.txt")).Trim();
            lastUpdated = DateTime.TryParse(text, null, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var dt)
                ? FormatJst(dt)
                : text;
        }
        catch
        {
            lastUpdated = "不明";
        }
    }

    private static DateTime NextUpdateUtc(DateTime nowUtc)
    {
        var candidate = nowUtc.Date + UpdateTimeUtc;
        while (candidate.DayOfWeek != DayOfWeek.Monday || candidate <= nowUtc)
            candidate = candidate.AddDays(1);
        return DateTime.SpecifyKind(candidate, DateTimeKind.Utc);
    }

    private static string FormatJst(DateTime utc)
    {
        var jst = utc + Jst;
        var day = jst.DayOfWeek switch
        {
            DayOfWeek.Monday => "月", DayOfWeek.Tuesday => "火", DayOfWeek.Wednesday => "水", DayOfWeek.Thursday => "木",
            DayOfWeek.Friday => "金", DayOfWeek.Saturday => "土", _ => "日",
        };
        return $"{jst:yyyy/MM/dd}（{day}）{jst:HH:mm} 日本時間";
    }
}
