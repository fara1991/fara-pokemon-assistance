@* 項目の説明を出す「?」ボタン。押すと Excel のコメントのような吹き出しを表示する。 *@
<span class="help-wrap">
    <button type="button" class="help-btn" title="説明を見る" aria-label="説明を見る" @onclick="Toggle" @onclick:stopPropagation="true">?</button>
    @if (open)
    {
        <span class="help-note" role="note">
            @if (!string.IsNullOrEmpty(Title))
            {
                <strong class="d-block mb-1">@Title</strong>
            }
            @ChildContent
            <button type="button" class="help-close" aria-label="閉じる" @onclick="Toggle">×</button>
        </span>
    }
</span>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool open;

    private void Toggle() => open = !open;
}
