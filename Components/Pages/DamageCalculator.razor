@page "/damage-calculator"
@using FaraPokemonTools.Models
@using FaraPokemonTools.Services
@inject IPokemonDataService PokemonService
@inject IMoveDataService MoveService
@inject IItemDataService ItemService
@inject IDamageCalculationService DamageService
@inject IGenerationService GenerationService
@inject IUsageDataService UsageService

<PageTitle>ダメージ計算機</PageTitle>

<h3>ダメージ計算機</h3>

<div class="split-row">
    <div class="split-half">
        <div class="form-group mb-3">
            <label for="generation">世代:</label>
            <select id="generation" class="form-control" @bind="selectedGeneration" @bind:after="OnGenerationChanged">
                @foreach (var gen in availableGenerations)
                {
                    <option value="@gen">第@(gen)世代</option>
                }
            </select>
        </div>
    </div>
    <div class="split-half">
        <div class="form-group mb-3">
            <label for="battleFormat">バトル形式:</label>
            <select id="battleFormat" class="form-control" @bind="selectedBattleFormat" @bind:after="OnBattleFormatChanged">
                <option value="singles">シングル</option>
                <option value="doubles">ダブル</option>
            </select>
        </div>
    </div>
</div>

<div class="split-row">
    <div class="split-half">
        <div class="card">
            <div class="card-header">
                <h5>攻撃側</h5>
            </div>
            <div class="card-body">
                <div class="form-group mb-3">
                    <label>ポケモン:</label>
                    <SearchableSelect TItem="Pokemon"
                        Items="pokemonList"
                        DisplayText="@(p => FormatPokemon(p))"
                        ValueSelector="@(p => p.Id.ToString())"
                        SelectedValue="@request.AttackerPokemonId.ToString()"
                        SelectedValueChanged="@OnAttackerPokemonChanged"
                        Placeholder="ポケモン名を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>技:</label>
                    <SearchableSelect TItem="Move"
                        Items="attackerMoveList"
                        DisplayText="@(m => $"{m.Name} ({TypeToJapanese(m.Type)}, {m.Power})")"
                        ValueSelector="@(m => m.Id.ToString())"
                        SelectedValue="@request.MoveId.ToString()"
                        SelectedValueChanged="@(v => request.MoveId = int.TryParse(v, out var id) ? id : 0)"
                        Placeholder="技名を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>レベル:</label>
                    <input type="number" class="form-control" @bind="request.Attacker.Level" min="1" max="100" />
                </div>
                <div class="form-group mb-3">
                    <label>性格:</label>
                    <SearchableSelect TItem="Nature"
                        Items="natureList"
                        DisplayText="@(n => FormatNature(n))"
                        ValueSelector="@(n => n.Name)"
                        SelectedValue="@request.Attacker.Nature"
                        SelectedValueChanged="@(v => request.Attacker.Nature = v)"
                        Placeholder="性格を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>持ち物:</label>
                    <SearchableSelect TItem="Item"
                        Items="attackerItemList"
                        DisplayText="@(i => i.Name)"
                        ValueSelector="@(i => i.Id.ToString())"
                        SelectedValue="@(request.Attacker.ItemId?.ToString() ?? "")"
                        SelectedValueChanged="@(v => request.Attacker.ItemId = int.TryParse(v, out var id) ? id : null)"
                        Placeholder="持ち物を入力..." />
                </div>
            </div>
        </div>
    </div>

    <div class="split-half">
        <div class="card">
            <div class="card-header">
                <h5>防御側</h5>
            </div>
            <div class="card-body">
                <div class="form-group mb-3">
                    <label>ポケモン:</label>
                    <SearchableSelect TItem="Pokemon"
                        Items="pokemonList"
                        DisplayText="@(p => FormatPokemon(p))"
                        ValueSelector="@(p => p.Id.ToString())"
                        SelectedValue="@request.DefenderPokemonId.ToString()"
                        SelectedValueChanged="@OnDefenderPokemonChanged"
                        Placeholder="ポケモン名を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>レベル:</label>
                    <input type="number" class="form-control" @bind="request.Defender.Level" min="1" max="100" />
                </div>
                <div class="form-group mb-3">
                    <label>性格:</label>
                    <SearchableSelect TItem="Nature"
                        Items="natureList"
                        DisplayText="@(n => FormatNature(n))"
                        ValueSelector="@(n => n.Name)"
                        SelectedValue="@request.Defender.Nature"
                        SelectedValueChanged="@(v => request.Defender.Nature = v)"
                        Placeholder="性格を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>持ち物:</label>
                    <SearchableSelect TItem="Item"
                        Items="defenderItemList"
                        DisplayText="@(i => i.Name)"
                        ValueSelector="@(i => i.Id.ToString())"
                        SelectedValue="@(request.Defender.ItemId?.ToString() ?? "")"
                        SelectedValueChanged="@(v => request.Defender.ItemId = int.TryParse(v, out var id) ? id : null)"
                        Placeholder="持ち物を入力..." />
                </div>
            </div>
        </div>
    </div>
</div>

@if (attackerPokemon != null || defenderPokemon != null)
{
    <div class="split-row mt-3">
        <div class="split-half">
            @if (attackerPokemon != null)
            {
                @RenderStatsSummary(attackerPokemon, request.Attacker)
            }
        </div>
        <div class="split-half">
            @if (defenderPokemon != null)
            {
                @RenderStatsSummary(defenderPokemon, request.Defender)
            }
        </div>
    </div>
}

<div class="mt-3">
    <button class="btn btn-primary" @onclick="CalculateDamage" disabled="@isCalculating">
        @if (isCalculating)
        {
            <span class="spinner-border spinner-border-sm" role="status"></span>
            <span>計算中...</span>
        }
        else
        {
            <span>ダメージを計算</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (result != null)
{
    <div class="mt-3">
        <div class="card">
            <div class="card-header">
                <h5>計算結果</h5>
            </div>
            <div class="card-body">
                <h6>@result.Summary</h6>
                <p><strong>ダメージ範囲:</strong> @result.MinDamage - @result.MaxDamage</p>
                <p><strong>タイプ相性:</strong> @(result.TypeEffectiveness)倍</p>
                <p><strong>攻撃実数値:</strong> @result.AttackerStats</p>
                <p><strong>防御実数値:</strong> @result.DefenderStats</p>
                @if (result.Modifiers.Any())
                {
                    <p><strong>適用された補正:</strong></p>
                    <ul>
                        @foreach (var modifier in result.Modifiers)
                        {
                            <li>@modifier</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@code {
    private DamageCalculationRequest request = new();
    private DamageCalculationResult? result;
    private List<Pokemon> pokemonList = new();
    private List<Move> moveList = new();
    private List<Move> attackerMoveList = new();
    private List<Item> allItems = new();
    private List<Item> attackerItemList = new();
    private List<Item> defenderItemList = new();
    private List<Nature> natureList = new();
    private List<int> availableGenerations = new();
    private int selectedGeneration = 9;
    private string selectedBattleFormat = "singles";
    private bool isCalculating = false;
    private string errorMessage = string.Empty;
    private Pokemon? attackerPokemon;
    private Pokemon? defenderPokemon;

    private static readonly Dictionary<string, string> TypeNameMap = new()
    {
        { "Normal", "ノーマル" }, { "Fire", "ほのお" }, { "Water", "みず" },
        { "Electric", "でんき" }, { "Grass", "くさ" }, { "Ice", "こおり" },
        { "Fighting", "かくとう" }, { "Poison", "どく" }, { "Ground", "じめん" },
        { "Flying", "ひこう" }, { "Psychic", "エスパー" }, { "Bug", "むし" },
        { "Rock", "いわ" }, { "Ghost", "ゴースト" }, { "Dragon", "ドラゴン" },
        { "Dark", "あく" }, { "Steel", "はがね" }, { "Fairy", "フェアリー" }
    };

    private static readonly Dictionary<string, string> StatNameMap = new()
    {
        { "Attack", "攻撃" }, { "Defense", "防御" }, { "Speed", "素早さ" },
        { "SpAttack", "特攻" }, { "SpDefense", "特防" }
    };

    private static readonly string[] NatureNames = {
        "がんばりや", "さみしがり", "ゆうかん", "いじっぱり", "やんちゃ",
        "ずぶとい", "すなお", "のんき", "わんぱく", "のうてんき",
        "おくびょう", "せっかち", "まじめ", "ようき", "むじゃき",
        "ひかえめ", "おっとり", "れいせい", "てれや", "うっかりや",
        "おだやか", "おとなしい", "なまいき", "しんちょう", "きまぐれ"
    };

    private static string TypeToJapanese(string type) =>
        TypeNameMap.GetValueOrDefault(type, type);

    private string FormatNature(Nature n)
    {
        if (string.IsNullOrEmpty(n.IncreasedStat))
            return $"{n.Name}（補正無し）";
        var up = StatNameMap.GetValueOrDefault(n.IncreasedStat, n.IncreasedStat);
        var down = StatNameMap.GetValueOrDefault(n.DecreasedStat, n.DecreasedStat);
        return $"{n.Name}（{up}↑{down}↓）";
    }

    private string FormatPokemon(Pokemon p)
    {
        var t1 = TypeToJapanese(p.Type1);
        var types = string.IsNullOrEmpty(p.Type2) ? t1 : $"{t1}、{TypeToJapanese(p.Type2)}";
        var s = p.BaseStats;
        return $"{p.Name}（{types}）H{s.HP}-A{s.Attack}-B{s.Defense}-C{s.SpAttack}-D{s.SpDefense}-S{s.Speed}";
    }

    private string FormatStats(BaseStats s) =>
        $"H{s.HP}-A{s.Attack}-B{s.Defense}-C{s.SpAttack}-D{s.SpDefense}-S{s.Speed}";

    private Nature? FindNature(string name) =>
        natureList.FirstOrDefault(n => n.Name == name);

    private static int CalcHp(int baseStat, int iv, int ev, int level) =>
        (int)Math.Floor((2.0 * baseStat + iv + Math.Floor(ev / 4.0)) * level / 100.0) + level + 10;

    private static int CalcStat(int baseStat, int iv, int ev, int level, double natureModifier) =>
        (int)Math.Floor(((int)Math.Floor((2.0 * baseStat + iv + Math.Floor(ev / 4.0)) * level / 100.0) + 5) * natureModifier);

    private record StatEntry(string Label, int Value, string Color);

    private List<StatEntry> CalcActualStats(Pokemon pokemon, PokemonInstance inst)
    {
        var b = pokemon.BaseStats;
        var iv = inst.IVs;
        var ev = inst.EVs;
        var lv = inst.Level;
        var nature = FindNature(inst.Nature);
        var up = nature?.IncreasedStat ?? "";
        var down = nature?.DecreasedStat ?? "";

        string Color(string statName) => statName == up ? "stat-up" : statName == down ? "stat-down" : "";
        double Mod(string statName) => statName == up ? 1.1 : statName == down ? 0.9 : 1.0;

        return new()
        {
            new("H", CalcHp(b.HP, iv.HP, ev.HP, lv), ""),
            new("A", CalcStat(b.Attack, iv.Attack, ev.Attack, lv, Mod("Attack")), Color("Attack")),
            new("B", CalcStat(b.Defense, iv.Defense, ev.Defense, lv, Mod("Defense")), Color("Defense")),
            new("C", CalcStat(b.SpAttack, iv.SpAttack, ev.SpAttack, lv, Mod("SpAttack")), Color("SpAttack")),
            new("D", CalcStat(b.SpDefense, iv.SpDefense, ev.SpDefense, lv, Mod("SpDefense")), Color("SpDefense")),
            new("S", CalcStat(b.Speed, iv.Speed, ev.Speed, lv, Mod("Speed")), Color("Speed")),
        };
    }

    private RenderFragment RenderStatsSummary(Pokemon pokemon, PokemonInstance inst) => __builder =>
    {
        var nature = FindNature(inst.Nature);
        var stats = CalcActualStats(pokemon, inst);

        <div class="stats-summary">
            <div><strong>@(pokemon.Name)：</strong>Lv@(inst.Level)</div>
            <div>種族値：@FormatStats(pokemon.BaseStats)</div>
            <div>努力値：@FormatStats(inst.EVs)</div>
            <div>個体値：@FormatStats(inst.IVs)</div>
            <div>性格：@(nature != null ? FormatNature(nature) : inst.Nature)</div>
            <div>
                実数値：@foreach (var (entry, i) in stats.Select((e, i) => (e, i)))
                {
                    if (i > 0) { <span>-</span> }
                    <span class="@entry.Color">@(entry.Label)@(entry.Value)</span>
                }
            </div>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        availableGenerations = GenerationService.GetAvailableGenerations();
        if (availableGenerations.Any())
        {
            selectedGeneration = availableGenerations.Last();
            request.Generation = selectedGeneration;
        }

        await LoadData();
        natureList = await GenerationService.GetNaturesAsync();
    }

    private async Task OnGenerationChanged()
    {
        request.Generation = selectedGeneration;
        await LoadData();
    }

    private async Task OnBattleFormatChanged()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            pokemonList = await PokemonService.GetPokemonAsync(selectedGeneration);
            moveList = await MoveService.GetMovesAsync(selectedGeneration);
            attackerMoveList = moveList;
            allItems = await ItemService.GetItemsAsync(selectedGeneration);
            attackerItemList = allItems;
            defenderItemList = allItems;

            var ranking = await UsageService.GetPokemonRankingAsync(selectedGeneration, selectedBattleFormat);
            pokemonList = pokemonList.OrderBy(p => ranking.TryGetValue(p.Id, out var rank) ? rank : int.MaxValue).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"データの読み込みに失敗しました: {ex.Message}";
        }
    }

    private async Task OnAttackerPokemonChanged(string value)
    {
        request.AttackerPokemonId = int.TryParse(value, out var id) ? id : 0;
        attackerPokemon = pokemonList.FirstOrDefault(p => p.Id == request.AttackerPokemonId);

        await UpdateAttackerMoveList();
        await UpdateAttackerItemList();
        await SetAttackerDefaults();
    }

    private async Task OnDefenderPokemonChanged(string value)
    {
        request.DefenderPokemonId = int.TryParse(value, out var id) ? id : 0;
        defenderPokemon = pokemonList.FirstOrDefault(p => p.Id == request.DefenderPokemonId);

        await UpdateDefenderItemList();
        await SetDefenderDefaults();
    }

    private async Task SetAttackerDefaults()
    {
        if (request.AttackerPokemonId == 0) return;

        var moveUsage = await UsageService.GetMoveUsageOrderAsync(request.AttackerPokemonId, selectedGeneration, selectedBattleFormat);
        if (moveUsage.Count > 0)
            request.MoveId = attackerMoveList.FirstOrDefault(m => m.Id == moveUsage[0])?.Id ?? 0;

        var natureUsage = await UsageService.GetNatureUsageOrderAsync(request.AttackerPokemonId, selectedGeneration, selectedBattleFormat);
        if (natureUsage.Count > 0 && natureUsage[0] >= 0 && natureUsage[0] < NatureNames.Length)
            request.Attacker.Nature = NatureNames[natureUsage[0]];

        var itemUsage = await UsageService.GetItemUsageOrderAsync(request.AttackerPokemonId, selectedGeneration, selectedBattleFormat);
        if (itemUsage.Count > 0)
            request.Attacker.ItemId = itemUsage[0];
    }

    private async Task SetDefenderDefaults()
    {
        if (request.DefenderPokemonId == 0) return;

        var natureUsage = await UsageService.GetNatureUsageOrderAsync(request.DefenderPokemonId, selectedGeneration, selectedBattleFormat);
        if (natureUsage.Count > 0 && natureUsage[0] >= 0 && natureUsage[0] < NatureNames.Length)
            request.Defender.Nature = NatureNames[natureUsage[0]];

        var itemUsage = await UsageService.GetItemUsageOrderAsync(request.DefenderPokemonId, selectedGeneration, selectedBattleFormat);
        if (itemUsage.Count > 0)
            request.Defender.ItemId = itemUsage[0];
    }

    private async Task UpdateAttackerMoveList()
    {
        if (request.AttackerPokemonId == 0)
        {
            attackerMoveList = moveList;
            return;
        }

        var learnset = await MoveService.GetLearnsetAsync(request.AttackerPokemonId, selectedGeneration);
        if (learnset.Count == 0)
        {
            attackerMoveList = moveList;
            return;
        }

        var learnsetSet = new HashSet<int>(learnset);
        var filtered = moveList.Where(m => learnsetSet.Contains(m.Id)).ToList();

        var moveUsage = await UsageService.GetMoveUsageOrderAsync(request.AttackerPokemonId, selectedGeneration, selectedBattleFormat);
        if (moveUsage.Count > 0)
        {
            var moveOrder = new Dictionary<int, int>();
            for (int i = 0; i < moveUsage.Count; i++)
                moveOrder[moveUsage[i]] = i;
            filtered = filtered.OrderBy(m => moveOrder.TryGetValue(m.Id, out var order) ? order : int.MaxValue).ToList();
        }

        attackerMoveList = filtered;
    }

    private async Task UpdateAttackerItemList()
    {
        if (request.AttackerPokemonId == 0)
        {
            attackerItemList = allItems;
            return;
        }

        var itemUsage = await UsageService.GetItemUsageOrderAsync(request.AttackerPokemonId, selectedGeneration, selectedBattleFormat);
        if (itemUsage.Count > 0)
        {
            var itemOrder = new Dictionary<int, int>();
            for (int i = 0; i < itemUsage.Count; i++)
                itemOrder[itemUsage[i]] = i;
            attackerItemList = allItems.OrderBy(item => itemOrder.TryGetValue(item.Id, out var order) ? order : int.MaxValue).ToList();
        }
        else
        {
            attackerItemList = allItems;
        }
    }

    private async Task UpdateDefenderItemList()
    {
        if (request.DefenderPokemonId == 0)
        {
            defenderItemList = allItems;
            return;
        }

        var itemUsage = await UsageService.GetItemUsageOrderAsync(request.DefenderPokemonId, selectedGeneration, selectedBattleFormat);
        if (itemUsage.Count > 0)
        {
            var itemOrder = new Dictionary<int, int>();
            for (int i = 0; i < itemUsage.Count; i++)
                itemOrder[itemUsage[i]] = i;
            defenderItemList = allItems.OrderBy(item => itemOrder.TryGetValue(item.Id, out var order) ? order : int.MaxValue).ToList();
        }
        else
        {
            defenderItemList = allItems;
        }
    }

    private async Task CalculateDamage()
    {
        if (request.AttackerPokemonId == 0 || request.DefenderPokemonId == 0 || request.MoveId == 0)
        {
            errorMessage = "ポケモンと技を選択してください。";
            return;
        }

        isCalculating = true;
        errorMessage = string.Empty;

        try
        {
            result = await DamageService.CalculateDamageAsync(request);
        }
        catch (Exception ex)
        {
            errorMessage = $"計算エラー: {ex.Message}";
            result = null;
        }
        finally
        {
            isCalculating = false;
        }
    }
}
