@page "/damage-calculator"
@using FaraPokemonTools.Models
@using FaraPokemonTools.Services
@inject IPokemonDataService PokemonService
@inject IMoveDataService MoveService
@inject IItemDataService ItemService
@inject IDamageCalculationService DamageService
@inject IGenerationService GenerationService
@inject IUsageDataService UsageService

<PageTitle>ダメージ計算機</PageTitle>

<h3>ダメージ計算機</h3>

<div class="row">
    <div class="col-md-12">
        <div class="form-group mb-3">
            <label for="generation">世代:</label>
            <select id="generation" class="form-control" @bind="selectedGeneration" @bind:after="OnGenerationChanged">
                @foreach (var gen in availableGenerations)
                {
                    <option value="@gen">第@(gen)世代</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="row gx-4">
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <h5>攻撃側</h5>
            </div>
            <div class="card-body">
                <div class="form-group mb-3">
                    <label>ポケモン:</label>
                    <SearchableSelect TItem="Pokemon"
                        Items="pokemonList"
                        DisplayText="@(p => FormatPokemon(p))"
                        ValueSelector="@(p => p.Id.ToString())"
                        SelectedValue="@request.AttackerPokemonId.ToString()"
                        SelectedValueChanged="@OnAttackerPokemonChanged"
                        Placeholder="ポケモン名を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>技:</label>
                    <SearchableSelect TItem="Move"
                        Items="attackerMoveList"
                        DisplayText="@(m => $"{m.Name} ({m.Type}, {m.Power})")"
                        ValueSelector="@(m => m.Id.ToString())"
                        SelectedValue="@request.MoveId.ToString()"
                        SelectedValueChanged="@(v => request.MoveId = int.TryParse(v, out var id) ? id : 0)"
                        Placeholder="技名を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>レベル:</label>
                    <input type="number" class="form-control" @bind="request.Attacker.Level" min="1" max="100" />
                </div>
                <div class="form-group mb-3">
                    <label>性格:</label>
                    <SearchableSelect TItem="Nature"
                        Items="natureList"
                        DisplayText="@(n => FormatNature(n))"
                        ValueSelector="@(n => n.Name)"
                        SelectedValue="@request.Attacker.Nature"
                        SelectedValueChanged="@(v => request.Attacker.Nature = v)"
                        Placeholder="性格を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>持ち物:</label>
                    <SearchableSelect TItem="Item"
                        Items="itemList"
                        DisplayText="@(i => i.Name)"
                        ValueSelector="@(i => i.Id.ToString())"
                        SelectedValue="@(request.Attacker.ItemId?.ToString() ?? "")"
                        SelectedValueChanged="@(v => request.Attacker.ItemId = int.TryParse(v, out var id) ? id : null)"
                        Placeholder="持ち物を入力..." />
                </div>
            </div>
        </div>
    </div>

    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <h5>防御側</h5>
            </div>
            <div class="card-body">
                <div class="form-group mb-3">
                    <label>ポケモン:</label>
                    <SearchableSelect TItem="Pokemon"
                        Items="pokemonList"
                        DisplayText="@(p => FormatPokemon(p))"
                        ValueSelector="@(p => p.Id.ToString())"
                        SelectedValue="@request.DefenderPokemonId.ToString()"
                        SelectedValueChanged="@(v => request.DefenderPokemonId = int.TryParse(v, out var id) ? id : 0)"
                        Placeholder="ポケモン名を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>レベル:</label>
                    <input type="number" class="form-control" @bind="request.Defender.Level" min="1" max="100" />
                </div>
                <div class="form-group mb-3">
                    <label>性格:</label>
                    <SearchableSelect TItem="Nature"
                        Items="natureList"
                        DisplayText="@(n => FormatNature(n))"
                        ValueSelector="@(n => n.Name)"
                        SelectedValue="@request.Defender.Nature"
                        SelectedValueChanged="@(v => request.Defender.Nature = v)"
                        Placeholder="性格を入力..." />
                </div>
                <div class="form-group mb-3">
                    <label>持ち物:</label>
                    <SearchableSelect TItem="Item"
                        Items="itemList"
                        DisplayText="@(i => i.Name)"
                        ValueSelector="@(i => i.Id.ToString())"
                        SelectedValue="@(request.Defender.ItemId?.ToString() ?? "")"
                        SelectedValueChanged="@(v => request.Defender.ItemId = int.TryParse(v, out var id) ? id : null)"
                        Placeholder="持ち物を入力..." />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <button class="btn btn-primary" @onclick="CalculateDamage" disabled="@isCalculating">
            @if (isCalculating)
            {
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span>計算中...</span>
            }
            else
            {
                <span>ダメージを計算</span>
            }
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (result != null)
{
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>計算結果</h5>
                </div>
                <div class="card-body">
                    <h6>@result.Summary</h6>
                    <p><strong>ダメージ範囲:</strong> @result.MinDamage - @result.MaxDamage</p>
                    <p><strong>タイプ相性:</strong> @(result.TypeEffectiveness)倍</p>
                    <p><strong>攻撃実数値:</strong> @result.AttackerStats</p>
                    <p><strong>防御実数値:</strong> @result.DefenderStats</p>
                    @if (result.Modifiers.Any())
                    {
                        <p><strong>適用された補正:</strong></p>
                        <ul>
                            @foreach (var modifier in result.Modifiers)
                            {
                                <li>@modifier</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DamageCalculationRequest request = new();
    private DamageCalculationResult? result;
    private List<Pokemon> pokemonList = new();
    private List<Move> moveList = new();
    private List<Move> attackerMoveList = new();
    private List<Item> allItems = new();
    private List<Item> itemList = new();
    private List<Nature> natureList = new();
    private List<int> availableGenerations = new();
    private int selectedGeneration = 9;
    private bool isCalculating = false;
    private string errorMessage = string.Empty;

    private static readonly Dictionary<string, string> StatNameMap = new()
    {
        { "Attack", "攻撃" }, { "Defense", "防御" }, { "Speed", "素早さ" },
        { "SpAttack", "特攻" }, { "SpDefense", "特防" }
    };

    private string FormatNature(Nature n)
    {
        if (string.IsNullOrEmpty(n.IncreasedStat))
            return $"{n.Name}（補正無し）";
        var up = StatNameMap.GetValueOrDefault(n.IncreasedStat, n.IncreasedStat);
        var down = StatNameMap.GetValueOrDefault(n.DecreasedStat, n.DecreasedStat);
        return $"{n.Name}（{up}↑{down}↓）";
    }

    private string FormatPokemon(Pokemon p)
    {
        var types = string.IsNullOrEmpty(p.Type2) ? p.Type1 : $"{p.Type1}、{p.Type2}";
        return $"{p.Name}（タイプ：{types}）";
    }

    protected override async Task OnInitializedAsync()
    {
        availableGenerations = GenerationService.GetAvailableGenerations();
        if (availableGenerations.Any())
        {
            selectedGeneration = availableGenerations.Last();
            request.Generation = selectedGeneration;
        }
        
        await LoadData();
        natureList = await GenerationService.GetNaturesAsync();
    }

    private async Task OnGenerationChanged()
    {
        request.Generation = selectedGeneration;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            pokemonList = await PokemonService.GetPokemonAsync(selectedGeneration);
            moveList = await MoveService.GetMovesAsync(selectedGeneration);
            attackerMoveList = moveList;
            allItems = await ItemService.GetItemsAsync(selectedGeneration);
            itemList = allItems;

            var ranking = await UsageService.GetPokemonRankingAsync(selectedGeneration);
            pokemonList = pokemonList.OrderBy(p => ranking.TryGetValue(p.Id, out var rank) ? rank : int.MaxValue).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"データの読み込みに失敗しました: {ex.Message}";
        }
    }

    private async Task OnAttackerPokemonChanged(string value)
    {
        request.AttackerPokemonId = int.TryParse(value, out var id) ? id : 0;
        request.MoveId = 0;
        await UpdateAttackerMoveList();
        await UpdateAttackerItemList();
    }

    private async Task UpdateAttackerMoveList()
    {
        if (request.AttackerPokemonId == 0)
        {
            attackerMoveList = moveList;
            return;
        }

        var learnset = await MoveService.GetLearnsetAsync(request.AttackerPokemonId, selectedGeneration);
        if (learnset.Count == 0)
        {
            attackerMoveList = moveList;
            return;
        }

        var learnsetSet = new HashSet<int>(learnset);
        var filtered = moveList.Where(m => learnsetSet.Contains(m.Id)).ToList();

        var moveUsage = await UsageService.GetMoveUsageOrderAsync(request.AttackerPokemonId, selectedGeneration);
        if (moveUsage.Count > 0)
        {
            var moveOrder = new Dictionary<int, int>();
            for (int i = 0; i < moveUsage.Count; i++)
                moveOrder[moveUsage[i]] = i;
            filtered = filtered.OrderBy(m => moveOrder.TryGetValue(m.Id, out var order) ? order : int.MaxValue).ToList();
        }

        attackerMoveList = filtered;
    }

    private async Task UpdateAttackerItemList()
    {
        if (request.AttackerPokemonId == 0)
        {
            itemList = allItems;
            return;
        }

        var itemUsage = await UsageService.GetItemUsageOrderAsync(request.AttackerPokemonId, selectedGeneration);
        if (itemUsage.Count > 0)
        {
            var itemOrder = new Dictionary<int, int>();
            for (int i = 0; i < itemUsage.Count; i++)
                itemOrder[itemUsage[i]] = i;
            itemList = allItems.OrderBy(item => itemOrder.TryGetValue(item.Id, out var order) ? order : int.MaxValue).ToList();
        }
        else
        {
            itemList = allItems;
        }
    }

    private async Task CalculateDamage()
    {
        if (request.AttackerPokemonId == 0 || request.DefenderPokemonId == 0 || request.MoveId == 0)
        {
            errorMessage = "ポケモンと技を選択してください。";
            return;
        }

        isCalculating = true;
        errorMessage = string.Empty;
        
        try
        {
            result = await DamageService.CalculateDamageAsync(request);
        }
        catch (Exception ex)
        {
            errorMessage = $"計算エラー: {ex.Message}";
            result = null;
        }
        finally
        {
            isCalculating = false;
        }
    }
}
